{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/block-destructive-git.sh\"",
            "timeout": 10,
            "statusMessage": "Checking git safety"
          }
        ]
      }
    ]
  }
}
