rules_version = '2';
// NOTE 2026-09-01: ruleset is near Firestore's 256KB source cap — keep comments terse.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auth helpers ─
    function isAuth()         { return request.auth != null; }
    function isOwner(uid)     { return request.auth.uid == uid; }

    // [RN-1] Null-safe role lookup. Reading `.data.role` directly THROW -> docs/firestore-rules-notes.md#rn-1
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null);
    }
    // [RN-2] 'secretary' (Corporate Secretary) is an admin-portal overs -> docs/firestore-rules-notes.md#rn-2
    function isAdmin()   { return getRole() in ['president', 'manager', 'secretary']; }
    function isPresident(){ return getRole() == 'president'; }
    // [RN-3] Owner ruling 2026-08-08: the Corporate Secretary may reach -> docs/firestore-rules-notes.md#rn-3
    function isSecretary(){ return getRole() == 'secretary'; }
    // [RN-4] The two departments closed to the Corporate Secretary, as -> docs/firestore-rules-notes.md#rn-4
    function deptOpenToSecretary(d) { return !(d == 'Finance' || d == 'IT'); }
    function deptChannelOpen(d) { return !isSecretary() || deptOpenToSecretary(d); }
    // [RN-5] Lowercase-docId sibling of the two above. /strategy_notes -> docs/firestore-rules-notes.md#rn-5
    function deptKeyOpenToSecretary(k) { return !(k == 'finance' || k == 'it'); }
    function strategyDeptOpen(k) { return !isSecretary() || deptKeyOpenToSecretary(k); }
    function isPartner()     { return getRole() == 'partner'; }
    function isSeniorAdmin() { return getRole() in ['president', 'manager']; }
    function isMoneyAdmin()  { return getRole() in ['president', 'manager', 'finance']; }

    // [RN-6] isAccountAdminFlag() — the "designated personnel" predicat -> docs/firestore-rules-notes.md#rn-6
    function isAccountAdminFlag() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountAdmin', false) == true;
    }

    // [RN-7] isOpsAdmin() — THE SPLIT OF THE OLD 4-ROLE HELPER (2026-08 -> docs/firestore-rules-notes.md#rn-7
    function isOpsAdmin()    { return getRole() in ['president', 'manager', 'secretary', 'finance']; }

    // [RN-8] Member of the Finance DEPARTMENT (by string `department` o -> docs/firestore-rules-notes.md#rn-8
    function isFinanceDept() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.get('role', null) != 'secretary'
        && (u.get('department', '') == 'Finance' || u.get('departments', []).hasAny(['Finance']));
    }
    // [RN-9] Anyone allowed to operate the books: money-tier role OR Fi -> docs/firestore-rules-notes.md#rn-9
    function canFinance() { return isMoneyAdmin() || isFinanceDept(); }

    // Member of the Design DEPARTMENT (by string `department` or array `departments`).
    // Same null-safe pattern as isFinanceDept(). Gates Design drawings + project edits.
    function isDesignDept() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.get('department', '') == 'Design' || u.get('departments', []).hasAny(['Design']);
    }
    // Anyone allowed to manage Design work: admin role OR Design-dept member.
    function canDesign() { return isAdmin() || isDesignDept(); }

    // Member of the Purchasing DEPARTMENT (by string `department` or array `departments`).
    function isPurchasingDept() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.get('department', '') == 'Purchasing' || u.get('departments', []).hasAny(['Purchasing']);
    }
    // Anyone allowed to manage Purchasing work: admin role OR Purchasing-dept member.
    function canPurchasing() { return isAdmin() || isPurchasingDept(); }

    // Member of the Production DEPARTMENT (by string `department` or array `departments`).
    function isProductionDept() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.get('department', '') == 'Production' || u.get('departments', []).hasAny(['Production']);
    }
    function canProduction() { return isAdmin() || isProductionDept(); }

    // [RN-10] Member of the HR DEPARTMENT ─ -> docs/firestore-rules-notes.md#rn-10
    function isHrDept() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.get('role', null) != 'partner'
        && (u.get('department', '') == 'HR' || u.get('departments', []).hasAny(['HR']));
    }
    // [RN-11] READ-ONLY sight of the HR surface (attendance, leave) for -> docs/firestore-rules-notes.md#rn-11
    function canHrView() { return isOpsAdmin() || isHrDept(); }

    // [RN-12] Generic department membership (null-safe), and "admin OR m -> docs/firestore-rules-notes.md#rn-12
    function inDept(d) {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return !(u.get('role', null) == 'secretary' && (d == 'Finance' || d == 'IT'))
        && (u.get('department', '') == d || u.get('departments', []).hasAny([d]));
    }
    function canDept(d) { return isAdmin() || inDept(d); }

    // [RN-13] canIt() — IT boundary for the Corporate Secretary (owner r -> docs/firestore-rules-notes.md#rn-13
    function canIt() { return !isSecretary() && canDept('IT'); }

    // [RN-14] IDENTITY BINDING (v14 re-audit ROUND 2 — critical) ─ -> docs/firestore-rules-notes.md#rn-14
    function userIdentityBindingUnchanged() {
      return request.resource.data.get('email', null) == resource.data.get('email', null)
          && request.resource.data.get('pendingPasswordSetup', null)
             == resource.data.get('pendingPasswordSetup', null);
    }

    // [RN-15] True when a user-profile update leaves all privileged fiel -> docs/firestore-rules-notes.md#rn-15
    function userPrivilegedFieldsUnchanged() {
      let n = request.resource.data;
      let o = resource.data;
      return n.get('role', null)        == o.get('role', null)
          && n.get('salary', null)      == o.get('salary', null)
          && n.get('allowance', null)   == o.get('allowance', null)
          && n.get('deductions', null)  == o.get('deductions', null)
          && n.get('department', null)  == o.get('department', null)
          && n.get('departments', null) == o.get('departments', null)
          && n.get('employeeId', null)  == o.get('employeeId', null)
          // v12 WS19: username is also privileged — it's the lookup key in the
          // new usernames/{u} map (login), so a free self-change would desync it.
          && n.get('username', null)    == o.get('username', null)
          // [RN-16] v14 re-audit fix — hrManagedAccount is only ever legitimat -> docs/firestore-rules-notes.md#rn-16
          && n.get('hrManagedAccount', null) == o.get('hrManagedAccount', null)
          // [RN-17] v14 offboarding — removed/reinstated flags are privileged -> docs/firestore-rules-notes.md#rn-17
          && n.get('removed', null)      == o.get('removed', null)
          && n.get('removedAt', null)    == o.get('removedAt', null)
          && n.get('removedBy', null)    == o.get('removedBy', null)
          && n.get('reinstatedAt', null) == o.get('reinstatedAt', null)
          && n.get('reinstatedBy', null) == o.get('reinstatedBy', null)
          // [RN-18] LAYOFF-SPEC — the layoff pointer map is privileged: an emp -> docs/firestore-rules-notes.md#rn-18
          && n.get('layoff', null)       == o.get('layoff', null)
          // [RN-19] TEAM-PAGE-ORG-SPEC-2026-08-25 — accountAdmin is the "desig -> docs/firestore-rules-notes.md#rn-19
          && n.get('accountAdmin', null)  == o.get('accountAdmin', null)
          && n.get('team', null)          == o.get('team', null)
          // v14 re-audit ROUND 2 — see userIdentityBindingUnchanged() above.
          // Covers the OWNER and the non-senior isAdmin() (secretary) branches,
          // which are the two that call this helper.
          && userIdentityBindingUnchanged();
    }

    // [RN-20] Shape validators (Phase 92) ─ -> docs/firestore-rules-notes.md#rn-20
    function isNonNegNumber(v) { return v is number && v >= 0; }
    function isBoundedString(v, max) { return v is string && v.size() <= max; }

    // ── Users ─
    match /users/{uid} {
      // [RN-21] v14 re-audit fix — `read` covers BOTH get and list, so the -> docs/firestore-rules-notes.md#rn-21
      allow get:  if isAuth();
      allow list: if isAuth() && ( !isPartner()
        || resource.data.get('role', '') in ['partner', 'president', 'manager'] );
      // [RN-22] Self-signup must not self-assign into a privileged departm -> docs/firestore-rules-notes.md#rn-22
      function noPrivilegedDeptOnCreate() {
        return request.resource.data.get('department', '') != 'Finance'
            && request.resource.data.get('department', '') != 'Design'
            && request.resource.data.get('department', '') != 'Ventures'
            && request.resource.data.get('department', '') != 'IT'
            // [RN-23] 'IT' added 2026-08-09 with the secretary carve-out. Financ -> docs/firestore-rules-notes.md#rn-23
            && !request.resource.data.get('departments', []).hasAny(['Finance','Design','Ventures','IT']);
      }
      // [RN-24] Self-signup creates its own doc as 'employee'; admins crea -> docs/firestore-rules-notes.md#rn-24
      function noAccountAdminOnCreate() {
        return request.resource.data.get('accountAdmin', false) == false;
      }
      allow create: if isAuth() && (
        isPresident() || (
          isSeniorAdmin()
          && noAccountAdminOnCreate()
          && request.resource.data.get('role', 'employee') != 'president'
          && request.resource.data.get('role', 'employee') in
               ['manager', 'secretary', 'employee', 'agent', 'finance', 'partner']
        ) || (
          isAdmin()
          && noAccountAdminOnCreate()
          && request.resource.data.get('role', 'employee') in ['employee', 'agent']
          && noPrivilegedDeptOnCreate()
        ) || (
          isOwner(uid)
          && noAccountAdminOnCreate()
          && request.resource.data.role == 'employee'
          && noPrivilegedDeptOnCreate()
        ) || (
          // [RN-25] TEAM-PAGE-ORG-SPEC-2026-08-25 — a President-flagged accoun -> docs/firestore-rules-notes.md#rn-25
          isAccountAdminFlag()
          && noAccountAdminOnCreate()
          && request.resource.data.get('role', 'employee') in ['employee', 'agent']
          && noPrivilegedDeptOnCreate()
        )
      );
      // [RN-26] Owner-first short-circuit: routine self-updates (name/phot -> docs/firestore-rules-notes.md#rn-26
      function fcmTokenUnchangedForOthers() {
        return request.resource.data.get('fcmToken', null) == resource.data.get('fcmToken', null);
      }
      // [RN-27] hrManagedAccount is never legitimately updated (only set a -> docs/firestore-rules-notes.md#rn-27
      function hrFlagUnchanged() {
        return request.resource.data.get('hrManagedAccount', null) == resource.data.get('hrManagedAccount', null);
      }
      // [RN-28] TEAM-PAGE-ORG-SPEC-2026-08-25 — accountAdmin is PRESIDENT- -> docs/firestore-rules-notes.md#rn-28
      function accountAdminUnchanged() {
        return isPresident() || request.resource.data.get('accountAdmin', null) == resource.data.get('accountAdmin', null);
      }
      // v14 offboarding — an HR-dept member of any role may toggle ONLY the
      // removed/reinstated fields on ANOTHER user's doc (matches people.js's
      // Remove/Reinstate UI gate); restricted to those 5 keys, never president.
      function onlyOffboardingFieldsChanged() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['removed','removedAt','removedBy','reinstatedAt','reinstatedBy']);
      }
      // [RN-29] v14 re-audit ROUND 2 — the isSeniorAdmin() branch does NOT -> docs/firestore-rules-notes.md#rn-29
      allow update: if isAuth() && (
        isPresident() ||
        (isSeniorAdmin() && !isOwner(uid)
          && resource.data.get('role', 'employee') != 'president'
          && request.resource.data.get('role', 'employee') != 'president'
          && fcmTokenUnchangedForOthers()
          && hrFlagUnchanged()
          && accountAdminUnchanged()
          && userIdentityBindingUnchanged()) ||
        (isOwner(uid) && userPrivilegedFieldsUnchanged()) ||
        (isAdmin() && userPrivilegedFieldsUnchanged() && fcmTokenUnchangedForOthers()) ||
        (inDept('HR') && !isOwner(uid)
          && resource.data.get('role', 'employee') != 'president'
          && onlyOffboardingFieldsChanged())
        ||
        // [RN-30] LAYOFF-SPEC — HR-dept members (any role except partner — i -> docs/firestore-rules-notes.md#rn-30
        (isHrDept() && !isOwner(uid)
          && resource.data.get('role', 'employee') != 'president'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['layoff']))
      );
      allow delete: if isAuth() && isPresident();
    }

    // [RN-31] Username → email lookup (v12 WS19) ─ -> docs/firestore-rules-notes.md#rn-31
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      // [RN-32] TEAM-PAGE-ORG-SPEC-2026-08-25 — an account admin mints wor -> docs/firestore-rules-notes.md#rn-32
      allow create: if isAuth() && (isAdmin() || isAccountAdminFlag());
      allow update, delete: if isAuth() && isAdmin();
    }

    // [RN-33] Sequence counters (employees, workers, etc.) ─ -> docs/firestore-rules-notes.md#rn-33
    match /_counters/{docId} {
      allow read:  if isAuth();
      // [RN-34] v14 re-audit fix — monotonic-only: the new count may never -> docs/firestore-rules-notes.md#rn-34
      allow write: if isAuth() && !isPartner()
        && (request.resource == null || (
          isNonNegNumber(request.resource.data.get('count', 0))
          && (resource == null || request.resource.data.get('count', 0) >= resource.data.get('count', 0))
        ));
    }

    // ── Posts ─
    // v12 WS19: read locked to !isPartner() — internal company feed, was bare
    // isAuth() (the audit separately flagged that published-post NOTIFICATIONS
    // also fan out to partners; that's a different, notification-side fix).
    match /posts/{postId} {
      // [RN-35] Internal feed stays !isPartner()-only, EXCEPT posts delibe -> docs/firestore-rules-notes.md#rn-35
      allow read: if isAuth() && ( !isPartner()
        || (resource.data.get('dept','') == 'Partners' && resource.data.get('status','') == 'published') );
      // v13 Phase 22: enforce the publish/approval model server-side — matches
      // modules.js openNewPostModal (authorId is the real field name; only the
      // president gets publishDirectly, everyone else always lands 'pending').
      allow create: if isAuth() && !isPartner() &&
        request.resource.data.get('authorId', '') == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'title','content','dept','status','authorId','authorName','authorPhoto',
          'pinned','imageUrl','fileName','fileUrl','createdAt'
        ]) &&
        (isPresident()
          ? request.resource.data.get('status', '') in ['published', 'pending']
          : request.resource.data.get('status', '') == 'pending');
      // [RN-36] Author/admin may edit anything, EXCEPT the publish/reject -> docs/firestore-rules-notes.md#rn-36
      allow update: if isAuth() && (
        resource.data.authorId == request.auth.uid
        || (isSeniorAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']))
        || (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']))
        || ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hearts'])
             && request.resource.data.get('hearts', []).removeAll(resource.data.get('hearts', [])).hasOnly([request.auth.uid])
             && resource.data.get('hearts', []).removeAll(request.resource.data.get('hearts', [])).hasOnly([request.auth.uid]) )
      );
      allow delete: if isAuth() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // [RN-37] Personal Notes (2026-08-12) — "Own notes that they can als -> docs/firestore-rules-notes.md#rn-37
    function noteIsOwner(note)  { return note.data.get('ownerUid', '') == request.auth.uid; }
    function noteIsShared(note) { return request.auth.uid in note.data.get('sharedUids', []); }
    function noteLevel(note) {
      return note.data.get('sharedLevels', {}).get(request.auth.uid, 'view');
    }
    // [RN-38] Personal To-Do (owner ruling 2026-09-01: president-only dr -> docs/firestore-rules-notes.md#rn-38
    match /personal_todos/{uid} {
      allow read, delete: if isAuth() && request.auth.uid == uid;
      allow create, update: if isAuth() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['owner','createdAt']);
    }
    match /personal_todos/{uid}/items/{itemId} {
      allow read, delete: if isAuth() && request.auth.uid == uid;
      allow create, update: if isAuth() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['text','done','createdAt','doneAt','updatedAt','cat','rush','note','subs'])
        && request.resource.data.get('text', '') is string
        && request.resource.data.get('text', '').size() >= 1
        && request.resource.data.get('text', '').size() <= 500
        && request.resource.data.get('note', '') is string
        && request.resource.data.get('note', '').size() <= 2000
        && request.resource.data.get('cat', 'general') in
             ['production','sales','design','purchasing','delivery','general']
        && request.resource.data.get('subs', []) is list
        && request.resource.data.get('subs', []).size() <= 60;
    }

    // Client portals — client side is callable-only (CLIENT-PORTAL-CHIBABS-SPEC).
    // secrets/sessions/ratelimit collections have NO match block — Admin SDK only.
    match /client_portals/{pid} {
      allow get, list: if isAuth() && isAdmin();
      allow create: if isAuth() && isSeniorAdmin()
        && request.resource.data.get('acceptance', null) == null
        && !request.resource.data.keys().hasAny(['codeHash','codeSalt']);
      allow update: if isAuth() && isSeniorAdmin()
        && request.resource.data.get('acceptance', null) == resource.data.get('acceptance', null)
        && !request.resource.data.keys().hasAny(['codeHash','codeSalt']);
      allow delete: if false;
    }
    match /client_portals/{pid}/acceptances/{ref} { allow read: if isAuth() && isAdmin(); allow write: if false; }
    match /client_portals/{pid}/events/{eid} {
      allow read: if isAuth() && isAdmin();
      allow create: if isAuth() && isSeniorAdmin() && request.resource.data.get('actor', {}).get('uid', '') == request.auth.uid
        && request.resource.data.get('at', null) == request.time;
      allow update, delete: if false;
    }
    match /client_portals/{pid}/updates/{uid2} { allow read: if isAuth() && isAdmin(); allow create, update: if isAuth() && isSeniorAdmin(); allow delete: if false; }
    match /client_portal_outbox/{ref} {
      allow read: if isAuth() && isAdmin();
      allow update: if isAuth() && isSeniorAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','sentAt','sentBy','sentVia']);
      allow create, delete: if false;
    }

    // Client information requests (specs/CLIENT-INFO-REQUEST-SPEC.md) — public form is callable-only;
    // cir_drafts / cir_ratelimit / cir_abuse have NO match block (Admin SDK only). Secretary = view-only.
    function cirWriter() { return isSeniorAdmin() || (!isSecretary() && inDept('Sales')); }
    match /client_info_requests/{ref} {
      allow read: if isAuth() && !isPartner();
      allow create, delete: if false;
      allow update: if isAuth() && cirWriter()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','statusChangedAt','statusChangedBy','statusChangedByName','convertedClientId','convertedAt','convertedBy','updatedAt'])
        && request.resource.data.get('status','') in ['new','in_review','contacted','converted','archived']
        // Attribution fields must name the real writer when set, else forgeable.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['statusChangedBy']) || request.resource.data.statusChangedBy == request.auth.uid)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['convertedBy']) || request.resource.data.convertedBy == request.auth.uid);
    }
    match /client_info_requests/{ref}/notes/{nid} {
      allow read: if isAuth() && !isPartner();
      allow create: if isAuth() && cirWriter()
        && request.resource.data.get('authorUid','') == request.auth.uid
        && request.resource.data.get('at', null) == request.time
        && isBoundedString(request.resource.data.get('text',''), 2000);
      allow update, delete: if false;
    }

    match /notes/{noteId} {
      allow read: if isAuth() && ( noteIsOwner(resource) || noteIsShared(resource) );

      allow create: if isAuth() && !isPartner()
        && request.resource.data.get('ownerUid', '') == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['ownerUid','ownerName','title','body','sharedUids','sharedLevels',
              'updatedByName','createdAt','updatedAt'])
        && request.resource.data.get('title', '') is string
        && request.resource.data.get('title', '').size() >= 1
        && request.resource.data.get('title', '').size() <= 200
        && request.resource.data.get('body', '') is string
        && request.resource.data.get('body', '').size() <= 20000
        && request.resource.data.get('sharedUids', []) is list
        && request.resource.data.get('sharedUids', []).size() <= 50
        && request.resource.data.get('sharedUids', []).toSet()
             == request.resource.data.get('sharedLevels', {}).keys().toSet()
        && request.resource.data.get('sharedLevels', {}).values()
             .hasOnly(['view', 'comment', 'edit']);

      // [RN-39] TWO update tiers. Only the OWNER may change sharing, level -> docs/firestore-rules-notes.md#rn-39
      allow update: if isAuth() && (
        // ── owner: full control; schema + consistency re-proven every write
        ( noteIsOwner(resource)
          && request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', '')
          && request.resource.data.keys().hasOnly(
               ['ownerUid','ownerName','title','body','sharedUids','sharedLevels',
                'updatedByName','createdAt','updatedAt'])
          && request.resource.data.get('title', '') is string
          && request.resource.data.get('title', '').size() >= 1
          && request.resource.data.get('title', '').size() <= 200
          && request.resource.data.get('body', '') is string
          && request.resource.data.get('body', '').size() <= 20000
          && request.resource.data.get('sharedUids', []) is list
          && request.resource.data.get('sharedUids', []).size() <= 50
          && request.resource.data.get('sharedUids', []).toSet()
               == request.resource.data.get('sharedLevels', {}).keys().toSet()
          && request.resource.data.get('sharedLevels', {}).values()
               .hasOnly(['view', 'comment', 'edit']) )
        ||
        // ── edit-level recipient: title/body (+ the LWW stamp) only
        ( noteIsShared(resource)
          && noteLevel(resource) == 'edit'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['title', 'body', 'updatedAt', 'updatedByName'])
          && request.resource.data.get('title', '') is string
          && request.resource.data.get('title', '').size() >= 1
          && request.resource.data.get('title', '').size() <= 200
          && request.resource.data.get('body', '') is string
          && request.resource.data.get('body', '').size() <= 20000 )
      );

      allow delete: if isAuth() && noteIsOwner(resource);

      // [RN-40] §5.2a Comments — SUBCOLLECTION, so it needs its OWN match -> docs/firestore-rules-notes.md#rn-40
      match /comments/{commentId} {
        function parentNote() {
          return get(/databases/$(database)/documents/notes/$(noteId));
        }
        // Anyone who can read the note can read its comments — president
        // and admins included ONLY if the note is shared with them, exactly
        // like the note itself.
        allow read: if isAuth() && (
             parentNote().data.get('ownerUid', '') == request.auth.uid
          || request.auth.uid in parentNote().data.get('sharedUids', []) );

        allow create: if isAuth()
          && request.resource.data.get('authorUid', '') == request.auth.uid
          && request.resource.data.keys().hasOnly(
               ['authorUid', 'authorName', 'text', 'createdAt'])
          && request.resource.data.get('text', '') is string
          && request.resource.data.get('text', '').size() >= 1
          && request.resource.data.get('text', '').size() <= 2000
          && ( parentNote().data.get('ownerUid', '') == request.auth.uid
               || ( request.auth.uid in parentNote().data.get('sharedUids', [])
                    && parentNote().data.get('sharedLevels', {})
                         .get(request.auth.uid, 'view') in ['comment', 'edit'] ) );

        allow delete: if isAuth() && (
             resource.data.get('authorUid', '') == request.auth.uid
          || parentNote().data.get('ownerUid', '') == request.auth.uid );
      }
    }

    // ── Notifications — anyone signed in can deliver a notification
    // into another user's inbox (Notifs.send/sendToDept/sendToAll/sendToOwner
    // all write cross-user by design); only the inbox owner can read it or
    // mark it read/unread.
    match /notifications/{uid}/{document=**} {
      allow read, update, delete: if isAuth() && isOwner(uid);
      // [RN-41] Cross-user create stays open (broadcast helpers deliver in -> docs/firestore-rules-notes.md#rn-41
      allow create: if isAuth()
        // [RN-42] PAYSLIP-OVERHAUL-SPEC.md §5 — `month` (YYYY-MM) lets a pay -> docs/firestore-rules-notes.md#rn-42
        && request.resource.data.keys().hasOnly(['title','body','icon','type','link','read','createdAt','dedupKey','taskId','chatId','senderUid','month','meetingId'])
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && isBoundedString(request.resource.data.get('title', ''), 200)
        && isBoundedString(request.resource.data.get('body', ''), 2000)
        // [RN-43] v14 re-audit fix — every OTHER field here used to be unbou -> docs/firestore-rules-notes.md#rn-43
        && isBoundedString(request.resource.data.get('icon', ''), 32)
        && isBoundedString(request.resource.data.get('meetingId', ''), 128)
        && isBoundedString(request.resource.data.get('type', ''), 64)
        && (request.resource.data.get('link', null) == null
            || isBoundedString(request.resource.data.get('link', ''), 300))
        && isBoundedString(request.resource.data.get('dedupKey', ''), 300)
        && isBoundedString(request.resource.data.get('taskId', ''), 200)
        && isBoundedString(request.resource.data.get('chatId', ''), 200)
        && isBoundedString(request.resource.data.get('month', ''), 7)
        // Phase 68 quota observer (functions/index.js sendNotificationQuota) keys off
        // senderUid — optional (system/scheduled sends omit it), but when present it
        // must be truthful: a caller can't attribute a notif to another sender.
        && (!request.resource.data.keys().hasAny(['senderUid'])
            || request.resource.data.get('senderUid', '') == request.auth.uid);
    }

    // [RN-44] Attendance ─ -> docs/firestore-rules-notes.md#rn-44
    match /attendance/{uid} {
      allow read: if isAuth() && (isOwner(uid) || canHrView());
    }
    match /attendance/{uid}/records/{date} {
      allow read: if isAuth() && (isOwner(uid) || canHrView());
      // Admins: unrestricted (the Present/Half/Absent edit path, stamps editedBy).
      allow write: if isAuth() && isOpsAdmin();
      // [RN-45] Owner self check-in / notification-driven auto-upgrade: sc -> docs/firestore-rules-notes.md#rn-45
      allow create, update: if isAuth() && isOwner(uid)
        && request.resource.data.get('attendanceScore', 0) in [0, 0.5, 1.0]
        && (resource == null || resource.data.get('editedBy', null) == null);
    }

    // [RN-46] Worker kiosk attendance (WS26) ─ -> docs/firestore-rules-notes.md#rn-46
    function isLinkedWorkerUid(workerId) {
      let p = get(/databases/$(database)/documents/worker_profiles/$(workerId)).data;
      return p.get('linkedUid','') == request.auth.uid && p.get('status', 'active') != 'inactive';
    }
    // [RN-47] v14 re-audit fix — status-FREE sibling of isLinkedWorkerUi -> docs/firestore-rules-notes.md#rn-47
    function isLinkedWorkerProfile(workerId) {
      return workerId != ''
        && exists(/databases/$(database)/documents/worker_profiles/$(workerId))
        && get(/databases/$(database)/documents/worker_profiles/$(workerId)).data.get('linkedUid','') == request.auth.uid;
    }
    // canHrView() adds the HR DEPARTMENT to the read side only; the admin write
    // path below is still isOpsAdmin(). See the helper.
    match /attendance_worker/{workerId} {
      allow read: if isAuth() && (canHrView() || isLinkedWorkerUid(workerId));
    }
    match /attendance_worker/{workerId}/records/{date} {
      allow read: if isAuth() && (canHrView() || isLinkedWorkerUid(workerId));
      // [RN-48] v14 re-audit hardening (self-service write only — isOpsAdm -> docs/firestore-rules-notes.md#rn-48
      allow write: if isAuth() && (isOpsAdmin() || (
        isLinkedWorkerUid(workerId)
        && request.resource.data.workerId == workerId
        && request.resource.data.get('date', date) == date
        && request.resource.data.get('recordedBy', request.auth.uid) == request.auth.uid
        // [RN-49] v14 P0 pay-integrity (re-audit fix) — a self-service clien -> docs/firestore-rules-notes.md#rn-49
        && (
          resource == null
            ? request.resource.data.keys().hasOnly(['workerId', 'date', 'recordedBy', 'attempts', 'pendingPunch'])
            : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workerId', 'date', 'recordedBy', 'attempts', 'pendingPunch'])
        )
        && (resource == null || resource.data.get('recordedBy', '') == request.auth.uid)
      ));
    }

    // ── Geofence work sites (v14 Type-B) ─
    match /geo_sites/{docId} {
      allow read: if isAuth() && !isPartner();
      allow create, update: if isAuth() && isOpsAdmin();
      allow delete: if isAuth() && isPresident();
    }

    // ── Attendance extension requests ─
    match /attendance_extensions/{docId} {
      // [RN-50] Internal HR data — external Brilliant Steel partners exclu -> docs/firestore-rules-notes.md#rn-50
      allow read: if isAuth() && !isPartner();
      // [RN-51] v14 re-audit fix — was a bare isAuth() with NO field const -> docs/firestore-rules-notes.md#rn-51
      allow create: if isAuth() && !isPartner() && (
        isOpsAdmin() ||
        (request.resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.get('status', '') == 'pending')
      ) && request.resource.data.keys().hasOnly(['uid','userName','date','status','requestedAt'])
        && isBoundedString(request.resource.data.get('userName', ''), 200)
        && isBoundedString(request.resource.data.get('date', ''), 20);
      allow update, delete: if isAuth() && isAdmin();
    }

    // [RN-52] Cash advances ─ -> docs/firestore-rules-notes.md#rn-52
    match /cash_advances/{docId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || isMoneyAdmin() || isSecretary()
      );
      // [RN-53] Employees may only file their OWN request, pending and unf -> docs/firestore-rules-notes.md#rn-53
      allow create: if isAuth() && isNonNegNumber(request.resource.data.get('amount', 0)) && (
        isMoneyAdmin() ||
        (request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.balance == 0)
      );
      // Only money-tier can approve or change the money. Owners may edit
      // non-financial details (e.g. reason) but never status/balance/amount.
      allow update: if isAuth() && (
        isMoneyAdmin() ||
        (resource.data.userId == request.auth.uid
          && request.resource.data.status  == resource.data.status
          && request.resource.data.balance == resource.data.balance
          && request.resource.data.amount  == resource.data.amount)
      );
      allow delete: if isAuth() && isPresident();
    }

    // [RN-54] Layoff (LAYOFF-SPEC 2026-08-19) ─ -> docs/firestore-rules-notes.md#rn-54
    match /layoffs/{docId} {
      // Employee reads their own episode(s); HR surface reads all. The HR
      // list queries (status=='active' / 'lifted' / uid==X) are provable via
      // the role disjunct; the employee side never lists (the pointer carries
      // everything) but may resolve their own doc.
      allow read: if isAuth() && (
        resource.data.get('uid', '') == request.auth.uid || canHrView()
      );
      allow create: if isAuth() && (isSeniorAdmin() || isHrDept())
        && request.resource.data.keys().hasOnly(
             ['uid','userName','employeeId','reason','status','effectiveDate',
              'placedBy','placedByName','createdAt',
              'liftedAt','liftedBy','liftedByName','liftNote'])
        && request.resource.data.get('status', '') == 'active'
        && request.resource.data.get('uid', '') != request.auth.uid
        && request.resource.data.get('placedBy', '') == request.auth.uid
        && request.resource.data.get('reason', '') != ''
        && isBoundedString(request.resource.data.get('reason', ''), 2000)
        && isBoundedString(request.resource.data.get('userName', ''), 200)
        && isBoundedString(request.resource.data.get('employeeId', ''), 50)
        && isBoundedString(request.resource.data.get('effectiveDate', ''), 20)
        && isBoundedString(request.resource.data.get('placedByName', ''), 200);
      // Lift / edit-reason-while-active. Status may only ever be
      // 'active'|'lifted'; uid is immutable (an episode can't be re-pointed).
      allow update: if isAuth() && (isSeniorAdmin() || isHrDept())
        && request.resource.data.get('uid', '') == resource.data.get('uid', '')
        && request.resource.data.get('status', '') in ['active', 'lifted']
        && isBoundedString(request.resource.data.get('reason', ''), 2000)
        // liftNote is nullable (spec §1.3). isBoundedString(null) is FALSE —
        // reading it unguarded would deny every lift that carries no note,
        // which is the common case. Null-tolerant, same shape as receiptUrl.
        && (request.resource.data.get('liftNote', null) == null
            || isBoundedString(request.resource.data.get('liftNote', ''), 1000));
      allow delete: if isAuth() && isPresident();
    }

    // [RN-55] Layoff expenses — the Statement of Account lines ─ -> docs/firestore-rules-notes.md#rn-55
    match /layoff_expenses/{docId} {
      allow read: if isAuth() && (
        resource.data.get('uid', '') == request.auth.uid || canHrView()
      );
      allow create: if isAuth() && !isPartner()
        && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'pending'
        && isNonNegNumber(request.resource.data.get('amount', 0))
        && request.resource.data.get('description', '') != ''
        && isBoundedString(request.resource.data.get('description', ''), 1000)
        && isBoundedString(request.resource.data.get('userName', ''), 200)
        && isBoundedString(request.resource.data.get('expenseDate', ''), 20)
        && isBoundedString(request.resource.data.get('layoffId', ''), 128)
        && (request.resource.data.get('receiptUrl', null) == null
            || isBoundedString(request.resource.data.get('receiptUrl', ''), 500))
        && (request.resource.data.get('receiptName', null) == null
            || isBoundedString(request.resource.data.get('receiptName', ''), 300))
        && request.resource.data.keys().hasOnly(
             ['layoffId','uid','userName','description','amount','expenseDate',
              'receiptUrl','receiptName','receiptKind','status',
              'approvedAmount','hrNote','decidedAt','decidedBy','decidedByName',
              'paidAt','paidDate','paidBy','paidByName','paidMethod',
              'createdAt','updatedAt']);
      allow update: if isAuth() && (
        // HR decisions & payment. approvedAmount validated whenever present.
        ((isSeniorAdmin() || isHrDept())
          && request.resource.data.get('status', '') in
               ['pending', 'approved', 'rejected', 'paid']
          && (request.resource.data.get('approvedAmount', null) == null
              || isNonNegNumber(request.resource.data.get('approvedAmount', 0)))
          // hrNote is nullable (spec §1.3) and stays null whenever HR approves
          // without typing a note — the DEFAULT case. isBoundedString(null) is
          // FALSE, so reading it unguarded would deny the ordinary approval.
          && (request.resource.data.get('hrNote', null) == null
              || isBoundedString(request.resource.data.get('hrNote', ''), 1000))) ||
        // Owner edit while (and only while) still pending — never the money
        // decision fields, never a status change, never re-owning.
        (resource.data.get('uid', '') == request.auth.uid
          && resource.data.get('status', '') == 'pending'
          && request.resource.data.get('status', '') == 'pending'
          && request.resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.get('layoffId', '')
               == resource.data.get('layoffId', '')
          && isNonNegNumber(request.resource.data.get('amount', 0))
          && isBoundedString(request.resource.data.get('description', ''), 1000)
          // Pin the edit to the employee's OWN fields. Without this the owner
          // could scribble approvedAmount/hrNote/paidDate/decidedByName onto a
          // still-pending line and fabricate an HR decision trail in the UI.
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['description','amount','expenseDate','receiptUrl',
                         'receiptName','receiptKind','updatedAt']))
      );
      // Owner may withdraw a still-pending line; president cleans up anything.
      allow delete: if isAuth() && (
        isPresident() ||
        (resource.data.get('uid', '') == request.auth.uid
          && resource.data.get('status', '') == 'pending')
      );
    }

    // ── Layoff file requests — HR asks, the employee delivers ─
    match /layoff_file_requests/{docId} {
      allow read: if isAuth() && (
        resource.data.get('uid', '') == request.auth.uid || canHrView()
      );
      allow create: if isAuth() && (isSeniorAdmin() || isHrDept())
        && request.resource.data.get('status', '') == 'open'
        && request.resource.data.get('createdBy', '') == request.auth.uid
        && request.resource.data.get('description', '') != ''
        && isBoundedString(request.resource.data.get('description', ''), 1000)
        && isBoundedString(request.resource.data.get('userName', ''), 200)
        && isBoundedString(request.resource.data.get('layoffId', ''), 128)
        && request.resource.data.keys().hasOnly(
             ['layoffId','uid','userName','description','dueDate','allowLink',
              'status','createdAt','createdBy','createdByName',
              'fulfilledAt','hubFileId','fileUrl','fileName','fileKind',
              'updatedAt']);
      allow update: if isAuth() && (
        (isSeniorAdmin() || isHrDept()) ||
        // The employee's ONE legitimate update: fulfilling the request.
        // Locked to the fulfilment fields so the request text/ownership can
        // never be rewritten from the receiving end.
        (resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.get('status', '') == 'fulfilled'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status','fulfilledAt','hubFileId','fileUrl',
                         'fileName','fileKind','updatedAt'])
          && (request.resource.data.get('fileUrl', null) == null
              || isBoundedString(request.resource.data.get('fileUrl', ''), 500))
          && (request.resource.data.get('fileName', null) == null
              || isBoundedString(request.resource.data.get('fileName', ''), 300)))
      );
      allow delete: if isAuth() && (isSeniorAdmin() || isHrDept());
    }

    // ── Tasks ─
    match /tasks/{taskId} {
      // [RN-56] v12 WS19: was bare isAuth() — a partner could browse EVERY -> docs/firestore-rules-notes.md#rn-56
      allow read: if isAuth() && (!isPartner() || request.auth.uid in resource.data.get('assignedTo', []));
      // [RN-57] Admins create any task. Design-dept members may create Des -> docs/firestore-rules-notes.md#rn-57
      allow create: if isAuth() && (
        isAdmin()
        || (isDesignDept() && request.resource.data.get('department', '') == 'Design')
        || ( !isPartner()
             && request.resource.data.get('createdBy', '') == request.auth.uid
             && ( inDept(request.resource.data.get('department', ''))
                  || request.auth.uid in request.resource.data.get('assignedTo', []) ) )
      );
      // [RN-58] Assignees update their own tasks; admins AND finance manag -> docs/firestore-rules-notes.md#rn-58
      allow update: if isAuth() && (
        (request.auth.uid in resource.data.get('assignedTo', [])) || isOpsAdmin()
      );
      // Admins delete any task; a creator may delete the task they made (the UI
      // already offers it to the creator, so this stops a silent permission fail).
      allow delete: if isAuth() && (isAdmin() || resource.data.get('createdBy', '') == request.auth.uid);

      // [RN-59] In-app "messaging" thread on a task. Rules do NOT inherit -> docs/firestore-rules-notes.md#rn-59
      function taskAssignee() {
        return request.auth.uid in get(/databases/$(database)/documents/tasks/$(taskId)).data.get('assignedTo', []);
      }
      match /comments/{commentId} {
        allow read:   if isAuth() && (!isPartner() || taskAssignee());
        allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAuth() && (
          resource.data.authorId == request.auth.uid || isAdmin()
        );
      }
      // Read receipts ("Seen by"). Each user writes only their own receipt.
      match /readers/{readerUid} {
        allow read:  if isAuth() && (!isPartner() || taskAssignee());
        allow write: if isAuth() && isOwner(readerUid);
      }
    }

    // [RN-60] Team Chat (v12 WS37) — conversations + messages/readers/ty -> docs/firestore-rules-notes.md#rn-60
    match /conversations/{convId} {
      // [RN-61] ⚠ 2026-08-10 — WHY THE PARTICIPANTS DISJUNCT IS TYPE-FENCE -> docs/firestore-rules-notes.md#rn-61
      function memberOfDoc() {
        return (request.auth.uid in resource.data.get('participants', []))
          || (resource.data.get('type','') == 'dept' && !isPartner()
              && deptChannelOpen(resource.data.get('department',''))
              && (isAdmin() || inDept(resource.data.get('department',''))));
      }
      // Membership via re-read, for subcollections (mirrors taskAssignee()).
      function convMember() {
        let c = get(/databases/$(database)/documents/conversations/$(convId)).data;
        return (request.auth.uid in c.get('participants', []))
          || (c.get('type','') == 'dept' && !isPartner()
              && deptChannelOpen(c.get('department',''))
              && (isAdmin() || inDept(c.get('department',''))));
      }

      // get: any member. list: the inbox query is participants array-contains,
      // provable from the first disjunct; dept docs are fetched by direct get.
      allow read: if isAuth() && memberOfDoc();

      // dm/group: creator must include themself. dept: lazy-create by any member;
      // the doc ID must be exactly 'dept_<department>' and participants must be [].
      allow create: if isAuth() && (
        ( request.resource.data.get('type','') in ['dm','group','announcement']
          && request.resource.data.get('createdBy','') == request.auth.uid
          && request.auth.uid in request.resource.data.get('participants', []) )
        ||
        ( request.resource.data.get('type','') == 'dept' && !isPartner()
          && deptChannelOpen(request.resource.data.get('department',''))
          && (isAdmin() || inDept(request.resource.data.get('department','')))
          && convId == 'dept_' + request.resource.data.get('department','')
          && request.resource.data.get('participants', []).size() == 0 )
      );

      // [RN-62] Any member may bump ONLY the lastMessage* preview fields ( -> docs/firestore-rules-notes.md#rn-62
      allow update: if isAuth() && (
        // [RN-63] v14 wave5: the send's preview bump may now also carry the -> docs/firestore-rules-notes.md#rn-63
        ( memberOfDoc() && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessageAt','lastMessageText','lastMessageBy','lastMessageByName','reads'])
          && (
               ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reads'])
                 && request.resource.data.get('reads', {})
                      .diff(resource.data.get('reads', {})).affectedKeys()
                      .hasOnly([request.auth.uid]) )
            || ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageText'])
                 && (resource.data.get('lastMessageBy','') == request.auth.uid || isAdmin()) )
            || ( request.resource.data.get('lastMessageBy','') == request.auth.uid
                 && request.resource.data.lastMessageAt == request.time
                 && ( !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reads'])
                      || request.resource.data.get('reads', {})
                           .diff(resource.data.get('reads', {})).affectedKeys()
                           .hasOnly([request.auth.uid]) ) )
             ) )
        || ( memberOfDoc() && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['wallpaper']) )
        // v14 wave5 (J7): per-user pin/mute/archive — a member may toggle ONLY
        // their own key inside these maps, nothing else in the same write.
        || ( memberOfDoc()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['pinnedBy','mutedBy','archivedBy'])
          && request.resource.data.get('pinnedBy', {})
              .diff(resource.data.get('pinnedBy', {})).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.get('mutedBy', {})
              .diff(resource.data.get('mutedBy', {})).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.get('archivedBy', {})
              .diff(resource.data.get('archivedBy', {})).affectedKeys().hasOnly([request.auth.uid]) )
        // [RN-64] v14 Wave1 P0 fix #4 — the creator/admin branch used to be -> docs/firestore-rules-notes.md#rn-64
        || ( (resource.data.get('createdBy','') == request.auth.uid || isAdmin())
          && memberOfDoc()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name','photoUrl','participants','participantNames','wallpaper','pinnedMsgIds'])
          && ( resource.data.get('type','') != 'dept'
               || !request.resource.data.diff(resource.data).affectedKeys()
                     .hasAny(['participants','participantNames']) ) )
        || ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
             && request.resource.data.get('participants', [])
                == resource.data.get('participants', []).removeAll([request.auth.uid]) )
      );

      allow delete: if isAuth() && isPresident();   // records kept forever

      match /messages/{messageId} {
        allow read:   if isAuth() && convMember();
        allow create: if isAuth() && convMember()
          && request.resource.data.get('authorId','') == request.auth.uid
          // v14 Wave2 — an announcement channel is post-restricted to its creator
          // or an admin; everyone else is read-only (client hides the composer too).
          && ( get(/databases/$(database)/documents/conversations/$(convId)).data.get('type','') != 'announcement'
               || get(/databases/$(database)/documents/conversations/$(convId)).data.get('createdBy','') == request.auth.uid
               || isAdmin() );
        // [RN-65] Author edits own message; admin moderates; any member may -> docs/firestore-rules-notes.md#rn-65
        allow update: if isAuth() && (
          ( resource.data.get('authorId','') == request.auth.uid
            && request.resource.data.get('authorId','') == resource.data.get('authorId','')
            && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
            && !(resource.data.get('deleted', false) == true
                 && request.resource.data.get('deleted', false) == false)
            && ( !request.resource.data.diff(resource.data).affectedKeys().hasAny(['text'])
                 || (resource.data.get('deleted', false) == false
                     && request.resource.data.get('deleted', false) == true)
                 || request.resource.data.get('editedAt', null) == request.time ) )
          || ( isAdmin()
               && request.resource.data.get('authorId','') == resource.data.get('authorId','')
               && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
               && request.resource.data.get('deleted', false) == true
               && request.resource.data.get('text','') == '' )
          || ( convMember()
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
               && request.resource.data.get('reactions', {})
                    .diff(resource.data.get('reactions', {})).affectedKeys()
                    .hasOnly([request.auth.uid]) )
        );
        allow delete: if isAuth()
          && (resource.data.get('authorId','') == request.auth.uid || isAdmin());
      }
      // Read receipts — per-viewer-writes-own-doc, verbatim tasks/readers shape
      // (+ convMember so a non-participant can't plant a receipt).
      match /readers/{readerUid} {
        allow read:  if isAuth() && convMember();
        allow write: if isAuth() && isOwner(readerUid) && convMember();
      }
      // Typing beacons — own doc only (write covers create/update/delete).
      match /typing/{typerUid} {
        allow read:  if isAuth() && convMember();
        allow write: if isAuth() && isOwner(typerUid) && convMember();
      }
    }

    // ── KPI evaluations ─
    match /kpi_evals/{uid} {
      // [RN-66] The president's grade lives in the SAME doc as the employe -> docs/firestore-rules-notes.md#rn-66
      function presFieldsUntouchedOnUpdate() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['presidentGrade','presidentNotes','presidentImprovements','presidentUpdatedAt','presidentGradeFromTasks','presidentScoreTaskCount']);
      }
      function presFieldsAbsentOnCreate() {
        return !request.resource.data.keys()
          .hasAny(['presidentGrade','presidentNotes','presidentImprovements','presidentUpdatedAt','presidentGradeFromTasks','presidentScoreTaskCount']);
      }
      // [RN-67] v12 WS19: create/update's admin branch narrowed to isSenio -> docs/firestore-rules-notes.md#rn-67
      allow read:   if isAuth() && (isOwner(uid) || isOpsAdmin());
      allow create: if isAuth() && (isSeniorAdmin() || (isOwner(uid) && presFieldsAbsentOnCreate()));
      allow update: if isAuth() && (isSeniorAdmin() || (isOwner(uid) && presFieldsUntouchedOnUpdate()));
      allow delete: if isAuth() && isOpsAdmin();
    }

    // ── KPI targets ─
    match /kpi_targets/{uid} {
      allow read: if isAuth() && (isOwner(uid) || isAdmin());
      allow write: if isAuth() && isAdmin();
    }

    // [RN-68] Settings ─ -> docs/firestore-rules-notes.md#rn-68
    match /settings/{docId} {
      allow read: if isAuth() && (!isPartner() || docId == 'system');
      allow write: if isAuth() && isPresident();
    }

    // ── Holidays admin overrides (WS26) ─
    // Dedicated collection so the looser finance/admin write does NOT touch
    // the president-only settings/{docId} match above (which also gates
    // employeeOfMonth/sales_sop — loosening it would loosen those too).
    match /settings_holidays/{year} {
      allow read:  if isAuth();
      allow write: if isAuth() && isOpsAdmin();
    }

    // [RN-69] Strategy / market-research notes (v12 WS40) ─ -> docs/firestore-rules-notes.md#rn-69
    match /strategy_notes/{deptKey} {
      allow read:  if isAuth() && isOpsAdmin() && strategyDeptOpen(deptKey);
      allow write: if isAuth() && isOpsAdmin() && strategyDeptOpen(deptKey)
        && request.resource.data.get('entries', []) is list;
      allow delete: if isAuth() && isPresident();
    }

    // ── System health (backup/sync heartbeat) ─
    // Written ONLY by the GitHub Actions backup/sync jobs via the Admin SDK
    // (which bypasses these rules). No client ever writes it.
    match /system_health/{jobId} {
      allow read:  if isAuth() && isOpsAdmin();
      allow write: if false;
    }

    // ── President message ─
    match /president_message/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && isPresident();
    }

    // ── SOPs — readable by internal staff, editable by admins ─
    // v12 WS19: read locked to !isPartner() — was bare isAuth(). Write stays
    // isAdmin() (secretary keeps this oversight/coordination surface).
    match /sops/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && isAdmin();
    }

    // [RN-70] Payroll (live pay: salary/allowance/deductions) -> docs/firestore-rules-notes.md#rn-70
    match /payroll/{uid} {
      allow read:  if isAuth() && (isOwner(uid) || isMoneyAdmin());
      // [RN-71] TEAM-PAGE-ORG-SPEC-2026-08-25 — an account admin may CREAT -> docs/firestore-rules-notes.md#rn-71
      allow create: if isAuth() && (
        isMoneyAdmin()
        || ( isAccountAdminFlag()
             && request.resource.data.get('payClass', 'regular') in ['regular', 'production']
             && isNonNegNumber(request.resource.data.get('salary', 0))
             && isNonNegNumber(request.resource.data.get('allowance', 0))
             && isNonNegNumber(request.resource.data.get('deductions', 0)) )
      );
      allow update: if isAuth() && isMoneyAdmin();
      allow delete: if isAuth() && isPresident();
    }

    // ── Salary history ─
    match /salary_history/{docId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || isMoneyAdmin()
      );
      allow create, update: if isAuth() && isMoneyAdmin();
      allow delete: if isAuth() && isPresident();
    }

    // [RN-72] Salary raises (audit log of pay increases) ─ -> docs/firestore-rules-notes.md#rn-72
    match /salary_raises/{docId} {
      allow read: if isAuth() && (
        isMoneyAdmin() ||
        resource.data.get('subjectId', '') == request.auth.uid ||
        isLinkedWorkerProfile(resource.data.get('subjectId', ''))
      );
      allow create, update: if isAuth() && isMoneyAdmin();
      allow delete: if isAuth() && isPresident();
    }

    // [RN-73] Pending / scheduled raises (v12 WS23 — approval-routed sch -> docs/firestore-rules-notes.md#rn-73
    match /pending_raises/{docId} {
      // [RN-74] Same half-dead subject branch as /salary_raises above — se -> docs/firestore-rules-notes.md#rn-74
      allow read: if isAuth() && (
        isMoneyAdmin() || isSecretary() ||
        resource.data.get('subjectId', '') == request.auth.uid ||
        isLinkedWorkerProfile(resource.data.get('subjectId', ''))
      );
      allow create: if isAuth() && (
        isPresident()
        || ( isMoneyAdmin()
             && request.resource.data.get('status','') == 'pending_approval' )
      );
      allow update: if isAuth() && (
        // Automated materialize: any finance, ONLY scheduled → applied.
        ( isMoneyAdmin()
          && resource.data.get('status','') == 'scheduled'
          && request.resource.data.get('status','') == 'applied' )
        // Approve / reject / cancel / reschedule: President only.
        || isPresident()
      );
      allow delete: if isAuth() && isPresident();
    }

    // ── Payroll CA overrides ─
    match /payroll_ca_overrides/{docId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || isMoneyAdmin()
      );
      allow write: if isAuth() && isMoneyAdmin();
    }

    // [RN-75] Payroll delete requests ─ -> docs/firestore-rules-notes.md#rn-75
    match /payroll_delete_requests/{docId} {
      allow read: if isAuth() && (isMoneyAdmin() || isSecretary());
      allow create: if isAuth() && isMoneyAdmin();
      allow update, delete: if isAuth() && isPresident();
    }

    // [RN-76] Pay runs (Compute → Verify → Disburse workflow state per m -> docs/firestore-rules-notes.md#rn-76
    match /statutory_tables/{year} {
      allow read: if isAuth() && isMoneyAdmin();
      allow create, update: if isAuth() && isPresident()
        && request.resource.data.get('verifiedBy', '') == request.auth.uid
        && request.resource.data.get('source', '') is string
        && request.resource.data.get('source', '') != '';
      allow delete: if false;   // a superseded year stays, for the audit trail
    }

    // [RN-77] ══ ONE PAYROLL, TWO PERIOD SHAPES (PAYROLL-REDESIGN-BRIEF -> docs/firestore-rules-notes.md#rn-77
    function payState(s) {
      return s == 'notstarted' ? 'draft'
           : s == 'prepared'   ? 'computed'
           : s == 'checked'    ? 'verified'
           : s == 'paid'       ? 'disbursed'
           : s;
    }

    match /pay_weeks/{weekId} {
      function stPrev()  { return payState(resource.data.get('state','draft')); }
      function stNext()  { return payState(request.resource.data.get('state','draft')); }
      function touched() { return request.resource.data.diff(resource.data).affectedKeys(); }
      // [RN-78] The backfill marker may only ever be SET by the backfill p -> docs/firestore-rules-notes.md#rn-78
      function markerHeld() {
        return request.resource.data.get('backfill', false) == resource.data.get('backfill', false);
      }
      // [RN-79] backfillLedger is THE HAZARD DECISION, recorded on the rec -> docs/firestore-rules-notes.md#rn-79
      function backfillMarked() {
        return request.resource.data.get('backfill', false) == true
          && request.resource.data.get('backfilledBy','') == request.auth.uid
          && request.resource.data.get('backfillLedger','') in ['posted','notPosted','skipped']
          && payState(request.resource.data.get('state','draft')) == 'disbursed';
      }

      allow read: if isAuth() && isMoneyAdmin();

      // [RN-80] A backfilled period is created ALREADY PAID — that is what -> docs/firestore-rules-notes.md#rn-80
      allow create: if isAuth() && isMoneyAdmin() && (
        payState(request.resource.data.get('state','draft')) in ['draft','computed']
        || backfillMarked()
      );

      allow update: if isAuth() && (
        // [RN-81] BACKFILL over an untouched draft ─ -> docs/firestore-rules-notes.md#rn-81
        ( isMoneyAdmin() && stPrev() == 'draft' && backfillMarked() )
        ||
        ( markerHeld() && (
          // ── PERIOD-SCOPED HOLD ─
          // "Hold or adjust one person", scoped to THIS period only. The state
          // must not move, and a paid week is frozen: once money has moved, who
          // was on that payroll is history, not a setting.
          ( isMoneyAdmin() &&
            stPrev() in ['draft','computed','verified'] &&
            stNext() == stPrev() &&
            touched().hasOnly(['excluded','excludedUpdatedAt','excludedUpdatedBy',
                               'holdReasons','heldReasons','state']) )
          ||
          // [RN-82] RECEIPTS, SAVED AS THEY ARE ATTACHED ─ -> docs/firestore-rules-notes.md#rn-82
          ( isMoneyAdmin() &&
            stPrev() in ['computed','verified'] &&
            stNext() == stPrev() &&
            touched().hasOnly(['receipts','receiptsUpdatedAt','receiptsUpdatedBy','state']) )
          ||
          // [RN-83] PER-LINE ADJUSTMENTS AND ONE-OFF AMOUNTS ─ -> docs/firestore-rules-notes.md#rn-83
          ( isMoneyAdmin() &&
            stPrev() in ['draft','computed'] &&
            stNext() == stPrev() &&
            touched().hasOnly(['adjustments','oneOffs','lines','totals','warnings',
                               'adjustedAt','adjustedBy','preparedAt','preparedBy','state']) )
          ||
          // prepare / re-prepare / check  (was: compute / re-compute / verify)
          ( isMoneyAdmin() &&
            stPrev() in ['draft','computed'] &&
            stNext() in ['computed','verified'] )
          ||
          // ── RELEASE ─
          // OWNER RULING 2026-08-10: Finance may release a verified week. The
          // transactional lock (verified -> disbursing -> disbursed) is the
          // two-step that stops a second press re-entering a run already in
          // flight.
          ( isMoneyAdmin() && (
              ( stPrev()=='verified'   && stNext()=='disbursing' ) ||
              ( stPrev()=='disbursing' && stNext()=='disbursed' )
          ))
          ||
          // [RN-84] REOPEN — PRESIDENT ONLY ─ -> docs/firestore-rules-notes.md#rn-84
          ( isPresident() && (
              ( stPrev()=='verified'   && stNext()=='computed' ) ||
              ( stPrev()=='disbursing' && stNext()=='computed' )
          ))
          ||
          // [RN-85] CORRECTION AFTER PAYMENT ─ -> docs/firestore-rules-notes.md#rn-85
          ( isMoneyAdmin() &&
            stPrev() == 'disbursed' && stNext() == 'disbursed' &&
            touched().hasOnly(['corrections','correctionRefs','correctedAt','correctedBy','state']) &&
            request.resource.data.get('correctedBy','') == request.auth.uid )
        ))
      );
      allow delete: if isAuth() && isPresident();
    }

    // [RN-86] THE SAME RULE AS pay_weeks ABOVE, clause for clause — read -> docs/firestore-rules-notes.md#rn-86
    match /pay_runs/{month} {
      function stPrev()  { return payState(resource.data.get('state','draft')); }
      function stNext()  { return payState(request.resource.data.get('state','draft')); }
      function touched() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function markerHeld() {
        return request.resource.data.get('backfill', false) == resource.data.get('backfill', false);
      }
      function backfillMarked() {
        return request.resource.data.get('backfill', false) == true
          && request.resource.data.get('backfilledBy','') == request.auth.uid
          && request.resource.data.get('backfillLedger','') in ['posted','notPosted','skipped']
          && payState(request.resource.data.get('state','draft')) == 'disbursed';
      }

      allow read: if isAuth() && isMoneyAdmin();
      // A backfilled month is created ALREADY PAID; `create` only fires when the
      // month does not exist, which is what stops a backfill landing on top of a
      // real run. See pay_weeks.
      allow create: if isAuth() && isMoneyAdmin() && (
        payState(request.resource.data.get('state','draft')) in ['draft','computed']
        || backfillMarked()
      );
      allow update: if isAuth() && (
        // Backfill over an untouched draft — the only clause that may SET the
        // marker, and only from 'draft'.
        ( isMoneyAdmin() && stPrev() == 'draft' && backfillMarked() )
        ||
        ( markerHeld() && (
        // [RN-87] PERIOD-SCOPED PAYROLL EXCLUSION (owner ruling 2026-08-10) -> docs/firestore-rules-notes.md#rn-87
        ( isMoneyAdmin() &&
          stPrev() in ['draft','computed','verified'] &&
          stNext() == stPrev() &&
          touched().hasOnly(['excluded','excludedUpdatedAt','excludedUpdatedBy',
                             'holdReasons','heldReasons','state']) )
        ||
        // Receipts, saved as they are attached — evidence, never a figure.
        // (The monthly run demanded no proof of payment at all; one receipt per
        // person is now the same rule on both sides.)
        ( isMoneyAdmin() &&
          stPrev() in ['computed','verified'] &&
          stNext() == stPrev() &&
          touched().hasOnly(['receipts','receiptsUpdatedAt','receiptsUpdatedBy','state']) )
        ||
        // Per-line adjustments and one-off amounts, up to CHECKED only.
        ( isMoneyAdmin() &&
          stPrev() in ['draft','computed'] &&
          stNext() == stPrev() &&
          touched().hasOnly(['adjustments','oneOffs','lines','totals','warnings',
                             'adjustedAt','adjustedBy','preparedAt','preparedBy','state']) )
        ||
        // prepare / re-prepare / check
        ( isMoneyAdmin() &&
          stPrev() in ['draft','computed'] &&
          stNext() in ['computed','verified'] )
        ||
        // [RN-88] RELEASE ─ -> docs/firestore-rules-notes.md#rn-88
        ( isMoneyAdmin() && (
            // verify → disbursing (transactional lock acquisition — Part E Phase 11)
            ( stPrev()=='verified'   && stNext()=='disbursing' ) ||
            // disbursing → disbursed (lock release on success)
            ( stPrev()=='disbursing' && stNext()=='disbursed' )
        ))
        ||
        ( isPresident() && (
            // president reopen: verified → computed
            ( stPrev()=='verified'   && stNext()=='computed' ) ||
            // president manual unlock after investigating a stuck/partial
            // disburse: disbursing → computed (Part E Phase 11)
            ( stPrev()=='disbursing' && stNext()=='computed' )
        ))
        ||
        // Correction after payment — an APPEND to `corrections` only. Every
        // figure that was paid stays frozen and the state cannot move; see the
        // pay_weeks block for the full reasoning.
        ( isMoneyAdmin() &&
          stPrev() == 'disbursed' && stNext() == 'disbursed' &&
          touched().hasOnly(['corrections','correctionRefs','correctedAt','correctedBy','state']) &&
          request.resource.data.get('correctedBy','') == request.auth.uid )
        ))
      );
      allow delete: if isAuth() && isPresident();
    }

    // ── Expenses ─
    match /expenses/{docId} {
      // [RN-89] v14 re-audit ROUND 2 — PERIOD-CLOSE GATE (see the ledger b -> docs/firestore-rules-notes.md#rn-89
      function expenseMonthOpen(d) {
        return !(d is string)
            || !d.matches('^\\d{4}-\\d{2}(-\\d{2})?$')
            || periodOpenFor(d);
      }
      // Both sides, so a row can be moved neither INTO nor OUT of a closed
      // month (the ledger's ledgerMaterialUpdateOk() does the same).
      function expensePeriodOk() {
        return expenseMonthOpen(resource.data.get('date', ''))
            && expenseMonthOpen(request.resource.data.get('date', ''));
      }
      allow read: if isAuth() && (
        resource.data.createdBy == request.auth.uid || isMoneyAdmin()
      );
      allow create: if isAuth() && request.resource.data.createdBy == request.auth.uid;
      // [RN-90] Owners may edit their own expense details but not approve -> docs/firestore-rules-notes.md#rn-90
      allow update: if isAuth() && (
        isMoneyAdmin() ||
        (resource.data.createdBy == request.auth.uid
          && request.resource.data.status == resource.data.status
          && request.resource.data.amount == resource.data.amount)
      ) && expensePeriodOk();
      // Delete is President-only — finance staff request it via the approval flow.
      allow delete: if isAuth() && isPresident();
    }

    // ── Submissions ─
    match /submissions/{docId} {
      allow read: if isAuth() && (
        resource.data.createdBy == request.auth.uid || isAdmin()
      );
      allow create: if isAuth() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuth() && isAdmin();
      allow delete: if isAuth() && isAdmin();

      // Submission message thread mirrors the parent's access (submitter ↔ admin).
      // Rules don't inherit to subcollections, so we re-check the parent here.
      match /comments/{commentId} {
        function parentSub() {
          return get(/databases/$(database)/documents/submissions/$(docId)).data;
        }
        allow read: if isAuth() && (
          parentSub().get('createdBy','') == request.auth.uid || isAdmin()
        );
        allow create: if isAuth()
          && request.resource.data.authorId == request.auth.uid
          && (parentSub().get('createdBy','') == request.auth.uid || isAdmin());
        allow update, delete: if isAuth() && (
          resource.data.authorId == request.auth.uid || isAdmin()
        );
      }
    }

    // [RN-91] Quotes (internal) ─ -> docs/firestore-rules-notes.md#rn-91
    match /quotes/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && isAdmin();
    }

    // ── BS Quotes (Brilliant Steel partner) ─
    // One-way visibility: partner quotes ARE visible to internal staff (Sales,
    // etc.) so they can coordinate; a partner only ever sees their OWN quotes.
    // (The reverse — partner reading internal bk_quotes — is denied below.)
    match /bs_quotes/{docId} {
      // v14 wave3 Q6: autosaved draft slot — exactly one per user, doc id
      // 'draft_{uid}'. Keyed on the ID (never on data fields — absent-field
      // reads DENY the whole rule) so create/update/delete of one's own
      // draft always works; drafts carry draftBy, not createdBy.
      allow read: if isAuth() && (
        resource.data.createdBy == request.auth.uid || !isPartner()
        || docId == 'draft_' + request.auth.uid
      );
      allow create: if isAuth() && (
        request.resource.data.createdBy == request.auth.uid
        || docId == 'draft_' + request.auth.uid
      );
      allow update: if isAuth() && (
        resource.data.createdBy == request.auth.uid || isAdmin()
        || docId == 'draft_' + request.auth.uid
      );
      // QB-DRAFTS-SPEC-2026-09-11: creator may delete their own explicit draft.
      allow delete: if isAuth() && (isAdmin() || docId == 'draft_' + request.auth.uid
        || (resource.data.get('status','') == 'draft'
            && resource.data.get('createdBy','') == request.auth.uid));
    }

    // ── BK Quotes (Barro Kitchens / internal Sales) ─
    // Internal sales quotes are NOT visible to external partners — only the
    // creator or an admin may read. A partner has no bk_quotes of their own,
    // so this collection is effectively invisible to them.
    match /bk_quotes/{docId} {
      allow read: if isAuth() && !isPartner() && (
        resource.data.createdBy == request.auth.uid || isAdmin()
        || docId == 'draft_' + request.auth.uid
      );
      // [RN-92] Admins may also create with a DIFFERENT createdBy: require -> docs/firestore-rules-notes.md#rn-92
      allow create: if isAuth() && !isPartner() &&
        (request.resource.data.createdBy == request.auth.uid || isAdmin()
         || docId == 'draft_' + request.auth.uid);
      allow update: if isAuth() && !isPartner() && (
        resource.data.createdBy == request.auth.uid || isAdmin()
        || docId == 'draft_' + request.auth.uid
      );
      // v14 wave3 Q6: own draft slot deletable (deleted on File); partner
      // exclusion for bk_quotes stays absolute.
      // QB-DRAFTS-SPEC-2026-09-11: creator may delete their own explicit draft.
      allow delete: if isAuth() && (isAdmin()
        || (!isPartner() && docId == 'draft_' + request.auth.uid)
        || (!isPartner() && resource.data.get('status','') == 'draft'
            && resource.data.get('createdBy','') == request.auth.uid));
    }

    // ── Quote cost sidecars (QB, owner 2026-09-21) ─ the cost basis (BOM/
    // costMat/labor/capital) stripped from quote docs, keyed <coll>_<docId>.
    // Internal-only: partners must never read Barro's cost basis.
    match /quote_costs/{id} {
      allow read, write: if isAuth() && !isPartner();
    }

    // [RN-93] Quote Templates (QUOTE-TEMPLATES-SPEC.md) ─ -> docs/firestore-rules-notes.md#rn-93
    match /quote_templates/{id} {
      allow read:   if isAuth() && !isPartner();               // internal Sales library
      allow create: if isAuth() && !isPartner()
                    && request.resource.data.get('createdBy','') == request.auth.uid;
      allow update, delete: if isAuth() && !isPartner()
                    && (resource.data.get('createdBy','') == request.auth.uid || isAdmin());
    }

    // ── Approval requests ─
    match /approval_requests/{docId} {
      // Internal workflow data — external partners excluded from reading.
      allow read: if isAuth() && !isPartner();
      // [RN-94] v13 Phase 21: the ONLY two client write sites into this co -> docs/firestore-rules-notes.md#rn-94
      allow create: if isAuth() &&
        (request.resource.data.get('userId', '') == request.auth.uid ||
         request.resource.data.get('agentId', '') == request.auth.uid ||
         isOpsAdmin()) &&
        request.resource.data.get('status', '') == 'pending' &&
        request.resource.data.get('type', '') in ['ca_deduct', 'bs_quote'] &&
        request.resource.data.keys().hasOnly([
          'type','status','createdAt','userId','userName','month','amount','reason',
          'quoteId','quoteColl','quoteNumber','clientName','total','agentName','agentId'
        ]) &&
        isNonNegNumber(request.resource.data.get('amount', 0));
      // [RN-95] v12 WS19: the client's APPROVAL_CAPS table already hides m -> docs/firestore-rules-notes.md#rn-95
      allow update: if isAuth() && (
        isSeniorAdmin() ||
        (isAdmin() && resource.data.get('type', '') in
          ['signup', 'attendance', 'submission', 'review-task', 'leave'])
      );
      allow delete: if isAuth() && isAdmin();
    }

    // ── Signup requests — anyone can apply (pre-auth) ──
    match /signup_requests/{docId} {
      // Public but constrained to the exact application shape, so this open
      // endpoint can't be abused to write arbitrary or oversized documents.
      allow create: if request.resource.data.keys().hasOnly(['fullName','email','phone','status','createdAt'])
        && request.resource.data.status == 'pending'
        && isBoundedString(request.resource.data.fullName, 120)
        && isBoundedString(request.resource.data.email, 200)
        && isBoundedString(request.resource.data.phone, 40);
      allow read, update, delete: if isAuth() && isAdmin();
    }

    // ── Partner deals (50/50 profit split) ─
    match /partner_deals/{docId} {
      // Partners can read their own deals; admins can read all.
      allow read: if isAuth() && (
        resource.data.partnerUid == request.auth.uid || isAdmin()
      );
      // Only money-tier can create/update deals (this is a profit-split payout
      // record) — partners cannot self-register earnings. v12 WS19: narrowed
      // from isAdmin() to isMoneyAdmin() so secretary can't post a deal.
      allow create, update: if isAuth() && isMoneyAdmin();
      allow delete: if isAuth() && isPresident();
    }

    // [RN-96] Products catalog ─ -> docs/firestore-rules-notes.md#rn-96
    function productCostFieldNotIncreased(field) {
      let nv = request.resource.data.get(field, null);
      let ov = resource.data.get(field, null);
      return nv == ov || nv == null;
    }
    function productCostFieldsLocked() {
      return productCostFieldNotIncreased('capitalMaterials')
          && productCostFieldNotIncreased('capitalLabor')
          && productCostFieldNotIncreased('bom');
    }
    match /products/{docId} {
      allow read: if isAuth();
      allow create: if isAuth() && isAdmin()
        && !('capitalMaterials' in request.resource.data)
        && !('capitalLabor' in request.resource.data)
        && !('bom' in request.resource.data);
      allow update: if isAuth() && isAdmin() && productCostFieldsLocked();
      allow delete: if isAuth() && isAdmin();
    }
    match /productMeta/{docId} {
      allow read: if isAuth();
      allow write: if isAuth() && isAdmin();
    }
    // [RN-97] Product cost basis (materials/labor capital + BOM unit cos -> docs/firestore-rules-notes.md#rn-97
    match /product_costs/_pace {
      allow read: if isAuth() && !isPartner();
    }
    match /product_costs/_settings {
      allow read: if isAuth() && !isPartner();
    }
    match /product_costs/{docId} {
      // [RN-98] ⚠ 2026-08-09 SECRETARY LEAK — isAdmin() -> isSeniorAdmin() -> docs/firestore-rules-notes.md#rn-98
      allow read, write: if isAuth() && !isPartner() && (isSeniorAdmin() || canFinance());
    }

    // [RN-99] Material Price List (COSTING PHASE 1, 2026-08-26) ─ -> docs/firestore-rules-notes.md#rn-99
    match /material_prices/{docId} {
      allow read, write: if isAuth() && !isPartner() && (isSeniorAdmin() || canFinance() || isPurchasingDept());
    }

    // ── Reference materials ─
    // v12 WS19: read locked to internal staff (!isPartner()) on all four — were
    // bare isAuth(). Write stays isAdmin() (secretary keeps this surface).
    match /resources/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && isAdmin();
    }
    match /policies/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && isAdmin();
    }
    match /handbook/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && isAdmin();
    }
    match /memos/{docId} {
      allow read:   if isAuth() && !isPartner();
      allow create: if isAuth() && isAdmin();
      allow delete: if isAuth() && isAdmin();
      // [RN-100] Admins edit freely. A tagged recipient may update ONLY to -> docs/firestore-rules-notes.md#rn-100
      allow update: if isAuth() && (
        isAdmin() || (
          (request.auth.uid in resource.data.get('recipients', []))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['conformes'])
          && request.resource.data.conformes.diff(resource.data.get('conformes', {}))
               .affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in resource.data.get('conformes', {}))
          && request.resource.data.conformes[request.auth.uid].keys().hasOnly(['at','name'])
          && request.resource.data.conformes[request.auth.uid].at == request.time
          && request.resource.data.conformes[request.auth.uid].name is string
          && request.resource.data.conformes[request.auth.uid].name.size() <= 200
        )
      );
    }

    // [RN-101] Projects ─ -> docs/firestore-rules-notes.md#rn-101
    match /projects/{docId} {
      allow read: if isAuth() && !isPartner();
      allow create: if isAuth();
      // [RN-102] Creator/admin can edit anything; finance (role or Finance- -> docs/firestore-rules-notes.md#rn-102
      allow update: if isAuth() && (
        resource.data.get('createdBy', '') == request.auth.uid || isAdmin() || canFinance() || canDesign()
      );
      allow delete: if isAuth() && isAdmin();
    }

    // [RN-103] Design drawings (flat, projectId-scoped; full revision con -> docs/firestore-rules-notes.md#rn-103
    match /design_drawings/{docId} {
      // President/manager, or the designLead of the drawing's parent project.
      // Role check FIRST so admins never depend on the project get() resolving.
      function isDrawingApprover() {
        return getRole() in ['president', 'manager']
          || request.auth.uid == get(/databases/$(database)/documents/projects/$(resource.data.get('projectId', '_none_'))).data.get('designLead', '');
      }
      function statusNow()  { return resource.data.get('status', ''); }
      function statusNext() { return request.resource.data.get('status', ''); }
      // Promotion = the status field is CHANGING to approved/released.
      function isPromotion() {
        return statusNext() in ['approved', 'released'] && statusNext() != statusNow();
      }
      // [RN-104] v14 re-audit fix — the two-party approval gate only covere -> docs/firestore-rules-notes.md#rn-104
      function isDemotion() {
        return statusNow() in ['approved', 'released'] && statusNext() != statusNow();
      }
      allow read:   if isAuth() && !isPartner();
      // v12 WS35: new drawings must start at draft (no API-created pre-approved docs).
      allow create: if isAuth() && canDesign()
                    && request.resource.data.get('createdBy', '') == request.auth.uid
                    && request.resource.data.get('status', 'draft') == 'draft';
      allow update: if isAuth() && (
        // (1) ordinary edits + non-privileged demotions (revisions,
        //     back-to-draft/review, supersede, reactivate, field edits with
        //     status unchanged) — the pre-WS35 gate. Excludes demotions OUT
        //     of approved/released (clause 4 below now owns those).
        ( !isPromotion() && !isDemotion() && (
             resource.data.get('createdBy', '')  == request.auth.uid
          || resource.data.get('assignedTo', '') == request.auth.uid
          || canDesign()
        ))
        // (2) APPROVE: for_review → approved, by an approver who is not the
        //     drawing's author or assigned designer (two-party control)
        || ( statusNext() == 'approved' && statusNow() == 'for_review'
          && isDrawingApprover()
          && request.auth.uid != resource.data.get('createdBy', '')
          && request.auth.uid != resource.data.get('assignedTo', '') )
        // (3) RELEASE: approved → released, by an approver (independence was
        //     already enforced when 'approved' was reached — see clause 2)
        || ( statusNext() == 'released' && statusNow() == 'approved'
          && isDrawingApprover() )
        // (4) DEMOTE: approved/released -> anything else, approver-only (v14
        //     re-audit fix — closes the self-demote-without-approval hole).
        || ( isDemotion() && isDrawingApprover() )
      );
      allow delete: if isAuth() && isAdmin();
    }

    // [RN-105] IT collections ─ -> docs/firestore-rules-notes.md#rn-105
    match /it_tickets/{docId} {
      allow read: if isAuth() && !isPartner();
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.get('createdBy', '') == request.auth.uid || canIt()
      );
      // [RN-106] Delete stays a pure moderator verb (no author disjunct) -> docs/firestore-rules-notes.md#rn-106
      allow delete: if isAuth() && isSeniorAdmin();
    }
    // [RN-107] IT assets/software: IT-dept members manage them (UI gates -> docs/firestore-rules-notes.md#rn-107
    match /it_assets/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && canIt();
    }
    match /it_software/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && canIt();
    }
    match /it_access/{docId} {
      allow read: if isAuth() && canIt();
      allow write: if isAuth() && canIt();
    }
    match /it_network/{docId} {
      allow read: if isAuth() && canIt();
      allow write: if isAuth() && canIt();
    }

    // ── Per-department document collections (renderDocCollection) ─
    // These were unruled → silent permission-denied (blank screens). Internal
    // staff read; the owning department (or an admin) writes. Partners excluded.
    match /work_plans/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && canDept('Sales');
    }
    match /marketing_plans/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && canDept('Marketing');
    }
    match /marketing_proposals/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && canDept('Marketing');
    }

    // [RN-108] Marketing suite (v12 WS34): campaigns, promotions calendar -> docs/firestore-rules-notes.md#rn-108
    match /campaigns/{docId} {
      allow read: if isAuth() && !isPartner();
      allow create: if isAuth() && canDept('Marketing')
        && request.resource.data.get('name', '') != ''
        && request.resource.data.get('status', 'planned') in ['planned','active','done','cancelled']
        && isNonNegNumber(request.resource.data.get('budget', 0))
        && request.resource.data.get('createdBy', '') == request.auth.uid;
      allow update: if isAuth() && canDept('Marketing')
        && request.resource.data.get('status', 'planned') in ['planned','active','done','cancelled']
        && isNonNegNumber(request.resource.data.get('budget', 0));
      // Delete is admin-only: clients.campaignId points here — cancel, don't delete.
      allow delete: if isAuth() && isAdmin();
    }
    match /promotions/{docId} {
      allow read: if isAuth() && !isPartner();
      allow create: if isAuth() && canDept('Marketing')
        && request.resource.data.get('title', '') != ''
        && request.resource.data.get('createdBy', '') == request.auth.uid;
      allow update, delete: if isAuth() && canDept('Marketing');
    }

    // [RN-109] Meta Ads integration (specs/META-ADS-SPEC-2026-08-30.md) ─ -> docs/firestore-rules-notes.md#rn-109
    match /ad_insights/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if false;
    }
    // meta_leads: the lead-webhook's claim/audit ledger (Cloud Function only).
    // Admin-readable for debugging; no client writes ever.
    match /meta_leads/{docId} {
      allow read: if isAuth() && isAdmin();
      allow write: if false;
    }

    match /marketing_templates/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && canDept('Marketing');
    }

    match /gov_philgeps/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && canDept('Government Biddings');
    }
    match /gov_active_bids/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && canDept('Government Biddings');
    }
    match /gov_archive/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && canDept('Government Biddings');
    }

    // [RN-110] AEC Partner Directory (Sales/CRM prospecting: architects/e -> docs/firestore-rules-notes.md#rn-110
    match /aec_contacts/{docId} {
      allow read: if isAuth() && !isPartner();
      allow create, update: if isAuth() && (canDept('Sales') || canDept('CRM') || isAdmin());
      allow delete: if isAuth() && isAdmin();
    }

    // [RN-111] ROC (restaurant) Lead Directory — CRM department (added 20 -> docs/firestore-rules-notes.md#rn-111
    match /roc_leads/{id} {
      allow read: if isAuth() && !isPartner();
      allow create, update: if isAuth() && (canDept('CRM') || canDept('Sales') || isAdmin());
      allow delete: if isAuth() && isAdmin();
    }

    // [RN-112] Ventures portfolio — Ventures department (added 2026-08-08 -> docs/firestore-rules-notes.md#rn-112
    match /meetings/{meetingId} {
      function isOrganizer() { return resource.data.get('organizerUid', '') == request.auth.uid; }
      function isInvitee()   { return request.auth.uid in resource.data.get('invitees', []); }
      // Only the caller's OWN rsvp key may move, and nothing else on the doc —
      // mirrors the reactions pattern used on chat messages.
      function rsvpOnlyByOwner() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvp'])
          && request.resource.data.get('rsvp', {}).diff(resource.data.get('rsvp', {}))
               .affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.get('rsvp', {})[request.auth.uid] in ['yes', 'no', 'maybe'];
      }
      // CREATE: the field must simply not be there.
      function noServerFieldsOnCreate() {
        return !request.resource.data.keys().hasAny(['remindersSent']);
      }
      // [RN-113] UPDATE: it must not CHANGE. Checking keys() here would be -> docs/firestore-rules-notes.md#rn-113
      function serverFieldsUnchanged() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['remindersSent']);
      }

      allow read: if isAuth() && !isPartner() && (isInvitee() || isOrganizer() || isAdmin());

      allow create: if isAuth() && !isPartner()
        && request.resource.data.get('organizerUid', '') == request.auth.uid
        && request.auth.uid in request.resource.data.get('invitees', [])
        && request.resource.data.get('invitees', []).size() <= 200
        && request.resource.data.get('title', '') is string
        && request.resource.data.get('title', '') != ''
        && request.resource.data.get('title', '').size() <= 140
        && request.resource.data.get('agenda', '').size() <= 4000
        && request.resource.data.get('location', '').size() <= 300
        && request.resource.data.get('status', '') == 'scheduled'
        && request.resource.data.get('startAt', request.time) is timestamp
        && noServerFieldsOnCreate();

      // [RN-114] ⚠ 2026-08-10 — the oversight tier's WRITE on this collecti -> docs/firestore-rules-notes.md#rn-114
      allow update: if isAuth() && !isPartner() && (
        ( (isOrganizer() || isSeniorAdmin())
          && request.resource.data.get('organizerUid', '') == resource.data.get('organizerUid', '')
          && request.resource.data.get('title', '') != ''
          && request.resource.data.get('title', '').size() <= 140
          && request.resource.data.get('agenda', '').size() <= 4000
          && request.resource.data.get('location', '').size() <= 300
          && request.resource.data.get('notes', '').size() <= 4000
          && request.resource.data.get('status', 'scheduled') in ['scheduled', 'cancelled']
          && request.resource.data.get('invitees', []).size() <= 200
          && serverFieldsUnchanged() )
        ||
        ( isInvitee() && rsvpOnlyByOwner() )
      );

      // Same narrowing as update, same reason — cancelling someone else's meeting
      // outright is the sharper end of the verb, not the milder one.
      allow delete: if isAuth() && (isOrganizer() || isSeniorAdmin());
    }

    match /ventures/{id} {
      allow read: if isAuth() && !isPartner() && canDept('Ventures');
      allow create: if isAuth() && !isPartner() && canDept('Ventures')
        && request.resource.data.get('name', '') != ''
        && request.resource.data.get('slug', '') != ''
        && request.resource.data.get('status', 'exploring')
             in ['active', 'exploring', 'paused', 'archived'];
      allow update: if isAuth() && !isPartner() && canDept('Ventures')
        && request.resource.data.get('name', '') != ''
        && request.resource.data.get('status', 'exploring')
             in ['active', 'exploring', 'paused', 'archived'];
      // Delete is admin-only (president/manager/secretary) — same low-stakes
      // rationale as aec_contacts/roc_leads: no delete-request flow, because
      // nothing here is a financial record.
      allow delete: if isAuth() && isAdmin();
    }

    // [RN-115] Finance journals & records ─ -> docs/firestore-rules-notes.md#rn-115
    function ledgerDateOk() {
      return request.resource.data.get('date', '').matches('^\\d{4}-\\d{2}(-\\d{2})?$');
    }
    function ledgerPeriodOpen() {
      return periodOpenFor(request.resource.data.get('date', ''));
    }
    // [RN-116] v13 Phase 84 — generalized period-close check, reusable by -> docs/firestore-rules-notes.md#rn-116
    function periodOpenFor(dateStr) {
      return isPresident() ||
        !exists(/databases/$(database)/documents/finance_periods/$(
          dateStr.split('-')[0] + '-' + dateStr.split('-')[1])) ||
        get(/databases/$(database)/documents/finance_periods/$(
          dateStr.split('-')[0] + '-' + dateStr.split('-')[1])).data.get('closed', false) == false;
    }
    match /finance_periods/{month} {
      // [RN-117] v14 re-audit ROUND 2 widened this read from canFinance() t -> docs/firestore-rules-notes.md#rn-117
      allow read: if isAuth() && canFinance();
      allow create, update: if isAuth() && isPresident();
      allow delete: if false;
    }
    // ── Finance config (v14 post-release: break-even classification etc.) ──
    // Small finance-owned settings docs (fixed/variable category mapping,
    // manual fixed-cost entries). Finance tier read+write.
    match /finance_config/{docId} {
      allow read, write: if isAuth() && canFinance();
    }

    // [RN-118] Finance rollups (v14 wave4 F2) ─ -> docs/firestore-rules-notes.md#rn-118
    match /finance_rollup/{docId} {
      // [RN-119] v14 re-audit ROUND 2 — period gate. These docs ARE the mon -> docs/firestore-rules-notes.md#rn-119
      function rollupMonthOpen(m) {
        return !(m is string) || !m.matches('^\\d{4}-\\d{2}$') || periodOpenFor(m);
      }
      allow read: if isAuth() && canFinance();
      // [RN-120] v14 re-audit fix — was unfenced `write` (create+update+del -> docs/firestore-rules-notes.md#rn-120
      allow create, update: if isAuth() && (canFinance() || (isProductionDept() && !isSecretary()))
        && request.resource.data.keys().hasOnly(
             ['month','income','expense','vatOutput','vatInput','byCategory','count','updatedAt'])
        && rollupMonthOpen(docId)
        && rollupMonthOpen(request.resource.data.get('month', ''));
      allow delete: if isAuth() && canFinance();
    }

    match /ledger/{docId} {
      allow read: if isAuth() && canFinance();
      // [RN-121] v14 re-audit fix — recover the production_orders docId emb -> docs/firestore-rules-notes.md#rn-121
      function pocosOrderId(ref) {
        return ref.split('POCOS-')[1].split('-INV')[0];
      }
      // [RN-122] v14 re-audit fix — /ledger UPDATE was the ONE money-collec -> docs/firestore-rules-notes.md#rn-122
      function ledgerNonMaterialUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['reconciled', 'reconciledBy', 'reconciledAt',
           'cleared', 'clearedBy', 'clearedAt',
           'bankAccountId', 'bankAccountName',
           'editedBy', 'editedByName', 'editedAt']);
      }
      // [RN-123] periodOpenFor() ERRORS (= denies) on anything it can't spl -> docs/firestore-rules-notes.md#rn-123
      function ledgerMonthOpen(d) {
        return !(d is string)
            || !d.matches('^\\d{4}-\\d{2}(-\\d{2})?$')
            || periodOpenFor(d);
      }
      // [RN-124] A material edit must carry a well-formed date OR leave the -> docs/firestore-rules-notes.md#rn-124
      function ledgerMaterialUpdateOk() {
        return ( ledgerDateOk()
                 || request.resource.data.get('date', '') == resource.data.get('date', '') )
            && ledgerMonthOpen(resource.data.get('date', ''))
            && ledgerMonthOpen(request.resource.data.get('date', ''));
      }
      // [RN-125] Finance/admin post anything (subject to the date + period- -> docs/firestore-rules-notes.md#rn-125
      allow create: if isAuth() && ledgerDateOk() && ledgerPeriodOpen()
        && request.resource.data.get('bankFlow', '') in ['', 'in', 'out'] && (
        canFinance()
        // [RN-126] ⚠ 2026-08-09 SECRETARY LEAK — canProduction() -> isProduct -> docs/firestore-rules-notes.md#rn-126
        || (isProductionDept() && !isSecretary()
            && request.resource.data.get('source', '') == 'Production'
            && request.resource.data.get('amount', 0) is number
            && request.resource.data.get('amount', 0) > 0
            && (
              // expense leg (COS – Direct Material) — old clients (no accountType
              // field) and new clients (accountType:'expense') both accepted.
              (request.resource.data.get('type', '') == 'debit'
                && request.resource.data.get('category', '') == 'COS – Direct Material'
                && request.resource.data.get('refNumber', '').matches('POCOS-.*')
                && request.resource.data.get('accountType', 'expense') == 'expense'
                && exists(/databases/$(database)/documents/production_orders/$(pocosOrderId(request.resource.data.get('refNumber','')))))
              ||
              // Inventory contra leg — new clients only.
              (request.resource.data.get('type', '') == 'credit'
                && request.resource.data.get('accountType', '') == 'asset'
                && request.resource.data.get('account', '') == 'Inventory'
                && request.resource.data.get('refNumber', '').matches('POCOS-.*-INV')
                && exists(/databases/$(database)/documents/production_orders/$(pocosOrderId(request.resource.data.get('refNumber','')))))
            ))
      );
      allow update: if isAuth() && canFinance()
        && request.resource.data.get('bankFlow', '') in ['', 'in', 'out']
        && ( ledgerNonMaterialUpdate() || ledgerMaterialUpdateOk() );
      allow delete: if isAuth() && isPresident();
    }
    match /ledger_entries/{docId} {
      allow read: if isAuth() && canFinance();
      allow create, update: if isAuth() && canFinance();
      allow delete: if isAuth() && isPresident();
    }
    // [RN-127] v13 Phase 84 — period-close backstop (RULES side of C6/Pha -> docs/firestore-rules-notes.md#rn-127
    function journalMonthOpen(d) {
      return !(d is string)
          || !d.matches('^\\d{4}-\\d{2}(-\\d{2})?$')
          || periodOpenFor(d);
    }
    // [RN-128] Both sides, so a row can be moved neither INTO nor OUT of -> docs/firestore-rules-notes.md#rn-128
    function journalUpdatePeriodOk() {
      return journalMonthOpen(resource.data.get('date', ''))
          && journalMonthOpen(request.resource.data.get('date', ''));
    }
    match /cash_receipt_journal/{docId} {
      allow read: if isAuth() && canFinance();
      allow create: if isAuth() && canFinance() && ledgerDateOk() && periodOpenFor(request.resource.data.get('date', ''));
      allow update: if isAuth() && canFinance() && ledgerDateOk() && journalUpdatePeriodOk();
      allow delete: if isAuth() && isPresident();
    }
    match /cash_disbursement_journal/{docId} {
      allow read: if isAuth() && canFinance();
      allow create: if isAuth() && canFinance() && ledgerDateOk() && periodOpenFor(request.resource.data.get('date', ''));
      allow update: if isAuth() && canFinance() && ledgerDateOk() && journalUpdatePeriodOk();
      allow delete: if isAuth() && isPresident();
    }
    match /general_journal/{docId} {
      allow read: if isAuth() && canFinance();
      allow create: if isAuth() && canFinance() && ledgerDateOk() && periodOpenFor(request.resource.data.get('date', ''));
      allow update: if isAuth() && canFinance() && ledgerDateOk() && journalUpdatePeriodOk();
      allow delete: if isAuth() && isPresident();
    }
    match /finance_records/{docId} {
      allow read: if isAuth() && canFinance();
      allow create, update: if isAuth() && canFinance();
      allow delete: if isAuth() && isPresident();
    }
    match /tax_records/{docId} {
      allow read: if isAuth() && canFinance();
      allow create, update: if isAuth() && canFinance();
      allow delete: if isAuth() && isPresident();
    }
    // [RN-129] Purchase requisitions — the Purchasing department's RFQ → -> docs/firestore-rules-notes.md#rn-129
    match /purchase_requisitions/{docId} {
      allow read: if isAuth() && (canPurchasing() || canFinance());
      allow create: if isAuth() && canPurchasing();
      allow update: if isAuth() && (
        // [RN-130] (a) Purchasing edits freely EXCEPT the approval verdict: a -> docs/firestore-rules-notes.md#rn-130
        (canPurchasing()
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(
                ['approvalStatus','approvedBy','approvedByName','approvedByTitle','approvedAt',
                 'rejectedBy','rejectedByName','rejectedAt','rejectedReason'])
              || request.resource.data.get('approvalStatus','') == 'pending'
              || (request.resource.data.get('approvalStatus','') == ''
                  && request.resource.data.get('stage','pr') == 'rfq'))
          && (!(request.resource.data.get('status','') in ['ordered','received'])
              || resource.data.get('approvalStatus','legacy') in ['approved','legacy']))
        // (b) President/Manager render the verdict — and may touch NOTHING else
        //     in the same write (can't rewrite items/prices under cover of approving).
        || (isSeniorAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['approvalStatus','approvedBy','approvedByName','approvedByTitle','approvedAt',
               'rejectedBy','rejectedByName','rejectedAt','rejectedReason','updatedAt']))
        // (c) Finance may ONLY stamp the bookkeeping fields (unchanged from pre-WS30).
        || (canFinance() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['recordedToFinance','recordedToFinanceAt','recordedBy','recordedByName','cdjEntryId']))
      );
      allow delete: if isAuth() && (isPresident()
        || (canPurchasing() && resource.data.get('stage', 'rfq') == 'rfq'));
    }

    // [RN-131] Finance delete requests ─ -> docs/firestore-rules-notes.md#rn-131
    match /finance_delete_requests/{docId} {
      allow read: if isAuth() && (canFinance() || isSecretary());
      allow create: if isAuth() && canFinance();
      allow update, delete: if isAuth() && isPresident();
    }

    // [RN-132] Bank accounts registry (v12 WS36) ─ -> docs/firestore-rules-notes.md#rn-132
    match /bank_accounts/{docId} {
      allow read:   if isAuth() && canFinance();
      allow create, update: if isAuth() && isMoneyAdmin()
        && request.resource.data.get('nickname', '') is string
        && request.resource.data.get('nickname', '') != ''
        && request.resource.data.get('openingBalance', 0) is number
        && request.resource.data.get('type', 'bank') in ['bank', 'ewallet', 'cash'];
      allow delete: if isAuth() && isPresident();
    }

    // [RN-133] Department budgets (DEPT-BUDGETS-SPEC-2026-08-11) ─ -> docs/firestore-rules-notes.md#rn-133
    match /dept_budget_releases/{docId} {
      allow read: if isAuth() && (canFinance() || isSecretary()
        || (!isPartner() && inDept(resource.data.get('dept', ''))));
      allow create: if isAuth() && canFinance()
        && request.resource.data.get('dept', '') != ''
        && request.resource.data.get('type', '') in ['float', 'ceiling']
        && request.resource.data.get('amount', 0) is number
        && request.resource.data.get('amount', 0) > 0
        && request.resource.data.get('status', '') == 'active'
        && (request.resource.data.get('type', '') == 'ceiling'
            || request.resource.data.get('custodianUid', '') != '');
      allow update: if isAuth() && canFinance()
        && request.resource.data.get('amount', 0) is number
        && request.resource.data.get('amount', 0) > 0
        && request.resource.data.get('status', 'active') in ['active', 'closed']
        && request.resource.data.get('dept', '') == resource.data.get('dept', '');
      allow delete: if isAuth() && isPresident();
    }
    match /dept_budget_requests/{docId} {
      allow read: if isAuth() && (canFinance() || isSecretary()
        || (!isPartner() && inDept(resource.data.get('dept', ''))));
      allow create: if isAuth()
        && (canFinance() || (!isPartner() && !isSecretary()
                             && inDept(request.resource.data.get('dept', ''))))
        && request.resource.data.get('requestedBy', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('dept', '') != ''
        && request.resource.data.get('amount', 0) is number
        && request.resource.data.get('amount', 0) > 0;
      // Finance decides; OR the requester edits/cancels their own still-pending
      // request (status may only stay 'pending' or become 'cancelled').
      allow update: if isAuth() && (
        canFinance()
        || ( !isPartner() && !isSecretary()
          && resource.data.get('requestedBy', '') == request.auth.uid
          && resource.data.get('status', '') == 'pending'
          && request.resource.data.get('status', '') in ['pending', 'cancelled']
          && request.resource.data.get('dept', '') == resource.data.get('dept', '') )
      );
      allow delete: if isAuth() && ( isPresident()
        || ( resource.data.get('requestedBy', '') == request.auth.uid
          && resource.data.get('status', '') == 'pending' ) );
    }
    match /dept_spend_logs/{docId} {
      allow read: if isAuth() && (canFinance() || isSecretary()
        || (!isPartner() && inDept(resource.data.get('dept', ''))));
      // Proof is REQUIRED at the boundary, not just in the form: at least one
      // attachment, or a typed no-receipt reason (owner: receipts or an
      // explicit, flagged excuse — a silently optional field means none).
      allow create: if isAuth()
        && (canFinance() || (!isPartner() && !isSecretary()
                             && inDept(request.resource.data.get('dept', ''))))
        && request.resource.data.get('loggedBy', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('dept', '') != ''
        && request.resource.data.get('releaseId', '') != ''
        && request.resource.data.get('amount', 0) is number
        && request.resource.data.get('amount', 0) > 0
        && ( request.resource.data.get('attachments', []).size() > 0
          || request.resource.data.get('noReceiptReason', '') != '' );
      // (a) Finance decides/settles — money tier, any field.
      // (b) The logger edits their own pending/rejected log and resubmits:
      //     status can only be 'pending' again, identity/dept keys frozen.
      allow update: if isAuth() && (
        canFinance()
        || ( !isPartner() && !isSecretary()
          && resource.data.get('loggedBy', '') == request.auth.uid
          && resource.data.get('status', '') in ['pending', 'rejected']
          && request.resource.data.get('status', '') == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['date','description','amount','budgetLineId','budgetLineName',
                'refNumber','attachments','noReceipt','noReceiptReason',
                'overspendAtLog','releaseId','releaseTitle','status','updatedAt'])
          && request.resource.data.get('amount', 0) is number
          && request.resource.data.get('amount', 0) > 0
          && ( request.resource.data.get('attachments', []).size() > 0
            || request.resource.data.get('noReceiptReason', '') != '' ) )
      );
      // Undecided → the logger may withdraw. Decided → President only (a
      // confirmed spend has ledger legs; those route via financeDelete).
      allow delete: if isAuth() && ( isPresident()
        || ( resource.data.get('loggedBy', '') == request.auth.uid
          && resource.data.get('status', '') == 'pending' ) );
    }

    // ── Payslips & Worker profiles (Brilliant Steel) ─
    match /payslips/{docId} {
      // [RN-134] v14 re-audit fix — the two owner branches here were BOTH d -> docs/firestore-rules-notes.md#rn-134
      allow read: if isAuth() && (
        isMoneyAdmin() ||
        isLinkedWorkerProfile(resource.data.get('workerId', ''))
      );
      // [RN-135] v14 re-audit fix — WS19's money-tier narrowing (see isMone -> docs/firestore-rules-notes.md#rn-135
      allow create, update: if isAuth() && isMoneyAdmin();
      allow delete: if isAuth() && isPresident();
    }
    match /worker_profiles/{docId} {
      // v14 Type-B self-service: a linked login account may read ITS OWN
      // profile (the linkedUid lookup the worker dashboard boots from).
      allow read: if isAuth() && (isMoneyAdmin()
        || resource.data.get('linkedUid','') == request.auth.uid);
      // [RN-136] v14 re-audit fix — money-tier, same rationale as payslips -> docs/firestore-rules-notes.md#rn-136
      allow create: if isAuth() && (
        isMoneyAdmin()
        || ( isAccountAdminFlag()
             && isNonNegNumber(request.resource.data.get('dailyRate', 0))
             && isNonNegNumber(request.resource.data.get('hourlyRate', 0))
             && isNonNegNumber(request.resource.data.get('foodAllowance', 0))
             && request.resource.data.get('caBalance', 0) == 0 )
      );
      allow update: if isAuth() && isMoneyAdmin();
      // [RN-137] TEAM-PAGE-ORG-SPEC-2026-08-25 — account-admin LINK-ONLY up -> docs/firestore-rules-notes.md#rn-137
      allow update: if isAuth() && isAccountAdminFlag()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedUid'])
        && resource.data.get('linkedUid', '') == ''
        && request.resource.data.get('linkedUid', '') is string
        && request.resource.data.get('linkedUid', '') != '';
      // [RN-138] Owner ruling 2026-08-12: "hr should be able to reinstate t -> docs/firestore-rules-notes.md#rn-138
      allow update: if isAuth() && inDept('HR')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'reinstatedAt', 'reinstatedBy'])
        && request.resource.data.status == 'active';
      allow delete: if isAuth() && isPresident();
    }
    // [RN-139] Worker directory (public-safe roster projection, v12 WS28) -> docs/firestore-rules-notes.md#rn-139
    match /worker_directory/{docId} {
      allow read:           if isAuth() && !isPartner();
      // [RN-140] v14 re-audit fix — this mirror is maintained by the SAME H -> docs/firestore-rules-notes.md#rn-140
      allow create: if isAuth() && (isMoneyAdmin() || isAccountAdminFlag());
      allow update: if isAuth() && (isMoneyAdmin()
        || ( isAccountAdminFlag()
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedUid']) ));
      allow delete:         if isAuth() && isMoneyAdmin();
    }

    // ── Government biddings ─
    match /gov_biddings/{docId} {
      // Government bidding pipeline is internal-only — external partners excluded
      // from reading (null-safe getRole(): null is treated as "not partner").
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && isAdmin();
    }

    // ── Departments config ─
    // v12 WS19: read locked to !isPartner() — was bare isAuth().
    match /departments/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && isAdmin();
    }

    // [RN-141] Inventory (raw materials + finished goods) ─ -> docs/firestore-rules-notes.md#rn-141
    match /inventory_items/{docId} {
      allow read:   if isAuth() && !isPartner();
      allow create, update: if isAuth() && !isPartner() && !isSecretary()
        && (isSeniorAdmin() || canFinance() || inDept('Inventory') || isPurchasingDept() || isProductionDept());
      allow delete: if isAuth() && isSeniorAdmin();
    }
    // Stock movement log — append-only for the same writer set; history is
    // never rewritten except by senior admins.
    match /stock_movements/{docId} {
      allow read:   if isAuth() && !isPartner();
      allow create: if isAuth() && !isPartner() && !isSecretary()
        && (isSeniorAdmin() || canFinance() || inDept('Inventory') || isPurchasingDept() || isProductionDept());
      allow update, delete: if isAuth() && isSeniorAdmin();
    }
    // Job costing carries revenue/margin per project — finance/admin only.
    match /job_costs/{docId} {
      allow read, write: if isAuth() && isMoneyAdmin();
    }

    // [RN-142] Production orders (shop-floor pipeline) ─ -> docs/firestore-rules-notes.md#rn-142
    match /production_orders/{docId} {
      allow read:   if isAuth() && !isPartner();
      allow create: if isAuth() && !isPartner() && (canProduction() || inDept('Sales'))
        && request.resource.data.get('stage','') != 'out_for_delivery'
        && request.resource.data.get('stage','') != 'delivered';
      // [RN-143] canProduction() = isAdmin() || isProductionDept(), and isA -> docs/firestore-rules-notes.md#rn-143
      allow update: if isAuth() && !isPartner() && canProduction() && !isSecretary()
        // QC gate — may not ENTER Out for Delivery without a passed inspection
        && ( request.resource.data.get('stage','') != 'out_for_delivery'
             || resource.data.get('stage','') in ['out_for_delivery','ready']
             || request.resource.data.get('qc', {}).get('result','') == 'passed' )
        // DR gate — may not ENTER Delivered without a delivery receipt
        && ( request.resource.data.get('stage','') != 'delivered'
             || resource.data.get('stage','') == 'delivered'
             || request.resource.data.get('deliveryReceipt', null) != null );
      allow delete: if isAuth() && isAdmin();
    }

    // [RN-144] Audit log (append-only) ─ -> docs/firestore-rules-notes.md#rn-144
    match /audit_log/{docId} {
      // [RN-145] v12 WS41: a user may list THEIR OWN trail (provable for -> docs/firestore-rules-notes.md#rn-145
      allow read:   if isAuth()
        && (isSeniorAdmin() || resource.data.get('actorUid','') == request.auth.uid);
      // [RN-146] v14 re-audit fix — action/entity/entityId/details had no s -> docs/firestore-rules-notes.md#rn-146
      allow create: if isAuth()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorRole == getRole()
        && request.resource.data.ts == request.time
        && request.resource.data.keys().hasOnly(['ts','action','entity','entityId','details','actorUid','actorName','actorRole'])
        && isBoundedString(request.resource.data.get('action', ''), 100)
        && isBoundedString(request.resource.data.get('entity', ''), 100)
        && (request.resource.data.get('entityId', null) == null
            || isBoundedString(request.resource.data.get('entityId', ''), 200))
        && request.resource.data.get('details', {}) is map
        && request.resource.data.get('details', {}).size() <= 50;
      allow update: if false;
      allow delete: if isAuth() && isPresident();
    }

    // [RN-147] Client error log (v13 Phase 8) ─ -> docs/firestore-rules-notes.md#rn-147
    match /error_log/{docId} {
      // v14 re-audit fix — page/version/ua had no size bound at all (only
      // message/stack were capped); same flood risk as audit_log above. All
      // three are always plain strings client-side (js/errlog.js buildPayload).
      allow create: if isAuth()
        && request.resource.data.keys().hasOnly(['message','stack','page','version','uid','ua','ts'])
        && isBoundedString(request.resource.data.get('message', ''), 500)
        && isBoundedString(request.resource.data.get('stack', ''), 2000)
        && isBoundedString(request.resource.data.get('page', ''), 100)
        && isBoundedString(request.resource.data.get('version', ''), 40)
        && isBoundedString(request.resource.data.get('ua', ''), 200)
        && request.resource.data.ts == request.time
        && (!request.resource.data.keys().hasAny(['uid'])
            || request.resource.data.uid == null
            || request.resource.data.uid == request.auth.uid);
      // [RN-148] ⚠ 2026-08-10 — read isAdmin() -> isSeniorAdmin(), delete i -> docs/firestore-rules-notes.md#rn-148
      allow read:   if isAuth() && isSeniorAdmin();
      allow update: if false;
      allow delete: if isAuth() && isPresident();
    }

    // ── Leave requests ─
    // Employees file their own request (pending only) and read their own;
    // finance/admin read all + approve/reject; only the president deletes.
    match /leave_requests/{docId} {
      // canHrView() = isOpsAdmin() || HR-department member. READ only: the
      // approve/reject verb (the `update` clause below) is still isOpsAdmin().
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || canHrView()
      );
      // Shape-validate days/userName on every create; an employee may only file
      // their OWN request as pending. Finance/admin may file on anyone's behalf.
      allow create: if isAuth()
        && request.resource.data.days is number
        && request.resource.data.days > 0
        && request.resource.data.days <= 366
        && request.resource.data.userName is string
        && (
          isOpsAdmin() ||
          (request.resource.data.userId == request.auth.uid
            && request.resource.data.status == 'pending')
        );
      // Only finance/admin may mutate a request after it's filed (approve/reject).
      // Employees never update — the client only ever creates — so the owner has
      // no update path (which would otherwise let them tamper post-approval).
      allow update: if isAuth() && isOpsAdmin();
      allow delete: if isAuth() && isPresident();
    }

    // ── Sales orders (won project → payment → finance) ──
    // Anyone internal (incl. partners) can create an order for a project they
    // closed and read their own; finance/admin read all + update (post to books).
    match /sales_orders/{docId} {
      // [RN-149] Internal operational doc: any non-partner staff may read ( -> docs/firestore-rules-notes.md#rn-149
      allow read:   if isAuth() && (
        resource.data.createdBy == request.auth.uid || !isPartner()
      );
      allow create: if isAuth() && request.resource.data.createdBy == request.auth.uid;
      // Finance keeps full update rights. Design may write ONLY the design-flow
      // handoff fields (send-to-production stamps + the handoff trio) — never
      // money/status/recorded* fields. hasOnly on the affected-keys diff.
      allow update: if isAuth() && (
        canFinance()
        || ( canDesign()
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                  ['sentToProduction', 'sentToProductionAt',
                   'targetDate', 'priority', 'notes',
                   'designDoneAt', 'designDoneBy', 'noDrawingsNeeded', 'updatedAt']) )
      );
      allow delete: if isAuth() && isPresident();
    }

    // ── Project lifecycle (the spine: quote→order→production→delivery→paid) ──
    // Internal staff read + manage all; a partner sees only their own BS projects.
    match /job_projects/{docId} {
      // Partner sees projects they created OR shared projects originating from their quote.
      // Partner may NOT edit profit factors — only the project owner / non-partner staff can update.
      allow read:   if isAuth() && (resource.data.createdBy == request.auth.uid || resource.data.partnerUid == request.auth.uid || !isPartner());
      allow create: if isAuth() && request.resource.data.createdBy == request.auth.uid;
      // v12 WS36 — money keys need books access; stage/timeline/documents/tracking
      // edits stay open to internal staff exactly as before (affectedKeys diff, so
      // writes not touching money keys are unaffected).
      allow update: if isAuth() && (resource.data.createdBy == request.auth.uid || !isPartner())
        && ( !request.resource.data.diff(resource.data).affectedKeys().hasAny(
               ['payments', 'amountCollected', 'arBalance', 'invoices', 'dpPercent', 'balanceSchedule'])
             || canFinance() );
      allow delete: if isAuth() && isAdmin();
    }

    // [RN-150] Public order tracking (client-facing, PUBLIC read by ungue -> docs/firestore-rules-notes.md#rn-150
    match /order_tracking/{token} {
      allow get:    if true;
      allow list:   if false;
      allow create: if isAuth() && (
        !isPartner()
        || (
          request.resource.data.get('orderId', '') != ''
          && exists(/databases/$(database)/documents/sales_orders/$(request.resource.data.get('orderId', '')))
          && get(/databases/$(database)/documents/sales_orders/$(request.resource.data.get('orderId', ''))).data.get('createdBy', '') == request.auth.uid
        )
      );
      allow update: if isAuth() && !isPartner();
      allow delete: if isAuth() && isAdmin();
    }

    // [RN-151] Public client-facing quote mirror (share-with-client) ─ -> docs/firestore-rules-notes.md#rn-151
    match /public_quotes/{token} {
      allow get:  if true;
      allow list: if false;

      function srcQuote(rd) {
        return get(/databases/$(database)/documents/$(rd.get('src', {}).get('coll', 'bs_quotes'))/$(rd.get('src', {}).get('id', '_none_'))).data;
      }
      function srcIsMine(rd) {
        return rd.get('src', {}).get('coll', '') in ['bs_quotes', 'bk_quotes']
            && rd.get('src', {}).get('id', '') != ''
            && exists(/databases/$(database)/documents/$(rd.get('src', {}).get('coll', ''))/$(rd.get('src', {}).get('id', '')))
            && srcQuote(rd).get('createdBy', '') == request.auth.uid;
      }
      // A staff/partner write may never fabricate or alter a client response:
      // create must start it 'pending'; update must leave it untouched or
      // reset it to 'pending' (deliberate "re-open for response" after a fix).
      function responseUntouchedOrReset() {
        return request.resource.data.get('clientResponse', {}).get('status', 'pending') == 'pending'
            || request.resource.data.get('clientResponse', {}) == resource.data.get('clientResponse', {});
      }

      allow create: if isAuth()
        && request.resource.data.get('clientResponse', {}).get('status', '') == 'pending'
        && (!isPartner() || srcIsMine(request.resource.data));
      allow update: if isAuth()
        && responseUntouchedOrReset()
        && (!isPartner() || (srcIsMine(resource.data) && srcIsMine(request.resource.data)));
      allow delete: if isAuth()
        && (!isPartner() || srcIsMine(resource.data));
    }

    // [RN-152] Public ID verification (QR scan target, WS27) ─ -> docs/firestore-rules-notes.md#rn-152
    match /id_verify/{token} {
      allow get:  if true;
      allow list: if false;
      // [RN-153] v14 re-audit fix — the self-mint branch used to accept ANY -> docs/firestore-rules-notes.md#rn-153
      function selfMintMatchesCaller() {
        let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        let d = request.resource.data;
        let realName   = u.get('displayName', '') != '' ? u.get('displayName', '') : u.get('name', '');
        let realId     = u.get('employeeId', '') != '' ? u.get('employeeId', '') : u.get('idNumber', '');
        let realTitle  = u.get('title', '') != '' ? u.get('title', '') : u.get('jobTitle', '');
        let realStatus = u.get('status', '') == 'inactive' ? 'inactive' : 'active';
        let realDepts  = u.get('departments', []).size() > 0
          ? u.get('departments', [])
          : (u.get('department', '') != '' ? [u.get('department', '')] : []);
        let deptStr    = d.get('department', '');
        let deptTokens = deptStr == '' ? [] : deptStr.split(', ');
        return d.get('name', '')     == realName
            && d.get('idNumber', '') == realId
            && d.get('jobTitle', '') == realTitle
            && d.get('status', '')   == realStatus
            && d.get('photoUrl', '') == u.get('photoUrl', '')
            && realDepts.hasAll(deptTokens);
      }
      allow create, update: if isAuth() && !isPartner() && (
        isOpsAdmin() ||                                     // HR mints worker + employee cards
        ( request.resource.data.get('kind','') == 'employee'      // employee self-mints OWN card only
          && request.resource.data.get('uid','') == request.auth.uid
          && selfMintMatchesCaller() )
      );
      allow delete: if isAuth() && isAdmin();
    }

    // ── Leave balances (remaining day counters per user) ─
    // Kept in their own collection (NOT on the users doc) so finance can set
    // balances without being granted broad write access to user profiles.
    // The owner reads their own balance; finance/admin read all + write.
    match /leave_balances/{uid} {
      allow read:  if isAuth() && (isOwner(uid) || isOpsAdmin());
      // Shape-guard so a buggy accrual run can't write NaN/negative/wrong-typed counters.
      // .get(field,default) — a missing field must not deny the rule (missing-field-throws memory).
      allow write: if isAuth() && isOpsAdmin()
        && isNonNegNumber(request.resource.data.get('vacation', 0))
        && isNonNegNumber(request.resource.data.get('sick', 0));
    }

    // ── Leave accruals (annual grant idempotency key + forfeiture audit) ─
    // docId = {uid}_{YYYY}. Owner reads own history; finance/admin read all +
    // write (grant runs in admin context — employees never write). President-only delete.
    match /leave_accruals/{docId} {
      allow read:   if isAuth() && (resource.data.get('uid','') == request.auth.uid || isOpsAdmin());
      allow create: if isAuth() && isOpsAdmin()
        && isNonNegNumber(request.resource.data.get('grantedVacation', 0))
        && isNonNegNumber(request.resource.data.get('grantedSick', 0));
      allow update: if isAuth() && isOpsAdmin();
      allow delete: if isAuth() && isPresident();
    }

    // ── Suggestions ─
    match /suggestions/{docId} {
      allow read: if isAuth() && isAdmin();
      allow create: if isAuth();
      allow update, delete: if isAuth() && isAdmin();
    }

    // [RN-154] Client CRM — UNIFIED (v12 WS32) ─ -> docs/firestore-rules-notes.md#rn-154
    match /clients/{docId} {
      allow read:   if isAuth() && !isPartner();
      allow create, update: if isAuth() && !isPartner()
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '') != '';
      allow delete: if isAuth() && isAdmin();
    }
    // Legacy archives (records-forever directive): staff read, admin-only write
    // (migration stamps `migratedTo`), nothing else. Partner read of bs_clients
    // is REMOVED — no partner-facing code ever read it (grep-verified WS32 brief).
    match /sales_clients/{docId}  { allow read: if isAuth() && !isPartner(); allow write: if isAuth() && isAdmin(); }
    match /design_clients/{docId} { allow read: if isAuth() && !isPartner(); allow write: if isAuth() && isAdmin(); }
    match /bs_clients/{docId}      { allow read: if isAuth() && !isPartner(); allow write: if isAuth() && isAdmin(); }

    // [RN-155] Dynamic / runtime-named collections ─ -> docs/firestore-rules-notes.md#rn-155
    match /{coll}/{docId} {
      // [RN-156] Files: readable by internal staff; you own what you upload -> docs/firestore-rules-notes.md#rn-156
      allow read:   if isAuth() && coll.matches('files_.*') && !isPartner();
      allow create: if isAuth() && coll.matches('files_.*') && !isPartner()
                    && request.resource.data.uploadedBy == request.auth.uid;
      allow update, delete: if isAuth() && coll.matches('files_.*') && !isPartner()
                    && (resource.data.uploadedBy == request.auth.uid || isAdmin());
    }
    match /{coll}/{docId} {
      // [RN-157] Budget lines: internal planning data. v12 WS19: this was a -> docs/firestore-rules-notes.md#rn-157
      allow read:  if isAuth() && coll.matches('budgets_.*') && !isPartner();
      // [RN-158] v12 WS34: widened so a dept member can manage their OWN de -> docs/firestore-rules-notes.md#rn-158
      allow create: if isAuth() && coll.matches('budgets_.*')
        && ( isMoneyAdmin()
          || (!isPartner() && inDept(request.resource.data.get('dept',''))) );
      allow update, delete: if isAuth() && coll.matches('budgets_.*')
        && ( isMoneyAdmin()
          || (!isPartner() && inDept(resource.data.get('dept',''))) );
    }

    // [RN-159] Files Hub (WS38) — unified file metadata + folder tree ─ -> docs/firestore-rules-notes.md#rn-159
    match /hub_files/{fileId} {
      allow read: if isAuth() && (
           isSeniorAdmin()
        || resource.data.get('uploadedBy','') == request.auth.uid
        || request.auth.uid in resource.data.get('sharedUserIds', [])
        || (!isPartner() && resource.data.get('visibility','company') == 'company')
      );
      allow create: if isAuth() && !isPartner()
        && request.resource.data.get('uploadedBy','') == request.auth.uid
        && request.resource.data.get('visibility','company') in ['company','private']
        && request.resource.data.get('deleted', false) == false;
      // Owner/admin: any update (incl. sharing/visibility). Editors: content &
      // organization fields only — NEVER the ACL/ownership fields.
      allow update: if isAuth() && (
           isSeniorAdmin()
        || resource.data.get('uploadedBy','') == request.auth.uid
        || (request.auth.uid in resource.data.get('editorUserIds', [])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                 ['name','description','fileType','folderId','archived',
                  'deleted','deletedAt','deletedBy',
                  'url','driveUrl','size','contentType','versions','currentV',
                  'updatedAt']))
      );
      // Permanent delete = president only (Recycle Bin soft-delete/restore are updates).
      allow delete: if isAuth() && isPresident();
    }
    match /hub_folders/{folderId} {
      allow read:   if isAuth() && !isPartner();
      allow create: if isAuth() && !isPartner()
        && request.resource.data.get('createdBy','') == request.auth.uid;
      allow update, delete: if isAuth() && !isPartner()
        && (resource.data.get('createdBy','') == request.auth.uid || isAdmin());
    }

    // [RN-160] Year in Review (owner ruling 2026-08-12: end-of-year figur -> docs/firestore-rules-notes.md#rn-160
    match /company_year_review/{year} {
      allow read:   if isAuth() && !isPartner();
      allow create, update, delete: if isAuth() && isPresident();
    }
  }
}
