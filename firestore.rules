rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auth helpers ───────────────────────────────────
    function isAuth()         { return request.auth != null; }
    function isOwner(uid)     { return request.auth.uid == uid; }

    // Null-safe role lookup. Reading `.data.role` directly THROWS (and denies the
    // rule) when the user doc or the `role` field is absent — which legitimately
    // happens for freshly-created / worker / older profiles. .get('role', null)
    // degrades to null instead, so callers can treat "no role" as "not privileged"
    // and "not partner" rather than being hard-denied. Returns null when missing.
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null);
    }
    // 'secretary' (Corporate Secretary) is an admin-portal oversight role with
    // manager-level access. It is intentionally NOT in isPresident(), so deletions of
    // key records (finance, payroll, ledger — all gated on isPresident below) still
    // require the President's approval, exactly as for managers.
    function isAdmin()   { return getRole() in ['president', 'manager', 'secretary']; }
    function isPresident(){ return getRole() == 'president'; }
    // Owner ruling 2026-08-08: the Corporate Secretary may reach every department
    // EXCEPT Finance and IT. isSecretary() is the explicit hook for the three
    // read-only money-request carve-outs below (ruling 1) and for the two
    // department gates that must survive a profile edit (ruling 3).
    function isSecretary(){ return getRole() == 'secretary'; }
    // The two departments closed to the Corporate Secretary, as ONE expression.
    // A dept-scoped surface that admits isAdmin() admits the secretary, because
    // isAdmin() lists them — so every such surface needs this said explicitly.
    // Used by the dept CHAT CHANNELS below: the client stopped listing
    // # Finance and # IT for them on 2026-08-09, but the rules still let those
    // two threads be read and posted to by id, which is the layer that counts.
    function deptOpenToSecretary(d) { return !(d == 'Finance' || d == 'IT'); }
    function deptChannelOpen(d) { return !isSecretary() || deptOpenToSecretary(d); }
    function isPartner()     { return getRole() == 'partner'; }
    function isSeniorAdmin() { return getRole() in ['president', 'manager']; }
    function isMoneyAdmin()  { return getRole() in ['president', 'manager', 'finance']; }

    // ── isOpsAdmin() — THE SPLIT OF THE OLD 4-ROLE HELPER (2026-08-09) ───────
    // The deleted helper (president|manager|secretary|finance — see
    // SECRETARY-SCOPE-SPEC.md for its name and full history) was ONE NAME FOR
    // TWO UNRELATED TIERS. Of its 42 call
    // sites only 17 were about money; the other 25 were attendance, tasks,
    // leave, holidays, KPI, strategy notes, system health and ID-minting — i.e.
    // the Corporate Secretary's actual job. Two of those 25 are load-bearing:
    // `tasks` update is the ONLY non-assignee update clause (there is no
    // isAdmin() fallback on that verb) and `leave_requests` update IS the
    // approve/reject verb. So simply dropping 'secretary' from the old helper
    // would not have SCOPED the role, it would have DELETED it.
    //
    // Therefore: SPLIT, don't narrow.
    //   • isOpsAdmin()  — the OLD BODY VERBATIM. Company-oversight surface.
    //                     25 sites. No principal gains or loses anything here.
    //   • isMoneyAdmin()— the pre-existing money tier. The 17 finance sites now
    //                     point here. (Verified: the old set minus
    //                     'secretary' IS isMoneyAdmin() exactly, so narrowing the
    //                     old body in place would have produced a duplicate set
    //                     and a permanent drift hazard.)
    //
    // The old helper is DELETED rather than left as an alias, on
    // purpose: a missed call site is then an UNKNOWN FUNCTION and
    // `firebase deploy --only firestore:rules` REFUSES TO COMPILE. The compiler
    // is the test suite for a change that has no test suite. The old NAME is
    // deliberately absent from this file, comments included, so that grepping
    // this file for it is an exact, zero-judgement check (expected count: 0)
    // rather than one a reader has to eyeball prose for. The name and the full
    // 42-site classification live in SECRETARY-SCOPE-SPEC.md.
    function isOpsAdmin()    { return getRole() in ['president', 'manager', 'secretary', 'finance']; }

    // Member of the Finance DEPARTMENT (by string `department` or array `departments`),
    // regardless of their role. Lets a Finance-dept staffer record sales income even if
    // their role isn't the special 'finance' role.
    //
    // ⚠ OWNER RULING 3 (2026-08-08) — THE ROLE DECISION ALWAYS WINS.
    // canFinance() = isMoneyAdmin() || isFinanceDept(). Without the role test
    // below, giving the Corporate Secretary's profile the Finance department —
    // one dropdown in People & Roles, no rules change, no review — would hand
    // back the ENTIRE money tier (ledger, journals, rollups, finance_config,
    // sales_orders update, finance_delete_requests …) and silently evaporate
    // the carve-out. The exclusion therefore lives HERE, inside the boundary,
    // not in the UI. It reads `role` off the SAME user doc this function
    // already fetched, so it costs no extra get().
    function isFinanceDept() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.get('role', null) != 'secretary'
        && (u.get('department', '') == 'Finance' || u.get('departments', []).hasAny(['Finance']));
    }
    // Anyone allowed to operate the books: money-tier role OR Finance-dept member.
    // v12 WS19: was the old ops/finance tier ||isFinanceDept() — narrowed to
    // isMoneyAdmin() so 'secretary' no longer has ledger/journal write access
    // via this helper. 2026-08-09: ruling 3 closes the isFinanceDept() back door.
    function canFinance() { return isMoneyAdmin() || isFinanceDept(); }

    // Member of the Design DEPARTMENT (by string `department` or array `departments`).
    // Same null-safe pattern as isFinanceDept(). Gates Design drawings + project edits.
    function isDesignDept() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.get('department', '') == 'Design' || u.get('departments', []).hasAny(['Design']);
    }
    // Anyone allowed to manage Design work: admin role OR Design-dept member.
    function canDesign() { return isAdmin() || isDesignDept(); }

    // Member of the Purchasing DEPARTMENT (by string `department` or array `departments`).
    function isPurchasingDept() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.get('department', '') == 'Purchasing' || u.get('departments', []).hasAny(['Purchasing']);
    }
    // Anyone allowed to manage Purchasing work: admin role OR Purchasing-dept member.
    function canPurchasing() { return isAdmin() || isPurchasingDept(); }

    // Member of the Production DEPARTMENT (by string `department` or array `departments`).
    function isProductionDept() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.get('department', '') == 'Production' || u.get('departments', []).hasAny(['Production']);
    }
    function canProduction() { return isAdmin() || isProductionDept(); }

    // Generic department membership (null-safe), and "admin OR member of dept D".
    // Used by the per-department document collections (work plans, marketing plans,
    // gov bidding buckets, IT assets/software, etc.).
    function inDept(d) {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.get('department', '') == d || u.get('departments', []).hasAny([d]);
    }
    function canDept(d) { return isAdmin() || inDept(d); }

    // ── canIt() — IT boundary for the Corporate Secretary (owner ruling) ──────
    // canDept('IT') resolves through isAdmin(), which INCLUDES 'secretary', so it
    // can never express "everyone but the secretary". A dedicated predicate can.
    // Ruling 3 again: the exclusion is on the ROLE, so it also holds for a
    // secretary whose profile is later given the IT department.
    // canDept() itself is deliberately NOT touched — it is the sole write gate
    // for Sales work plans, all five Marketing collections and the three Gov
    // Bidding buckets, i.e. departments the secretary KEEPS.
    function canIt() { return !isSecretary() && canDept('IT'); }

    // ── IDENTITY BINDING (v14 re-audit ROUND 2 — critical) ─────────────
    // `email` + `pendingPasswordSetup` are together the KEY that
    // createUserDocOnAuthCreate (functions/index.js, Admin SDK — bypasses every
    // rule in this file) uses to decide that a users doc is an unclaimed
    // signup-approval PLACEHOLDER and to hand its entire contents — role
    // included — to whoever next registers a Firebase Auth account at that
    // address. Neither field was frozen anywhere, and `pendingPasswordSetup`
    // did not appear in this file at all, so ANY isAdmin() (manager OR
    // secretary) could run
    //     users/<PRESIDENT_UID>.update({ email:'attacker@…',
    //                                    pendingPasswordSetup:true })
    // — role/department/departments/employeeId all byte-identical, so
    // userPrivilegedFieldsUnchanged() passed — then create an Auth account at
    // that address (Email/Password is enabled and the web apiKey is public) and
    // let the trigger copy role:'president' onto it AND DELETE the real
    // President's doc. That converts the CREATE-side fixes above (a manager may
    // not mint a president; a secretary may not mint the money tier) into
    // decoration: the attacker never creates a privileged doc, they CONVERT one.
    //
    // So: the two fields that mark a doc as claimable are immutable for every
    // branch below except the President's own. No client code path anywhere in
    // the repo updates either field — the ONE writer of pendingPasswordSetup is
    // signupApprove's batch.set() at CREATE time (js/svc-approvals.js), and
    // `email` is only ever written at create (js/app.js self-signup,
    // js/screens/people.js invite, js/screens/dashboards.js worker-create); the
    // Edit Employee, HR payslip-identity and offboarding writers all leave it
    // alone. Freezing them therefore costs no existing flow. It is deliberately
    // applied to the OWNER too: `email` is the binding between this doc and the
    // Auth account, and a user re-pointing their own doc at someone else's
    // address is the same laundering primitive from the other end.
    // NOTE this is only HALF the fix and not the load-bearing half — see
    // functions/index.js createUserDocOnAuthCreate, which must not adopt (or
    // delete) a doc that is a live account rather than a real placeholder,
    // because a privileged doc whose email happens to have no Auth account can
    // still be claimed with the flag alone.
    function userIdentityBindingUnchanged() {
      return request.resource.data.get('email', null) == resource.data.get('email', null)
          && request.resource.data.get('pendingPasswordSetup', null)
             == resource.data.get('pendingPasswordSetup', null);
    }

    // True when a user-profile update leaves all privileged fields untouched.
    // Used so a non-admin can edit their own name/photo/phone but NOT promote
    // themselves (role) or change their own pay/department/employee ID.
    // NOTE: use .get(field, null) — directly reading a field that is absent on
    // the document raises an error (which DENIES the rule). Worker/partner/older
    // profiles legitimately lack some of these fields, so a direct read broke
    // their routine self-updates (e.g. the lastSeen presence heartbeat). With
    // .get(), an absent field compares null==null and is correctly "unchanged".
    function userPrivilegedFieldsUnchanged() {
      let n = request.resource.data;
      let o = resource.data;
      return n.get('role', null)        == o.get('role', null)
          && n.get('salary', null)      == o.get('salary', null)
          && n.get('allowance', null)   == o.get('allowance', null)
          && n.get('deductions', null)  == o.get('deductions', null)
          && n.get('department', null)  == o.get('department', null)
          && n.get('departments', null) == o.get('departments', null)
          && n.get('employeeId', null)  == o.get('employeeId', null)
          // v12 WS19: username is also privileged — it's the lookup key in the
          // new usernames/{u} map (login), so a free self-change would desync it.
          && n.get('username', null)    == o.get('username', null)
          // v14 re-audit fix — hrManagedAccount is only ever legitimately set
          // ONCE, at account CREATE time (js/screens/dashboards.js "Create Worker
          // Account" flow); no code path ever updates it. Freezing it here closes
          // a privilege-escalation chain: without this, any isAdmin() could flip
          // hrManagedAccount:true onto an ALREADY-EXISTING doc (e.g. the
          // President's) via a plain update, then call the adminResetPassword
          // callable (functions/index.js) — whose only server-side precondition
          // on the target was that same flag — to silently reset that account's
          // password and take it over.
          && n.get('hrManagedAccount', null) == o.get('hrManagedAccount', null)
          // v14 offboarding — removed/reinstated flags are privileged: a user
          // must never flip their OWN removed flag (self-reinstate) via a raw
          // client write. President/manager (isSeniorAdmin) and the HR
          // offboarding branch below are the only legitimate writers.
          && n.get('removed', null)      == o.get('removed', null)
          && n.get('removedAt', null)    == o.get('removedAt', null)
          && n.get('removedBy', null)    == o.get('removedBy', null)
          && n.get('reinstatedAt', null) == o.get('reinstatedAt', null)
          && n.get('reinstatedBy', null) == o.get('reinstatedBy', null)
          // v14 re-audit ROUND 2 — see userIdentityBindingUnchanged() above.
          // Covers the OWNER and the non-senior isAdmin() (secretary) branches,
          // which are the two that call this helper.
          && userIdentityBindingUnchanged();
    }

    // ── Shape validators (Phase 92) ─────────────────────
    // Shared primitives for the repeated "number, non-negative" and
    // "string, capped length" shape checks scattered across create/update
    // rules below. Callers must pass a value already extracted via
    // .get(field, default) — these helpers do NOT read the document
    // themselves, so they never hit the missing-field-throws hazard as
    // long as the caller supplies a default at the call site.
    function isNonNegNumber(v) { return v is number && v >= 0; }
    function isBoundedString(v, max) { return v is string && v.size() <= max; }

    // ── Users ──────────────────────────────────────────
    match /users/{uid} {
      // v14 re-audit fix — `read` covers BOTH get and list, so the old bare
      // `allow read: if isAuth()` let ANY signed-in principal (an external
      // partner most sharply, but equally any compromised low-privilege
      // account) pull the ENTIRE staff directory — displayName, email, phone,
      // employeeId, role, departments — with one unfiltered
      // db.collection('users').get(). The "partners only see partners" filter
      // was pure client-side JS (renderTeamTab, js/screens/people.js; and
      // dmCandidates, js/chat.js), i.e. applied AFTER the full snapshot had
      // already been delivered to the partner's machine. This is the only
      // collection in the file that had no partner scoping at all.
      //
      // Split the two operations rather than locking partners out wholesale:
      //  • get  stays open to every signed-in user. Single-doc uid→name/photo
      //    resolution is everywhere the partner legitimately works — the chat
      //    DM header (js/chat.js), task assignees/creators, approval actors,
      //    post authors — and the caller must already hold the uid, so there
      //    is no enumeration. Also, no rule anywhere depends on this: getRole()
      //    uses a rules-side get(), which bypasses rules entirely.
      //  • list is where enumeration lives, so that is what a partner loses.
      //    A partner may run ONLY a query whose role filter Firestore can
      //    prove is confined to what their two directory screens actually
      //    need: other partners (the Team tab) plus president/manager (the
      //    "New Message" picker's candidate set — js/chat.js dmCandidates,
      //    Decision 3). Internal staff keep the unfiltered list unchanged.
      //
      // Firestore evaluates a `list` rule against the QUERY, not per document
      // ("rules are not filters"), so the client MUST send the matching
      // filter — js/config.js fetchUsersWithPayroll() now emits
      // .where('role','in',['partner','president','manager']) when the caller
      // is a partner, and every partner-reachable directory read funnels
      // through it (dbCachedGet force-substitutes it for the 'users' key).
      // Verified against the emulator: that query AND a plain
      // where('role','==','partner') both prove against this rule, while an
      // unfiltered list and a where('role','==','employee') are denied.
      // .get('role','') — a legacy user doc with no role field must deny the
      // partner branch, not ERROR the rule (an erroring rule denies for
      // everyone, incl. the internal staff who share this block).
      allow get:  if isAuth();
      allow list: if isAuth() && ( !isPartner()
        || resource.data.get('role', '') in ['partner', 'president', 'manager'] );
      // Self-signup must not self-assign into a privileged department:
      // Finance/Design membership grants dept-scoped write access via
      // isFinanceDept()/isDesignDept() (and Storage claims via syncUserClaims).
      // v14 re-audit fix — hoisted out of the isOwner branch so the isAdmin
      // (secretary) branch below can reuse the SAME check and the two can
      // never drift apart.
      // 'Ventures' joins Finance/Design (2026-08-08). Without it, the self-create
      // branch below (isOwner && role=='employee' && noPrivilegedDeptOnCreate)
      // lets a user set their OWN departments to ['Ventures'] at doc-CREATE
      // time, which satisfies canDept('Ventures') and unlocks the whole
      // portfolio. Self-UPDATE cannot do this — departments are frozen by
      // userPrivilegedFieldsUnchanged — so the window is create-only, and both
      // account-creation paths are admin-driven; but Email/Password signup is
      // enabled with a public apiKey, and the Cloud Function that writes the
      // default doc is an async trigger a racing client write can beat.
      // Ventures is the first collection where restricted visibility was an
      // explicit owner decision, so the rationale for freezing Finance/Design
      // now applies to it too.
      function noPrivilegedDeptOnCreate() {
        return request.resource.data.get('department', '') != 'Finance'
            && request.resource.data.get('department', '') != 'Design'
            && request.resource.data.get('department', '') != 'Ventures'
            && request.resource.data.get('department', '') != 'IT'
            // 'IT' added 2026-08-09 with the secretary carve-out. Finance was
            // frozen but IT was not, so the isAdmin() create branch let a
            // secretary mint a users doc carrying departments:['IT'] plus
            // email + pendingPasswordSetup (both settable at CREATE, since the
            // identity-binding guard is update-only), then claim it by
            // registering at that address — arriving as an IT-department
            // employee and satisfying canIt(). Freezing the department closes
            // the only asymmetry between the Finance half and the IT half.
            && !request.resource.data.get('departments', []).hasAny(['Finance','Design','Ventures','IT']);
      }
      // Self-signup creates its own doc as 'employee'; admins create staff/worker docs.
      // v12 WS19: only isSeniorAdmin() (president/manager) may mint a manager/
      // president/secretary account — a secretary/other isAdmin() account may
      // still onboard ordinary staff (employee/agent/finance-department hires).
      //
      // v14 re-audit fix #1 — this rule is the CREATE twin of the update rule
      // below and had drifted badly out of sync with it. The update rule was
      // hardened with `request.resource.data.get('role','employee') !=
      // 'president'`; create had NO constraint on the minted role at all under
      // isSeniorAdmin(), so a manager could not PROMOTE anyone to president but
      // could freely MINT a brand-new president account (Invite Team Member,
      // js/screens/people.js; Create Worker Account, js/screens/dashboards.js —
      // both role pickers render window.ROLES unfiltered) and then sign into
      // it. President is the top of the hierarchy — settings/{docId} force-
      // logout, finance_delete_requests approval, finance_periods close/reopen
      // and the periodOpenFor() bypass, and ~40 `allow delete` rules all key
      // off it — so the whole "finance deletes route to the President" control
      // collapses if the tier is forgeable. Split president out unconditionally
      // (nothing above it to escalate to) and mirror the update rule's guard,
      // plus a role ENUM so an unknown/typo role string can't be minted either.
      //
      // v14 re-audit fix #2 — the non-senior isAdmin() branch (which includes
      // 'secretary', see isAdmin() at the top of this file) allowlisted
      // role:'finance' and applied NO department check, so a Corporate
      // Secretary could create an account they control carrying role:'finance'
      // and/or departments:['Finance'] and hand themselves the money tier:
      // isMoneyAdmin()/isFinanceDept()→canFinance() are the sole gate on
      // payroll, salary_history, salary_raises, pay_runs, cash_advances
      // approval, ledger and all three journals. That is precisely the tier
      // WS19 spent this whole file taking AWAY from secretary. The onboarding
      // capability the comment above describes is preserved — a secretary may
      // still create ordinary employee/agent staff — it just can no longer
      // mint the money role or Finance/Design membership. The only creation
      // path a secretary actually drives in the UI, signupApprove
      // (js/svc-approvals.js), hardcodes role:'employee' + departments:[] and
      // is unaffected; "+ Invite Member" and "Create Worker Account" are
      // already president/manager-gated, i.e. isSeniorAdmin(), and keep full
      // power. Design is frozen alongside Finance for the same reason the
      // self-signup branch already froze it.
      allow create: if isAuth() && (
        isPresident() || (
          isSeniorAdmin()
          && request.resource.data.get('role', 'employee') != 'president'
          && request.resource.data.get('role', 'employee') in
               ['manager', 'secretary', 'employee', 'agent', 'finance', 'partner']
        ) || (
          isAdmin()
          && request.resource.data.get('role', 'employee') in ['employee', 'agent']
          && noPrivilegedDeptOnCreate()
        ) || (
          isOwner(uid)
          && request.resource.data.role == 'employee'
          && noPrivilegedDeptOnCreate()
        )
      );
      // Owner-first short-circuit: routine self-updates (name/photo/phone/lastSeen)
      // need no role lookup. Privileged fields (role/dept/pay/employeeId/username)
      // are frozen unless a SENIOR admin makes the change — v12 WS19 closes a live
      // self-escalation gap where any isAdmin() (incl. secretary) could write
      // role:'president' onto any user doc with zero field restriction. Secretary/
      // other non-senior admins may still edit a user's non-privileged fields
      // (name/photo/phone) for HR-adjacent oversight, just not the privileged ones.
      //
      // v14 re-audit fix — the isSeniorAdmin() branch below used to have NO owner
      // restriction and NO privileged-fields check at all: a manager could write
      // role:'president' onto their OWN doc in one direct write (the WS19 comment
      // above only closed the hole for secretary/other isAdmin(), not for
      // isSeniorAdmin() itself). Split president out unconditionally (top of the
      // hierarchy — nothing to escalate to); a manager acting under isSeniorAdmin()
      // may now only touch ANOTHER user's doc (never their own — self-edits fall
      // through to the owner branch below, which freezes privileged fields for
      // everyone incl. managers), and may never mint role:'president' (only the
      // President can promote to president).
      //
      // fcmTokenUnchangedForOthers(): fcmToken is deliberately NOT in
      // userPrivilegedFieldsUnchanged() so the OWNER can always freely (re)register
      // their own device's push token on login/token-refresh. But a NON-OWNER
      // admin editing someone ELSE's doc must never be able to plant their own
      // device's token there — that would silently redirect the target's payroll/
      // DM/deadline push notifications to the admin's device. Combined with
      // finding #1's fix (manager can't touch its own doc under isSeniorAdmin()),
      // and #2 (hrManagedAccount) below, this closes the three related
      // account-hijack paths this update rule used to allow.
      function fcmTokenUnchangedForOthers() {
        return request.resource.data.get('fcmToken', null) == resource.data.get('fcmToken', null);
      }
      // hrManagedAccount is never legitimately updated (only set at create) —
      // see userPrivilegedFieldsUnchanged()'s comment. isSeniorAdmin() doesn't
      // call that helper (it's allowed to change OTHER privileged fields like
      // department/salary as part of ordinary HR duties), so it needs this
      // one field frozen explicitly.
      function hrFlagUnchanged() {
        return request.resource.data.get('hrManagedAccount', null) == resource.data.get('hrManagedAccount', null);
      }
      // v14 offboarding — an HR-dept member of any role may toggle ONLY the
      // removed/reinstated fields on ANOTHER user's doc (matches people.js's
      // Remove/Reinstate UI gate); restricted to those 5 keys, never president.
      function onlyOffboardingFieldsChanged() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['removed','removedAt','removedBy','reinstatedAt','reinstatedBy']);
      }
      // v14 re-audit ROUND 2 — the isSeniorAdmin() branch does NOT call
      // userPrivilegedFieldsUnchanged() (a manager legitimately changes role /
      // department / salary as ordinary HR duty), so freezing the identity
      // binding inside that helper does not reach this branch. Without the
      // explicit call below, a MANAGER could still flip
      // {email, pendingPasswordSetup} onto any non-president doc (a role:
      // 'finance' one, say) and launder it through createUserDocOnAuthCreate —
      // exactly the harm F65 was written to stop. Same field pair, same
      // rationale; no legitimate manager-driven write touches either field.
      // ⚠ v14 re-audit ROUND 3 — ONE-WRITE OWNER LOCKOUT (pre-existing at HEAD).
      // The senior branch tested only the POST-write role. It never looked at
      // resource.data, so a MANAGER could run
      //     users/<PRESIDENT_UID>.update({ role:'employee' })
      // and it was ALLOWED (measured on the emulator). Afterwards nobody is
      // president and nobody can ever become one again: this branch's
      // !isOwner(uid) blocks self-promotion, its != 'president' blocks
      // promoting anyone else, and the create rule's senior branch excludes
      // 'president' by both a != and an enum. Measured immediately after that
      // single write, ELEVEN president-only operations were unsatisfiable by
      // every actor in the tenant — finance_delete_requests update/delete,
      // finance_periods create/update (so a closed month can NEVER be
      // reopened), the settings force-logout kill switch, periodOpenFor()'s
      // president bypass, and every `allow delete: if isPresident()`. The
      // manager can then call setUserDisabled, whose
      // `if (targetRole === 'president')` guard (functions/index.js) now reads
      // 'employee', and disable the owner's Auth account. Recovery needs the
      // Firebase console, not the app.
      //
      // The HR branch two lines below already carried the correct half
      // (resource.data.get('role','employee') != 'president'), so this was an
      // asymmetry, not a design decision.
      //
      // COST, measured: this conjunct fires ONLY when the TARGET doc is
      // currently a president. A manager's writes to every non-president user
      // are untouched (14/14 probed operations unchanged — role changes to
      // manager/finance/secretary/agent, salary, department, employeeId,
      // offboarding, Edit Employee, HR merge-set, account creation, read).
      // On a president's doc the manager loses exactly the three demotions
      // (-> employee / manager / finance) and nothing else: every OTHER
      // privileged edit to a president was ALREADY denied, because keeping
      // role=='president' fails this branch's request-side != and then falls
      // through to (isAdmin() && userPrivilegedFieldsUnchanged()). Renaming a
      // president, setting their phone/photo and reading their doc still work
      // via that same isAdmin() branch. Presidents keep full power over each
      // other, so a real handover (promote successor -> successor demotes the
      // outgoing president) still works with no console access.
      allow update: if isAuth() && (
        isPresident() ||
        (isSeniorAdmin() && !isOwner(uid)
          && resource.data.get('role', 'employee') != 'president'
          && request.resource.data.get('role', 'employee') != 'president'
          && fcmTokenUnchangedForOthers()
          && hrFlagUnchanged()
          && userIdentityBindingUnchanged()) ||
        (isOwner(uid) && userPrivilegedFieldsUnchanged()) ||
        (isAdmin() && userPrivilegedFieldsUnchanged() && fcmTokenUnchangedForOthers()) ||
        (inDept('HR') && !isOwner(uid)
          && resource.data.get('role', 'employee') != 'president'
          && onlyOffboardingFieldsChanged())
      );
      allow delete: if isAuth() && isPresident();
    }

    // ── Username → email lookup (v12 WS19) ─────────────
    // Worker login is by username; the client must resolve a username to an
    // email BEFORE calling signInWithEmailAndPassword — i.e. while
    // request.auth is still null. /users read requires isAuth(), so that
    // pre-auth query was always denied (worker username login was broken).
    // Fix: a narrow public single-doc GET (mirrors the order_tracking public-
    // get precedent) — no enumeration (list:false), no other user data exposed.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAuth() && isAdmin();
    }

    // ── Sequence counters (employees, workers, etc.) ────
    // Widened from admin-only to the ops/finance tier (WS27) so HR/finance can
    // mint BI-W-### worker IDs. Safe: docs here are opaque monotonic integers
    // — the worst a finance user can do is advance a sequence number.
    // Widened again (WS28) so Production can mint DR-serials via nextSerial().
    // Safe per the WS27 rationale: docs here are opaque monotonic integers —
    // the worst any internal user can do is advance a sequence number.
    match /_counters/{docId} {
      allow read:  if isAuth();
      // v14 re-audit fix — monotonic-only: the new count may never go
      // backward. Every real writer (nextCounterId et al., generalized in
      // js/departments.js) always sets count to strictly base+1, so this
      // never blocks a legitimate mint — it only blocks resetting a sequence
      // to 0/an arbitrary lower value, which would let the next-minted
      // employeeId/serial collide with an existing one.
      // (request.resource is null on a delete — guard that first so a delete
      // doesn't crash on request.resource.data and error-deny; nothing in the
      // app deletes a counter doc today, so this matches prior behavior there.)
      allow write: if isAuth() && !isPartner()
        && (request.resource == null || (
          isNonNegNumber(request.resource.data.get('count', 0))
          && (resource == null || request.resource.data.get('count', 0) >= resource.data.get('count', 0))
        ));
    }

    // ── Posts ──────────────────────────────────────────
    // v12 WS19: read locked to !isPartner() — internal company feed, was bare
    // isAuth() (the audit separately flagged that published-post NOTIFICATIONS
    // also fan out to partners; that's a different, notification-side fix).
    match /posts/{postId} {
      // Internal feed stays !isPartner()-only, EXCEPT posts deliberately targeted
      // at the Partners dept once published — the partner Posts tab lists exactly
      // where('dept','==','Partners').where('status','==','published'), whose
      // equality filters statically match this predicate so the list() is
      // provable and succeeds (a bare !isPartner() rule made that query throw
      // 'Missing or insufficient permissions' and blanked the partner feed). Uses
      // .get(...,'') so a post missing dept/status denies for partners rather than
      // erroring the rule. General/other-dept posts remain fully internal.
      allow read: if isAuth() && ( !isPartner()
        || (resource.data.get('dept','') == 'Partners' && resource.data.get('status','') == 'published') );
      // v13 Phase 22: enforce the publish/approval model server-side — matches
      // modules.js openNewPostModal (authorId is the real field name; only the
      // president gets publishDirectly, everyone else always lands 'pending').
      allow create: if isAuth() && !isPartner() &&
        request.resource.data.get('authorId', '') == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'title','content','dept','status','authorId','authorName','authorPhoto',
          'pinned','imageUrl','fileName','fileUrl','createdAt'
        ]) &&
        (isPresident()
          ? request.resource.data.get('status', '') in ['published', 'pending']
          : request.resource.data.get('status', '') == 'pending');
      // Author/admin may edit anything, EXCEPT the publish/reject status
      // transition — decision D10 (modules.js:45 canApprove is president/manager
      // only, secretary does NOT approve posts) is now mirrored server-side via
      // isSeniorAdmin() instead of isAdmin() whenever `status` is in the diff.
      // Anyone may toggle their OWN heart — scoped like the chat reactions
      // pattern (~line 396) so a caller can only add/remove their own uid.
      allow update: if isAuth() && (
        resource.data.authorId == request.auth.uid
        || (isSeniorAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']))
        || (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']))
        || ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hearts'])
             && request.resource.data.get('hearts', []).removeAll(resource.data.get('hearts', [])).hasOnly([request.auth.uid])
             && resource.data.get('hearts', []).removeAll(request.resource.data.get('hearts', [])).hasOnly([request.auth.uid]) )
      );
      allow delete: if isAuth() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // ── Notifications — anyone signed in can deliver a notification
    // into another user's inbox (Notifs.send/sendToDept/sendToAll/sendToOwner
    // all write cross-user by design); only the inbox owner can read it or
    // mark it read/unread.
    match /notifications/{uid}/{document=**} {
      allow read, update, delete: if isAuth() && isOwner(uid);
      // Cross-user create stays open (broadcast helpers deliver into other inboxes
      // by design), but the payload is constrained so an inbox can't be used to
      // forge arbitrary docs or spam giant push notifications:
      //  • only the fields the app actually writes (Notifs.send/sendTo*),
      //  • must start UNREAD with a server timestamp (no backdating / pre-read),
      //  • title/body length-capped so a sender can't blast oversized pushes.
      allow create: if isAuth()
        // PAYSLIP-OVERHAUL-SPEC.md §5 — `month` (YYYY-MM) lets a payroll
        // disburse notification deep-link straight to that month's payslip
        // (js/notifications.js send()/_navigateFromNotif). Every other
        // existing Notifs.send*() call site never sets it, so this is purely
        // additive — an old client (or one that never passes month) still
        // satisfies hasOnly() unchanged.
        && request.resource.data.keys().hasOnly(['title','body','icon','type','link','read','createdAt','dedupKey','taskId','chatId','senderUid','month'])
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && isBoundedString(request.resource.data.get('title', ''), 200)
        && isBoundedString(request.resource.data.get('body', ''), 2000)
        // v14 re-audit fix — every OTHER field here used to be unbounded, so a
        // caller could forge a giant type/link/icon (or the dedup/thread keys)
        // to inflate every recipient's inbox doc / phish via a misleading link.
        // link/icon/type are written by every real call site (js/notifications.js
        // send()) even when "empty" — link legitimately can be `null` (its
        // default), so it's checked null-OR-bounded-string rather than always a
        // string like the others below.
        && isBoundedString(request.resource.data.get('icon', ''), 32)
        && isBoundedString(request.resource.data.get('type', ''), 64)
        && (request.resource.data.get('link', null) == null
            || isBoundedString(request.resource.data.get('link', ''), 300))
        && isBoundedString(request.resource.data.get('dedupKey', ''), 300)
        && isBoundedString(request.resource.data.get('taskId', ''), 200)
        && isBoundedString(request.resource.data.get('chatId', ''), 200)
        && isBoundedString(request.resource.data.get('month', ''), 7)
        // Phase 68 quota observer (functions/index.js sendNotificationQuota) keys off
        // senderUid — optional (system/scheduled sends omit it), but when present it
        // must be truthful: a caller can't attribute a notif to another sender.
        && (!request.resource.data.keys().hasAny(['senderUid'])
            || request.resource.data.get('senderUid', '') == request.auth.uid);
    }

    // ── Attendance ─────────────────────────────────────
    // v12 WS19: split from a single `{document=**}` wildcard (plain isOwner(uid),
    // no field constraints at all) into a per-doc records/{date} block, because
    // the client itself writes attendanceScore directly with no server
    // validation — an employee could set attendanceScore:1.0 for any date via
    // devtools, and payroll/EOM read that score directly. `records` is the only
    // subcollection under attendance/{uid} today (verified).
    match /attendance/{uid} {
      allow read: if isAuth() && (isOwner(uid) || isOpsAdmin());
    }
    match /attendance/{uid}/records/{date} {
      allow read: if isAuth() && (isOwner(uid) || isOpsAdmin());
      // Admins: unrestricted (the Present/Half/Absent edit path, stamps editedBy).
      allow write: if isAuth() && isOpsAdmin();
      // Owner self check-in / notification-driven auto-upgrade: score capped to
      // the set an honest client ever produces, and can never overwrite a doc an
      // admin has already hand-edited (protects a Present/Half/Absent correction
      // from being silently reverted by the owner's own next check-in write).
      // A full server-side date-bound (today/yesterday only) would need a Cloud
      // Function — request.time has no clean date-string formatter in rules —
      // deferred; these two checks already close the two exploitable vectors
      // (arbitrary score, overwriting an admin edit). Client call sites need no
      // change — they already write scores in {0.5,1.0} and the admin path
      // already stamps editedBy.
      allow create, update: if isAuth() && isOwner(uid)
        && request.resource.data.get('attendanceScore', 0) in [0, 0.5, 1.0]
        && (resource == null || resource.data.get('editedBy', null) == null);
    }

    // ── Worker kiosk attendance (WS26) ──────────────────
    // Factory worker_profiles staff have no Firebase Auth yet, so there is no
    // owner clause — every record is HR-kiosk-written. When WS27/WS20's
    // worker_profiles.linkedUid lands, an additive owner-read clause can be
    // added here without re-keying (workerId already == the worker_profiles docId).
    // v14 Type-B self-service — the additive owner clause this block's old
    // comment anticipated: workerId == worker_profiles docId, ownership via
    // that profile's linkedUid.
    // v14 re-audit fix — also require the linked profile to be active. Before
    // this, toggling a worker_profiles doc's Status to 'inactive' (HR's only
    // offboarding affordance in hr.js) had ZERO effect on the linked account's
    // ability to keep timing in/out — nothing here ever read `status`. Reusing
    // the same get() call this function already makes (no extra read cost).
    function isLinkedWorkerUid(workerId) {
      let p = get(/databases/$(database)/documents/worker_profiles/$(workerId)).data;
      return p.get('linkedUid','') == request.auth.uid && p.get('status', 'active') != 'inactive';
    }
    // v14 re-audit fix — status-FREE sibling of isLinkedWorkerUid() above, for
    // ownership checks that must survive offboarding. Setting a worker_profiles
    // doc's Status to 'inactive' has to stop the worker PUNCHING (that is what
    // isLinkedWorkerUid enforces) but must never retroactively hide the pay
    // records they already earned — a worker keeps access to their own issued
    // payslips.
    // Unlike isLinkedWorkerUid (whose workerId comes from the doc PATH and so
    // always exists), callers here pass a value read off the document being
    // checked, so it may be '' or point at a since-deleted profile. A get() on
    // a missing path ERRORS, and an erroring rule DENIES — hence the explicit
    // != '' and exists() guards before the get().
    function isLinkedWorkerProfile(workerId) {
      return workerId != ''
        && exists(/databases/$(database)/documents/worker_profiles/$(workerId))
        && get(/databases/$(database)/documents/worker_profiles/$(workerId)).data.get('linkedUid','') == request.auth.uid;
    }
    match /attendance_worker/{workerId} {
      allow read: if isAuth() && (isOpsAdmin() || isLinkedWorkerUid(workerId));
    }
    match /attendance_worker/{workerId}/records/{date} {
      allow read: if isAuth() && (isOpsAdmin() || isLinkedWorkerUid(workerId));
      // v14 re-audit hardening (self-service write only — isOpsAdmin()
      // stays unrestricted for the HR/kiosk admin path):
      //  • date field (when present) must match the docId — stops a
      //    field/docId mismatch from confusing anything that trusts the field.
      //  • hoursWorked is bounded to a sane single-day range instead of any
      //    number a devtools write could set (e.g. 99).
      //  • a self-service write may never clobber an EXISTING record that
      //    wasn't originally recorded by this same worker — both the HR-kiosk
      //    path (openWorkerKioskModal, hr.js) and the self-service path stamp
      //    `recordedBy`, so this blocks a worker from silently overwriting an
      //    HR-entered day with their own later self-report.
      // A full today-only date bound would need a Cloud Function (request.time
      // has no clean date-string formatter in rules) — deferred, same
      // limitation already accepted for attendance/{uid}/records above.
      allow write: if isAuth() && (isOpsAdmin() || (
        isLinkedWorkerUid(workerId)
        && request.resource.data.workerId == workerId
        && request.resource.data.get('date', date) == date
        && request.resource.data.get('recordedBy', request.auth.uid) == request.auth.uid
        // v14 P0 pay-integrity (re-audit fix) — a self-service client may write
        // ONLY the pre-punch audit trail (attempts) + an advisory pendingPunch
        // marker. timeIn/timeOut/hoursWorked/inValid/outValid AND every provenance
        // field (serverVerified, needsReview, in/outAccuracyM/DistanceM/SelfieUrl,
        // in/outAt) are FUNCTION-ONLY — written exclusively by recordAttendancePunch
        // (Admin SDK, bypasses these rules) after it re-verifies geofence + selfie.
        // Uses diff().affectedKeys() on UPDATES (not keys() over the whole
        // post-write doc) so a pendingPunch/attempts merge onto a doc the function
        // already stamped isn't wrongly denied — the old keys().hasAny() silently
        // blocked EVERY Time-Out advisory write. A strict hasOnly allowlist (vs the
        // old 5-field blocklist) also stops a worker forging serverVerified/needsReview.
        && (
          resource == null
            ? request.resource.data.keys().hasOnly(['workerId', 'date', 'recordedBy', 'attempts', 'pendingPunch'])
            : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workerId', 'date', 'recordedBy', 'attempts', 'pendingPunch'])
        )
        && (resource == null || resource.data.get('recordedBy', '') == request.auth.uid)
      ));
    }

    // ── Geofence work sites (v14 Type-B) ───────────────
    match /geo_sites/{docId} {
      allow read: if isAuth() && !isPartner();
      allow create, update: if isAuth() && isOpsAdmin();
      allow delete: if isAuth() && isPresident();
    }

    // ── Attendance extension requests ──────────────────
    match /attendance_extensions/{docId} {
      // Internal HR data — external Brilliant Steel partners excluded from reading.
      // getRole() is null-safe: null (no/missing role) is treated as "not partner"
      // so internal users with incomplete profiles are never wrongly locked out;
      // only a positively-identified 'partner' is denied.
      allow read: if isAuth() && !isPartner();
      // v14 re-audit fix — was a bare isAuth() with NO field constraints and no
      // partner exclusion at all (every sibling request collection —
      // leave_requests, cash_advances, approval_requests — pins ownership,
      // status, and shape). The sole real write site (js/screens/dashboards.js,
      // docId `${uid}_${todayStr}`) always self-files as {uid, userName, date,
      // status:'pending', requestedAt}; finance/admin filing on someone's
      // behalf is additionally allowed to match the pattern used elsewhere.
      allow create: if isAuth() && !isPartner() && (
        isOpsAdmin() ||
        (request.resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.get('status', '') == 'pending')
      ) && request.resource.data.keys().hasOnly(['uid','userName','date','status','requestedAt'])
        && isBoundedString(request.resource.data.get('userName', ''), 200)
        && isBoundedString(request.resource.data.get('date', ''), 20);
      allow update, delete: if isAuth() && isAdmin();
    }

    // ── Cash advances ──────────────────────────────────
    // ⚠ OWNER RULING 1 (2026-08-08) — MONEY REQUESTS STAY VISIBLE, READ-ONLY.
    // The Corporate Secretary keeps SEEING cash advances in Approvals so they can
    // flag them to the President; that escalation workflow already exists
    // (APPROVAL_CAPS + "Request President approval", js/screens/approvals.js).
    // They may not create, approve or fund one — those stay isMoneyAdmin() below.
    // This also avoids the silent-zero failure: every Approvals count query ends
    // in `.catch(() => ({size:0}))`, so a DENIED query renders as "0 pending",
    // indistinguishable from "nothing needs attention".
    match /cash_advances/{docId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || isMoneyAdmin() || isSecretary()
      );
      // Employees may only file their OWN request, pending and unfunded.
      // Money-tier (president/manager/finance) may record/approve any (e.g.
      // president-entered advances) — v12 WS19: narrowed from the ops/finance tier
      // to isMoneyAdmin() so 'secretary' can no longer approve a cash advance via
      // a direct write (the UI already hides this button from secretary; the
      // rule now matches).
      // v14 re-audit fix — amount was never validated at all (only
      // userId/status/balance were); a negative/absurd amount could reach
      // downstream payroll-deduction math (CashAdvance.planFor) which assumes
      // a sane positive balance.
      allow create: if isAuth() && isNonNegNumber(request.resource.data.get('amount', 0)) && (
        isMoneyAdmin() ||
        (request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.balance == 0)
      );
      // Only money-tier can approve or change the money. Owners may edit
      // non-financial details (e.g. reason) but never status/balance/amount.
      allow update: if isAuth() && (
        isMoneyAdmin() ||
        (resource.data.userId == request.auth.uid
          && request.resource.data.status  == resource.data.status
          && request.resource.data.balance == resource.data.balance
          && request.resource.data.amount  == resource.data.amount)
      );
      allow delete: if isAuth() && isPresident();
    }

    // ── Tasks ──────────────────────────────────────────
    match /tasks/{taskId} {
      // v12 WS19: was bare isAuth() — a partner could browse EVERY internal task
      // across every department. BUT a partner's dashboard has a real, shipped
      // "My Tasks" feature (assignedTo array-contains) + an "All Tasks" link into
      // the same tasks page (js/app.js ~2099, openTaskDetail is shared code) —
      // a blanket !isPartner() lock would blank-screen that. Fix: partner may
      // read only tasks they're assigned to; full read stays for internal staff.
      allow read: if isAuth() && (!isPartner() || request.auth.uid in resource.data.get('assignedTo', []));
      // Admins create any task. Design-dept members may create Design tasks only
      // (so designers can delegate project work) — scoped strictly to department=='Design'.
      allow create: if isAuth() && (
        isAdmin() || (isDesignDept() && request.resource.data.get('department', '') == 'Design')
      );
      // Assignees update their own tasks; admins AND finance manage any task
      // (status, reassignment, follow-up requests). Uses isOpsAdmin() so the
      // client's task controls — which treat finance as an editor — actually land
      // (finance is the books/ops editor: "finance can edit everything").
      // ⚠ 2026-08-09 — this is the ONLY non-assignee update clause on /tasks:
      // there is no isAdmin() fallback beside it. It is therefore one of the two
      // sites (with leave_requests update) that made "just drop secretary from
      // the old 4-role helper" a role-deleting change rather than a scoping one.
      // It stays on the FULL old set. Do not narrow it without adding a fallback.
      // v14 re-audit ROUND 2 — .get('assignedTo', []) to match the read rule 10
      // lines up. Behaviourally identical (measured): a task with no
      // assignedTo field made the direct read ERROR, and CEL absorbs that error
      // whenever the isOpsAdmin() disjunct is true, so finance/admin were
      // never actually blocked and a non-assignee was denied either way. Made
      // consistent so the two rules cannot be read as disagreeing about whether
      // the field is optional.
      allow update: if isAuth() && (
        (request.auth.uid in resource.data.get('assignedTo', [])) || isOpsAdmin()
      );
      // Admins delete any task; a creator may delete the task they made (the UI
      // already offers it to the creator, so this stops a silent permission fail).
      allow delete: if isAuth() && (isAdmin() || resource.data.get('createdBy', '') == request.auth.uid);

      // In-app "messaging" thread on a task. Rules do NOT inherit to
      // subcollections, so this needs explicit coverage — tasks are readable
      // by all signed-in users, so their messages are too. Author owns their
      // own message; admins can moderate.
      // v12 WS19: same own-task scoping as the parent — a partner assigned to
      // THIS task can still read/use its comment thread (openTaskDetail is
      // shared code with the partner dashboard); a partner NOT assigned cannot.
      function taskAssignee() {
        return request.auth.uid in get(/databases/$(database)/documents/tasks/$(taskId)).data.get('assignedTo', []);
      }
      match /comments/{commentId} {
        allow read:   if isAuth() && (!isPartner() || taskAssignee());
        allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAuth() && (
          resource.data.authorId == request.auth.uid || isAdmin()
        );
      }
      // Read receipts ("Seen by"). Each user writes only their own receipt.
      match /readers/{readerUid} {
        allow read:  if isAuth() && (!isPartner() || taskAssignee());
        allow write: if isAuth() && isOwner(readerUid);
      }
    }

    // ── Team Chat (v12 WS37) — conversations + messages/readers/typing ──
    // One collection, three types: 'dm' | 'group' | 'dept'.
    //  • dm/group: membership = the participants array. A partner may read/write
    //    ONLY conversations they're a participant of (conditional wall, same
    //    semantics as tasks/comments) — and unlike tasks, internal staff are
    //    participant-scoped too (nobody reads a DM they're not in).
    //  • dept: membership derived live via isAdmin() || inDept(department);
    //    partners NEVER pass this branch. participants stays [] on dept docs.
    // Rules do NOT cascade — messages/readers/typing each get an explicit match.
    match /conversations/{convId} {
      // Membership vs THIS doc (parent reads/updates — no extra get()).
      function memberOfDoc() {
        return (request.auth.uid in resource.data.get('participants', []))
          || (resource.data.get('type','') == 'dept' && !isPartner()
              && deptChannelOpen(resource.data.get('department',''))
              && (isAdmin() || inDept(resource.data.get('department',''))));
      }
      // Membership via re-read, for subcollections (mirrors taskAssignee()).
      function convMember() {
        let c = get(/databases/$(database)/documents/conversations/$(convId)).data;
        return (request.auth.uid in c.get('participants', []))
          || (c.get('type','') == 'dept' && !isPartner()
              && deptChannelOpen(c.get('department',''))
              && (isAdmin() || inDept(c.get('department',''))));
      }

      // get: any member. list: the inbox query is participants array-contains,
      // provable from the first disjunct; dept docs are fetched by direct get.
      allow read: if isAuth() && memberOfDoc();

      // dm/group: creator must include themself. dept: lazy-create by any member;
      // the doc ID must be exactly 'dept_<department>' and participants must be [].
      allow create: if isAuth() && (
        ( request.resource.data.get('type','') in ['dm','group','announcement']
          && request.resource.data.get('createdBy','') == request.auth.uid
          && request.auth.uid in request.resource.data.get('participants', []) )
        ||
        ( request.resource.data.get('type','') == 'dept' && !isPartner()
          && deptChannelOpen(request.resource.data.get('department',''))
          && (isAdmin() || inDept(request.resource.data.get('department','')))
          && convId == 'dept_' + request.resource.data.get('department','')
          && request.resource.data.get('participants', []).size() == 0 )
      );

      // Any member may bump ONLY the lastMessage* preview fields (the second
      // write of every send), or set the thread wallpaper (a thread-wide
      // setting the chat UI writes for every participant — previously only
      // creator/admin could, so a member's pick failed silently and reverted).
      // Creator/admin manage the doc (rename, members).
      // A participant may remove exactly themself ("leave group").
      allow update: if isAuth() && (
        // v14 wave5: the send's preview bump may now also carry the sender's
        // own key in the denormalized reads map (J9) — and a bare read-marker
        // update touches reads alone. Both fenced to the caller's own uid.
        //
        // v14 Wave1 P1 fix #5 — a bare affectedKeys() check let ANY member
        // set lastMessageBy/lastMessageAt/lastMessageText to ANY value at
        // all (inbox-preview forgery — only WHICH fields changed was ever
        // checked, never their actual values). A genuine preview bump must
        // now carry the CALLER's own uid as lastMessageBy and the server
        // clock as lastMessageAt. The one other shape this disjunct still
        // allows: a lastMessageText-ONLY rewrite (the unsend tombstone note,
        // or a same-author edit refresh — chat.js's _onDeleteMessage/
        // _onHardDeleteMessage/_onEditMessage), gated to whoever is ALREADY
        // attributed as lastMessageBy (unchanged by this write) or an admin
        // — never an unrelated member.
        ( memberOfDoc() && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessageAt','lastMessageText','lastMessageBy','lastMessageByName','reads'])
          && (
               ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reads'])
                 && request.resource.data.get('reads', {})
                      .diff(resource.data.get('reads', {})).affectedKeys()
                      .hasOnly([request.auth.uid]) )
            || ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageText'])
                 && (resource.data.get('lastMessageBy','') == request.auth.uid || isAdmin()) )
            || ( request.resource.data.get('lastMessageBy','') == request.auth.uid
                 && request.resource.data.lastMessageAt == request.time
                 && ( !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reads'])
                      || request.resource.data.get('reads', {})
                           .diff(resource.data.get('reads', {})).affectedKeys()
                           .hasOnly([request.auth.uid]) ) )
             ) )
        || ( memberOfDoc() && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['wallpaper']) )
        // v14 wave5 (J7): per-user pin/mute/archive — a member may toggle ONLY
        // their own key inside these maps, nothing else in the same write.
        || ( memberOfDoc()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['pinnedBy','mutedBy','archivedBy'])
          && request.resource.data.get('pinnedBy', {})
              .diff(resource.data.get('pinnedBy', {})).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.get('mutedBy', {})
              .diff(resource.data.get('mutedBy', {})).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.get('archivedBy', {})
              .diff(resource.data.get('archivedBy', {})).affectedKeys().hasOnly([request.auth.uid]) )
        // v14 Wave1 P0 fix #4 — the creator/admin branch used to be a blanket
        // allow-any-field-any-value disjunct (`|| createdBy==uid || isAdmin()`
        // with no shape restriction at all): a group creator/admin could
        // tamper with ANOTHER member's own reads/pinnedBy/mutedBy/archivedBy
        // entry (e.g. silently mark a message read on someone else's behalf,
        // or unmute/unpin a conversation for them). Fenced to only the
        // fields group management actually needs; reads/pinnedBy/mutedBy/
        // archivedBy for EVERY caller — INCLUDING the creator/admin
        // themself — now go exclusively through the own-uid-only branches
        // above.
        || ( (resource.data.get('createdBy','') == request.auth.uid || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name','photoUrl','participants','participantNames','wallpaper','pinnedMsgIds']) )
        || ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
             && request.resource.data.get('participants', [])
                == resource.data.get('participants', []).removeAll([request.auth.uid]) )
      );

      allow delete: if isAuth() && isPresident();   // records kept forever

      match /messages/{messageId} {
        allow read:   if isAuth() && convMember();
        allow create: if isAuth() && convMember()
          && request.resource.data.get('authorId','') == request.auth.uid
          // v14 Wave2 — an announcement channel is post-restricted to its creator
          // or an admin; everyone else is read-only (client hides the composer too).
          && ( get(/databases/$(database)/documents/conversations/$(convId)).data.get('type','') != 'announcement'
               || get(/databases/$(database)/documents/conversations/$(convId)).data.get('createdBy','') == request.auth.uid
               || isAdmin() );
        // Author edits own message; admin moderates; any member may toggle
        // their OWN key inside the reactions map — and nothing else.
        //
        // v14 Wave1 P1 fix #10 — the author/admin branches used to be a
        // blanket allow-any-field-any-value disjunct each: authorId/createdAt
        // could be reassigned after the fact, a tombstone (deleted:true)
        // could be silently un-set back to false (reversing an unsend), and
        // "admin moderation" extended to rewriting anyone's message TEXT
        // outright, not just tombstoning it. Author edits now keep
        // authorId/createdAt frozen, can never resurrect a tombstone, and
        // must stamp editedAt==now whenever the text field changes — except
        // the tombstone-CREATION transition itself (deleted false→true,
        // chat.js _onDeleteMessage's unsend, which clears text without an
        // edit stamp). Note this is narrower than merely "deleted is true
        // afterward": an ALREADY-tombstoned doc (deleted stays true) whose
        // text is touched again still requires editedAt — a live text swap
        // can't be smuggled into an already-removed doc that the renderer no
        // longer even displays the text field of. Admin moderation is
        // narrowed to ONLY setting the tombstone shape (deleted:true, text
        // cleared) — never an arbitrary text rewrite.
        allow update: if isAuth() && (
          ( resource.data.get('authorId','') == request.auth.uid
            && request.resource.data.get('authorId','') == resource.data.get('authorId','')
            && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
            && !(resource.data.get('deleted', false) == true
                 && request.resource.data.get('deleted', false) == false)
            && ( !request.resource.data.diff(resource.data).affectedKeys().hasAny(['text'])
                 || (resource.data.get('deleted', false) == false
                     && request.resource.data.get('deleted', false) == true)
                 || request.resource.data.get('editedAt', null) == request.time ) )
          || ( isAdmin()
               && request.resource.data.get('authorId','') == resource.data.get('authorId','')
               && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
               && request.resource.data.get('deleted', false) == true
               && request.resource.data.get('text','') == '' )
          || ( convMember()
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
               && request.resource.data.get('reactions', {})
                    .diff(resource.data.get('reactions', {})).affectedKeys()
                    .hasOnly([request.auth.uid]) )
        );
        allow delete: if isAuth()
          && (resource.data.get('authorId','') == request.auth.uid || isAdmin());
      }
      // Read receipts — per-viewer-writes-own-doc, verbatim tasks/readers shape
      // (+ convMember so a non-participant can't plant a receipt).
      match /readers/{readerUid} {
        allow read:  if isAuth() && convMember();
        allow write: if isAuth() && isOwner(readerUid) && convMember();
      }
      // Typing beacons — own doc only (write covers create/update/delete).
      match /typing/{typerUid} {
        allow read:  if isAuth() && convMember();
        allow write: if isAuth() && isOwner(typerUid) && convMember();
      }
    }

    // ── KPI evaluations ────────────────────────────────
    match /kpi_evals/{uid} {
      // The president's grade lives in the SAME doc as the employee's self-
      // assessment. The owner may write their self-assessment but must NOT be able
      // to forge/inflate the president's grade — freeze the president-* fields for
      // non-admins. Only finance/admin (and the president) may write them.
      function presFieldsUntouchedOnUpdate() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['presidentGrade','presidentNotes','presidentImprovements','presidentUpdatedAt','presidentGradeFromTasks','presidentScoreTaskCount']);
      }
      function presFieldsAbsentOnCreate() {
        return !request.resource.data.keys()
          .hasAny(['presidentGrade','presidentNotes','presidentImprovements','presidentUpdatedAt','presidentGradeFromTasks','presidentScoreTaskCount']);
      }
      // v12 WS19: create/update's admin branch narrowed to isSeniorAdmin() — the
      // isOwner branch is frozen by presFieldsAbsentOnCreate/UntouchedOnUpdate,
      // but the admin branch had NO such freeze, so 'secretary' could otherwise
      // write/forge presidentGrade directly. Only president/manager grade KPIs.
      allow read:   if isAuth() && (isOwner(uid) || isOpsAdmin());
      allow create: if isAuth() && (isSeniorAdmin() || (isOwner(uid) && presFieldsAbsentOnCreate()));
      allow update: if isAuth() && (isSeniorAdmin() || (isOwner(uid) && presFieldsUntouchedOnUpdate()));
      allow delete: if isAuth() && isOpsAdmin();
    }

    // ── KPI targets ────────────────────────────────────
    match /kpi_targets/{uid} {
      allow read: if isAuth() && (isOwner(uid) || isAdmin());
      allow write: if isAuth() && isAdmin();
    }

    // ── Settings ───────────────────────────────────────
    // v12 WS19: read locked to internal staff on the internal docs (sales_sop,
    // employeeOfMonth) — was bare isAuth(). 'system' stays universally readable:
    // EVERY session (incl. partner) listens to settings/system via onSnapshot
    // for the president's force-logout signal (js/app.js:135) — locking it out
    // would silently break force-logout for partner sessions specifically,
    // exactly when the President most needs it to work (cutting off a
    // compromised/terminated partner account).
    match /settings/{docId} {
      allow read: if isAuth() && (!isPartner() || docId == 'system');
      allow write: if isAuth() && isPresident();
    }

    // ── Holidays admin overrides (WS26) ─────────────────
    // Dedicated collection so the looser finance/admin write does NOT touch
    // the president-only settings/{docId} match above (which also gates
    // employeeOfMonth/sales_sop — loosening it would loosen those too).
    match /settings_holidays/{year} {
      allow read:  if isAuth();
      allow write: if isAuth() && isOpsAdmin();
    }

    // ── Strategy / market-research notes (v12 WS40) ──────────────────
    // docId ∈ {general,sales,marketing,production,finance,gov}. Read scoped to the
    // Analytics tier (president/manager/secretary/finance); entries appended via
    // arrayUnion. Secretary is view-only CLIENT-side (WS25 decision-9 pattern) —
    // rules keep the tier uniform. .get() defaults per missing-field-throws memory.
    match /strategy_notes/{deptKey} {
      allow read:  if isAuth() && isOpsAdmin();
      allow write: if isAuth() && isOpsAdmin()
        && request.resource.data.get('entries', []) is list;
      allow delete: if isAuth() && isPresident();
    }

    // ── System health (backup/sync heartbeat) ──────────
    // Written ONLY by the GitHub Actions backup/sync jobs via the Admin SDK
    // (which bypasses these rules). No client ever writes it.
    match /system_health/{jobId} {
      allow read:  if isAuth() && isOpsAdmin();
      allow write: if false;
    }

    // ── President message ──────────────────────────────
    match /president_message/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && isPresident();
    }

    // ── SOPs — readable by internal staff, editable by admins ────────────
    // v12 WS19: read locked to !isPartner() — was bare isAuth(). Write stays
    // isAdmin() (secretary keeps this oversight/coordination surface).
    match /sops/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && isAdmin();
    }

    // ── Payroll (live pay: salary/allowance/deductions) ─
    // Moved off the world-readable users doc so pay isn't visible to all staff.
    // Each user may read their OWN pay; only finance/admin may read others or write.
    // v12 WS19: create/update narrowed to isMoneyAdmin() on
    // payroll/salary_history/salary_raises/payroll_ca_overrides (secretary no
    // longer writes live pay).
    // 2026-08-09 (owner ruling 2 — "they lose payroll, payslips, worker pay
    // rates, expenses, the ledger and taxes"): the READS move to isMoneyAdmin()
    // too, so the Corporate Secretary no longer sees live pay at all. The three
    // money-REQUEST queues they keep for oversight (cash_advances,
    // pending_raises, payroll_delete_requests) are carved out individually with
    // an explicit `|| isSecretary()` on their read rule — read only, never write.
    match /payroll/{uid} {
      allow read:  if isAuth() && (isOwner(uid) || isMoneyAdmin());
      allow create, update: if isAuth() && isMoneyAdmin();
      allow delete: if isAuth() && isPresident();
    }

    // ── Salary history ─────────────────────────────────
    match /salary_history/{docId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || isMoneyAdmin()
      );
      allow create, update: if isAuth() && isMoneyAdmin();
      allow delete: if isAuth() && isPresident();
    }

    // ── Salary raises (audit log of pay increases) ─────
    // Finance/admin grant & manage; the affected app-user may read their own.
    // v14 re-audit ROUND 2 — the "subject may read their own" branch was HALF
    // dead, exactly like the payslips one just fixed. There are two writers:
    // the employee raise sets {subjectType:'payroll', subjectId:<auth uid>}
    // (js/screens/hr.js) — that half works — but the Type-B worker raise sets
    // {subjectType:'worker_profile', subjectId:<worker_profiles AUTO-ID>},
    // which can never equal request.auth.uid. Same worker_profiles.linkedUid
    // bridge as /payslips and /attendance_worker, via the same status-free
    // helper. Latent today (no worker screen reads these yet — the only
    // own-raise reader is the employee dashboard's
    // where('subjectId','==',uid)); fixed now because it is the identical
    // defect class and a future Raise History card would inherit it silently.
    // isMoneyAdmin() stays first so the admin list short-circuits without
    // the profile lookup, and the .get('subjectId','') + != '' + exists()
    // ordering means a raise row with no subjectId denies rather than errors.
    match /salary_raises/{docId} {
      allow read: if isAuth() && (
        isMoneyAdmin() ||
        resource.data.get('subjectId', '') == request.auth.uid ||
        isLinkedWorkerProfile(resource.data.get('subjectId', ''))
      );
      allow create, update: if isAuth() && isMoneyAdmin();
      allow delete: if isAuth() && isPresident();
    }

    // ── Pending / scheduled raises (v12 WS23 — approval-routed schedule) ────
    // Non-president finance may only FILE a request (status pending_approval —
    // filing is a safe escalation, not itself money-moving, matching the
    // secretary's existing "request President approval" pattern elsewhere).
    // President approves → scheduled; the screen-load sweep materializes
    // (scheduled → applied). Subject may read their own.
    match /pending_raises/{docId} {
      // Same half-dead subject branch as /salary_raises above — see there.
      // ⚠ OWNER RULING 1 — READ-ONLY oversight for the Corporate Secretary: this
      // is the collection the Approvals "Raises" queue lists
      // (where('status','==','pending_approval'), js/screens/approvals.js), so
      // they can see a pending raise and escalate it. They cannot file, approve,
      // schedule or materialize one — create/update below stay money-tier and
      // President-only, and the APPLIED-raise audit log (/salary_raises) is now
      // money-tier read, so they see the REQUEST, never the resulting pay.
      allow read: if isAuth() && (
        isMoneyAdmin() || isSecretary() ||
        resource.data.get('subjectId', '') == request.auth.uid ||
        isLinkedWorkerProfile(resource.data.get('subjectId', ''))
      );
      allow create: if isAuth() && (
        isPresident()
        || ( isMoneyAdmin()
             && request.resource.data.get('status','') == 'pending_approval' )
      );
      allow update: if isAuth() && (
        // Automated materialize: any finance, ONLY scheduled → applied.
        ( isMoneyAdmin()
          && resource.data.get('status','') == 'scheduled'
          && request.resource.data.get('status','') == 'applied' )
        // Approve / reject / cancel / reschedule: President only.
        || isPresident()
      );
      allow delete: if isAuth() && isPresident();
    }

    // ── Payroll CA overrides ───────────────────────────
    match /payroll_ca_overrides/{docId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || isMoneyAdmin()
      );
      allow write: if isAuth() && isMoneyAdmin();
    }

    // ── Payroll delete requests ────────────────────────
    // ⚠ OWNER RULING 1 — the Corporate Secretary keeps the READ (this is the
    // Approvals "Finance Requests" queue) but loses CREATE: filing a payroll
    // deletion is a money-surface action. Approve/reject was already President-
    // only. Same silent-zero rationale as cash_advances above.
    match /payroll_delete_requests/{docId} {
      allow read: if isAuth() && (isMoneyAdmin() || isSecretary());
      allow create: if isAuth() && isMoneyAdmin();
      allow update, delete: if isAuth() && isPresident();
    }

    // ── Pay runs (Compute → Verify → Disburse workflow state per month) ──
    // Doc id = YYYY-MM. Governance metadata only (no raw pay). Finance/admin
    // read & write; the President prunes.
    // v12 WS20 — transition-aware state machine. isMoneyAdmin() drives
    // Compute/Verify so 'secretary' can't write pay_runs directly (matches
    // WS19's money-tier narrowing everywhere else). 2026-08-09: the READ moved
    // to isMoneyAdmin() as well — payroll governance state is part of the
    // payroll surface the owner's ruling 2 takes away from the secretary.
    // 'disbursed' is reachable ONLY by the president, ONLY from 'verified', and
    // is immutable afterward — no clause below permits updating a disbursed doc.
    match /pay_runs/{month} {
      allow read: if isAuth() && isMoneyAdmin();
      allow create: if isAuth() && isMoneyAdmin() &&
        request.resource.data.get('state','draft') in ['draft','computed'];
      allow update: if isAuth() && (
        ( isMoneyAdmin() &&
          resource.data.get('state','draft') in ['draft','computed'] &&
          request.resource.data.get('state','') in ['computed','verified'] )
        ||
        ( isPresident() && (
            // verify → disbursing (transactional lock acquisition — Part E Phase 11)
            ( resource.data.get('state','')=='verified' &&
              request.resource.data.get('state','')=='disbursing' ) ||
            // disbursing → disbursed (lock release on success)
            ( resource.data.get('state','')=='disbursing' &&
              request.resource.data.get('state','')=='disbursed' ) ||
            // president reopen: verified → computed
            ( resource.data.get('state','')=='verified' &&
              request.resource.data.get('state','')=='computed' ) ||
            // president manual unlock after investigating a stuck/partial
            // disburse: disbursing → computed (Part E Phase 11)
            ( resource.data.get('state','')=='disbursing' &&
              request.resource.data.get('state','')=='computed' ) ||
            // president may also perform the finance-tier transitions
            ( resource.data.get('state','draft') in ['draft','computed'] &&
              request.resource.data.get('state','') in ['computed','verified'] )
        ))
      );
      allow delete: if isAuth() && isPresident();
    }

    // ── Expenses ───────────────────────────────────────
    match /expenses/{docId} {
      // v14 re-audit ROUND 2 — PERIOD-CLOSE GATE (see the ledger block's own
      // gate further down, and the identical gate cash_receipt_journal /
      // cash_disbursement_journal have carried since WS12).
      //
      // WHY THIS LAYER. An /expenses row is MIRRORED into /ledger as
      // `EXP-<id>` (postExpenseToLedger / resyncLedgerForSource, js/departments
      // .js) and the P&L + VAT return are derived from the LEDGER, never from
      // /expenses. Closing the ledger's update rule alone (the previous pass)
      // therefore did not make a closed month immutable — it made the two
      // halves DIVERGE: the Expense ✎ button (js/screens/finance.js
      // renderFinanceOverview) still wrote the source doc, then
      // Ledger.upsertByRef's merge onto the existing EXP- row was denied, and
      // the denial was swallowed (a console.warn inside resyncLedgerForSource
      // plus a .then(redo) with no .catch), so the user saw "Updated." while
      // the books silently stopped matching their own source records. Before
      // that pass the two at least agreed — wrongly, but consistently.
      //
      // The gate belongs HERE, not on the button and not inside
      // Ledger.upsertByRef, because those are the two doors that exist TODAY:
      // a client-side guard makes the current path fail loudly but leaves the
      // invariant unenforced for the next screen, a devtools write, or a
      // future bulk-edit — and by the time upsertByRef runs, the source doc
      // has ALREADY been written, so the mirror layer can only report the
      // divergence, never prevent it. Enforcing it at the source collection's
      // trust boundary makes source and mirror share one period rule, which is
      // exactly the property CRJ/CDJ already have (their own update rules
      // carry periodOpenFor(), which is why their identical resync chain never
      // desynced). The client guard + the .catch() added alongside this are
      // diagnostics — a clean toast instead of a raw permission error — not
      // the enforcement.
      //
      // Legacy-safe, per the missing-field-denies hazard: an expense with no
      // `date`, a malformed one, or a Timestamp (a type periodOpenFor cannot
      // split, and .matches() ERRORS on) belongs to no period, so it stays
      // editable rather than being locked out — same fail-open policy the
      // ledger block documents for its own pre-WS12 rows.
      // CREATE is deliberately NOT gated: an expense doc on its own restates
      // nothing (the ledger row is what the P&L reads, and /ledger create has
      // carried the gate since WS12), and gating it would newly refuse a late
      // receipt filed against a closed month with no compensating benefit.
      function expenseMonthOpen(d) {
        return !(d is string)
            || !d.matches('^\\d{4}-\\d{2}(-\\d{2})?$')
            || periodOpenFor(d);
      }
      // Both sides, so a row can be moved neither INTO nor OUT of a closed
      // month (the ledger's ledgerMaterialUpdateOk() does the same).
      function expensePeriodOk() {
        return expenseMonthOpen(resource.data.get('date', ''))
            && expenseMonthOpen(request.resource.data.get('date', ''));
      }
      allow read: if isAuth() && (
        resource.data.createdBy == request.auth.uid || isMoneyAdmin()
      );
      allow create: if isAuth() && request.resource.data.createdBy == request.auth.uid;
      // Owners may edit their own expense details but not approve it (status
      // frozen) or change the amount after filing (v14 re-audit fix — amount
      // was freely editable right up until Finance acted on it, with no
      // diff/audit record of the change; a correction now has to go through
      // Finance like the status transition already does).
      // The role test stays FIRST so an unauthorized caller short-circuits
      // before paying periodOpenFor()'s exists()+get().
      allow update: if isAuth() && (
        isMoneyAdmin() ||
        (resource.data.createdBy == request.auth.uid
          && request.resource.data.status == resource.data.status
          && request.resource.data.amount == resource.data.amount)
      ) && expensePeriodOk();
      // Delete is President-only — finance staff request it via the approval flow.
      allow delete: if isAuth() && isPresident();
    }

    // ── Submissions ────────────────────────────────────
    match /submissions/{docId} {
      allow read: if isAuth() && (
        resource.data.createdBy == request.auth.uid || isAdmin()
      );
      allow create: if isAuth() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuth() && isAdmin();
      allow delete: if isAuth() && isAdmin();

      // Submission message thread mirrors the parent's access (submitter ↔ admin).
      // Rules don't inherit to subcollections, so we re-check the parent here.
      match /comments/{commentId} {
        function parentSub() {
          return get(/databases/$(database)/documents/submissions/$(docId)).data;
        }
        allow read: if isAuth() && (
          parentSub().get('createdBy','') == request.auth.uid || isAdmin()
        );
        allow create: if isAuth()
          && request.resource.data.authorId == request.auth.uid
          && (parentSub().get('createdBy','') == request.auth.uid || isAdmin());
        allow update, delete: if isAuth() && (
          resource.data.authorId == request.auth.uid || isAdmin()
        );
      }
    }

    // ── Quotes (internal) ──────────────────────────────
    // NOTE: was incorrectly named 'quotations' in previous rules — fixed
    // v12 WS19: read locked to !isPartner() — this is the INTERNAL Sales quotes
    // collection (distinct from bk_quotes/bs_quotes, which already correctly
    // exclude/scope the partner) and was bare isAuth().
    match /quotes/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && isAdmin();
    }

    // ── BS Quotes (Brilliant Steel partner) ────────────
    // One-way visibility: partner quotes ARE visible to internal staff (Sales,
    // etc.) so they can coordinate; a partner only ever sees their OWN quotes.
    // (The reverse — partner reading internal bk_quotes — is denied below.)
    match /bs_quotes/{docId} {
      // v14 wave3 Q6: autosaved draft slot — exactly one per user, doc id
      // 'draft_{uid}'. Keyed on the ID (never on data fields — absent-field
      // reads DENY the whole rule) so create/update/delete of one's own
      // draft always works; drafts carry draftBy, not createdBy.
      allow read: if isAuth() && (
        resource.data.createdBy == request.auth.uid || !isPartner()
        || docId == 'draft_' + request.auth.uid
      );
      allow create: if isAuth() && (
        request.resource.data.createdBy == request.auth.uid
        || docId == 'draft_' + request.auth.uid
      );
      allow update: if isAuth() && (
        resource.data.createdBy == request.auth.uid || isAdmin()
        || docId == 'draft_' + request.auth.uid
      );
      allow delete: if isAuth() && (isAdmin() || docId == 'draft_' + request.auth.uid);
    }

    // ── BK Quotes (Barro Kitchens / internal Sales) ────
    // Internal sales quotes are NOT visible to external partners — only the
    // creator or an admin may read. A partner has no bk_quotes of their own,
    // so this collection is effectively invisible to them.
    match /bk_quotes/{docId} {
      allow read: if isAuth() && !isPartner() && (
        resource.data.createdBy == request.auth.uid || isAdmin()
        || docId == 'draft_' + request.auth.uid
      );
      // Admins may also create with a DIFFERENT createdBy: required by the v12
      // WS31 stranded-quote migration, which moves misfiled BK docs out of
      // bs_quotes preserving the ORIGINAL creator for the audit trail. Partner
      // isolation is unchanged (partners still can never touch bk_quotes at all).
      allow create: if isAuth() && !isPartner() &&
        (request.resource.data.createdBy == request.auth.uid || isAdmin()
         || docId == 'draft_' + request.auth.uid);
      allow update: if isAuth() && !isPartner() && (
        resource.data.createdBy == request.auth.uid || isAdmin()
        || docId == 'draft_' + request.auth.uid
      );
      // v14 wave3 Q6: own draft slot deletable (deleted on File); partner
      // exclusion for bk_quotes stays absolute.
      allow delete: if isAuth() && (isAdmin()
        || (!isPartner() && docId == 'draft_' + request.auth.uid));
    }

    // ── Quote Templates (QUOTE-TEMPLATES-SPEC.md) ──────
    // Reusable product/pricing/terms configs saved from the quote builder —
    // client/identity fields are stripped client-side before this is ever
    // written, so this collection never carries a specific client's contact
    // details. Internal Sales library — partners excluded, same as /quotes.
    match /quote_templates/{id} {
      allow read:   if isAuth() && !isPartner();               // internal Sales library
      allow create: if isAuth() && !isPartner()
                    && request.resource.data.get('createdBy','') == request.auth.uid;
      allow update, delete: if isAuth() && !isPartner()
                    && (resource.data.get('createdBy','') == request.auth.uid || isAdmin());
    }

    // ── Approval requests ──────────────────────────────
    match /approval_requests/{docId} {
      // Internal workflow data — external partners excluded from reading.
      allow read: if isAuth() && !isPartner();
      // v13 Phase 21: the ONLY two client write sites into this collection are
      // app.js's CA-deduction override modal (type 'ca_deduct', ownership via
      // userId) and the BS-quote review flow (type 'bs_quote', ownership via
      // agentId — that path has no userId field). Everything else that shows
      // up in the "All Requests" dashboard (signup/attendance/submission/
      // review-task/leave) lives in its own separate collection, not here —
      // do not widen this list without a matching new .add() call site.
      allow create: if isAuth() &&
        (request.resource.data.get('userId', '') == request.auth.uid ||
         request.resource.data.get('agentId', '') == request.auth.uid ||
         isOpsAdmin()) &&
        request.resource.data.get('status', '') == 'pending' &&
        request.resource.data.get('type', '') in ['ca_deduct', 'bs_quote'] &&
        request.resource.data.keys().hasOnly([
          'type','status','createdAt','userId','userName','month','amount','reason',
          'quoteId','quoteColl','quoteNumber','clientName','total','agentName','agentId'
        ]) &&
        isNonNegNumber(request.resource.data.get('amount', 0));
      // v12 WS19: the client's APPROVAL_CAPS table already hides money/quote
      // approve-buttons from secretary, but the rule itself allowed any isAdmin()
      // to approve them via a direct write — tightened to match: secretary
      // (isAdmin() but not isSeniorAdmin()) may only act on the MINOR request
      // types; money/quote/finance approvals need president or manager.
      allow update: if isAuth() && (
        isSeniorAdmin() ||
        (isAdmin() && resource.data.get('type', '') in
          ['signup', 'attendance', 'submission', 'review-task', 'leave', 'ca_deduct'])
      );
      allow delete: if isAuth() && isAdmin();
    }

    // ── Signup requests — anyone can apply (pre-auth) ──
    match /signup_requests/{docId} {
      // Public but constrained to the exact application shape, so this open
      // endpoint can't be abused to write arbitrary or oversized documents.
      allow create: if request.resource.data.keys().hasOnly(['fullName','email','phone','status','createdAt'])
        && request.resource.data.status == 'pending'
        && isBoundedString(request.resource.data.fullName, 120)
        && isBoundedString(request.resource.data.email, 200)
        && isBoundedString(request.resource.data.phone, 40);
      allow read, update, delete: if isAuth() && isAdmin();
    }

    // ── Partner deals (50/50 profit split) ────────────
    match /partner_deals/{docId} {
      // Partners can read their own deals; admins can read all.
      allow read: if isAuth() && (
        resource.data.partnerUid == request.auth.uid || isAdmin()
      );
      // Only money-tier can create/update deals (this is a profit-split payout
      // record) — partners cannot self-register earnings. v12 WS19: narrowed
      // from isAdmin() to isMoneyAdmin() so secretary can't post a deal.
      allow create, update: if isAuth() && isMoneyAdmin();
      allow delete: if isAuth() && isPresident();
    }

    // ── Products catalog ───────────────────────────────
    // v14 re-audit HIGH fix — Firestore has no field-level read security, so
    // this doc's cost-basis fields (capitalMaterials, capitalLabor, and the
    // BOM's per-line unitCost) were readable by ANY authenticated user,
    // including role 'partner', straight from the browser console — the
    // quote builder's DOM-only "hide the cost panel" for generic partners
    // was theatre on top of a fully-readable doc. Fix: cost data now lives
    // ONLY in product_costs/{docId} below (finance/admin, never partner).
    // `products` itself is unchanged for read (still needed for name/price/
    // measurement/specs); writes going forward may never (re)introduce a
    // cost field onto it.
    //
    // productCostFieldsLocked() lets an update touch any OTHER field freely,
    // even on a not-yet-migrated doc that still carries legacy cost values,
    // but a cost field may only ever move TOWARD null (the migration's own
    // FieldValue.delete()) — never be set/changed to a new non-null value.
    // That makes the lockdown order-independent: it's safe to deploy this
    // rule before, during, or after migrateProductCostsOut() has run.
    function productCostFieldNotIncreased(field) {
      let nv = request.resource.data.get(field, null);
      let ov = resource.data.get(field, null);
      return nv == ov || nv == null;
    }
    function productCostFieldsLocked() {
      return productCostFieldNotIncreased('capitalMaterials')
          && productCostFieldNotIncreased('capitalLabor')
          && productCostFieldNotIncreased('bom');
    }
    match /products/{docId} {
      allow read: if isAuth();
      allow create: if isAuth() && isAdmin()
        && !('capitalMaterials' in request.resource.data)
        && !('capitalLabor' in request.resource.data)
        && !('bom' in request.resource.data);
      allow update: if isAuth() && isAdmin() && productCostFieldsLocked();
      allow delete: if isAuth() && isAdmin();
    }
    match /productMeta/{docId} {
      allow read: if isAuth();
      allow write: if isAuth() && isAdmin();
    }
    // ── Product cost basis (materials/labor capital + BOM unit costs) ──
    // v14 re-audit HIGH fix. Split out of products/{docId} (see comment
    // above) precisely so a partner can never reach this data at all, not
    // just "shouldn't" per UI. Read+write restricted to finance/admin only —
    // explicitly NOT partner, even though isAdmin()/canFinance() would never
    // naturally include that role; the `!isPartner()` is defense-in-depth so
    // this stays true even if a future edit widens either helper.
    match /product_costs/{docId} {
      // ⚠ 2026-08-09 SECRETARY LEAK — isAdmin() -> isSeniorAdmin(). This doc is
      // capital material/labour and BOM unit costs; it was split out of
      // /products precisely BECAUSE it is cost basis. It reached the Corporate
      // Secretary through isAdmin(), not through the old 4-role helper, so
      // the helper split alone would not have closed it. Delta is exactly
      // {secretary}: president/manager keep it via isSeniorAdmin(), the finance
      // role and Finance-dept staff via canFinance().
      allow read, write: if isAuth() && !isPartner() && (isSeniorAdmin() || canFinance());
    }

    // ── Reference materials ────────────────────────────
    // v12 WS19: read locked to internal staff (!isPartner()) on all four — were
    // bare isAuth(). Write stays isAdmin() (secretary keeps this surface).
    match /resources/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && isAdmin();
    }
    match /policies/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && isAdmin();
    }
    match /handbook/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && isAdmin();
    }
    match /memos/{docId} {
      allow read:   if isAuth() && !isPartner();
      allow create: if isAuth() && isAdmin();
      allow delete: if isAuth() && isAdmin();
      // Admins edit freely. A tagged recipient may update ONLY to record their
      // own conforme, and the entry is locked to a trustworthy, server-stamped,
      // write-once record so it can stand as a real acknowledgment:
      //   • only the `conformes` map may change, and within it only their own uid;
      //   • write-once — an existing conforme can't be re-written by the recipient
      //     (only an admin could correct it);
      //   • the entry must be exactly {at, name} with `at` == the server time
      //     (a client-supplied/back-dated Date won't equal request.time → rejected)
      //     and `name` a bounded string — so the timestamp and shape can't be forged.
      allow update: if isAuth() && (
        isAdmin() || (
          (request.auth.uid in resource.data.get('recipients', []))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['conformes'])
          && request.resource.data.conformes.diff(resource.data.get('conformes', {}))
               .affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in resource.data.get('conformes', {}))
          && request.resource.data.conformes[request.auth.uid].keys().hasOnly(['at','name'])
          && request.resource.data.conformes[request.auth.uid].at == request.time
          && request.resource.data.conformes[request.auth.uid].name is string
          && request.resource.data.conformes[request.auth.uid].name.size() <= 200
        )
      );
    }

    // ── Projects ───────────────────────────────────────
    // v12 WS19: read locked to !isPartner() — was bare isAuth(). NOTE: this is
    // DIFFERENT from /job_projects (which already correctly partner-scopes) —
    // the unified Projects view already skips this collection for partners
    // client-side, so this closes the gap without any UI regression.
    match /projects/{docId} {
      allow read: if isAuth() && !isPartner();
      allow create: if isAuth();
      // Creator/admin can edit anything; finance (role or Finance-dept) may also
      // update so they can record payments & issue billing invoices for collection.
      // Design-dept members may edit too (team/drawings-link/status). .get() is
      // null-safe for older docs whose createdBy field is absent.
      allow update: if isAuth() && (
        resource.data.get('createdBy', '') == request.auth.uid || isAdmin() || canFinance() || canDesign()
      );
      allow delete: if isAuth() && isAdmin();
    }

    // ── Design drawings (flat, projectId-scoped; full revision control) ──
    // DWG/PDF/2D/3D drawings attached to a Design project. Top-level collection
    // (not a subcollection) so the cross-project Drawings dashboard is a simple
    // query. Rules do NOT cascade, so this needs its own block. All field reads
    // are .get(field, default) — a bare read of an absent field DENIES the rule.
    // v12 WS19: read locked to !isPartner() — was bare isAuth().
    // v12 WS35: real approval gate. 'approved' and 'released' are privileged
    // transitions with a pinned topology (for_review→approved→released), approvable
    // only by president/manager or the parent project's designLead — and NEVER by
    // the drawing's own author/assignee (self-approval hole closed at the rules
    // layer, not just the UI). secretary is deliberately NOT an approver (view-only
    // approvals directive), which is why this uses an explicit role list instead
    // of isAdmin(). Everything that is not a promotion to approved/released keeps
    // the old gate.
    match /design_drawings/{docId} {
      // President/manager, or the designLead of the drawing's parent project.
      // Role check FIRST so admins never depend on the project get() resolving.
      function isDrawingApprover() {
        return getRole() in ['president', 'manager']
          || request.auth.uid == get(/databases/$(database)/documents/projects/$(resource.data.get('projectId', '_none_'))).data.get('designLead', '');
      }
      function statusNow()  { return resource.data.get('status', ''); }
      function statusNext() { return request.resource.data.get('status', ''); }
      // Promotion = the status field is CHANGING to approved/released.
      function isPromotion() {
        return statusNext() in ['approved', 'released'] && statusNext() != statusNow();
      }
      // v14 re-audit fix — the two-party approval gate only covered
      // transitions INTO approved/released; a demotion OUT of them (incl.
      // released/approved -> draft/for_review) fell into the ordinary
      // canDesign() branch, so ANY design-dept member (not an approver, not
      // even the drawing's own author/assignee) could silently revert a
      // released drawing — undermining the revision-control trail this gate
      // exists for.
      function isDemotion() {
        return statusNow() in ['approved', 'released'] && statusNext() != statusNow();
      }
      allow read:   if isAuth() && !isPartner();
      // v12 WS35: new drawings must start at draft (no API-created pre-approved docs).
      allow create: if isAuth() && canDesign()
                    && request.resource.data.get('createdBy', '') == request.auth.uid
                    && request.resource.data.get('status', 'draft') == 'draft';
      allow update: if isAuth() && (
        // (1) ordinary edits + non-privileged demotions (revisions,
        //     back-to-draft/review, supersede, reactivate, field edits with
        //     status unchanged) — the pre-WS35 gate. Excludes demotions OUT
        //     of approved/released (clause 4 below now owns those).
        ( !isPromotion() && !isDemotion() && (
             resource.data.get('createdBy', '')  == request.auth.uid
          || resource.data.get('assignedTo', '') == request.auth.uid
          || canDesign()
        ))
        // (2) APPROVE: for_review → approved, by an approver who is not the
        //     drawing's author or assigned designer (two-party control)
        || ( statusNext() == 'approved' && statusNow() == 'for_review'
          && isDrawingApprover()
          && request.auth.uid != resource.data.get('createdBy', '')
          && request.auth.uid != resource.data.get('assignedTo', '') )
        // (3) RELEASE: approved → released, by an approver (independence was
        //     already enforced when 'approved' was reached — see clause 2)
        || ( statusNext() == 'released' && statusNow() == 'approved'
          && isDrawingApprover() )
        // (4) DEMOTE: approved/released -> anything else, approver-only (v14
        //     re-audit fix — closes the self-demote-without-approval hole).
        || ( isDemotion() && isDrawingApprover() )
      );
      allow delete: if isAuth() && isAdmin();
    }

    // ── IT collections ─────────────────────────────────
    // v12 WS19: read locked to !isPartner() on all three — were bare isAuth().
    match /it_tickets/{docId} {
      allow read: if isAuth() && !isPartner();
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.createdBy == request.auth.uid || isAdmin()
      );
      allow delete: if isAuth() && isAdmin();
    }
    // IT assets/software: IT-dept members manage them (UI gates on canEditDept('IT')).
    // 2026-08-09 — canDept('IT') -> canIt() on every WRITE, and on the two
    // restricted READS (it_access holds credentials/account grants, it_network
    // holds infrastructure config; both were admin-or-IT-dept). Delta is exactly
    // {secretary}. it_assets/it_software READ deliberately stays !isPartner():
    // it is a company-wide inventory every employee can already see, so removing
    // one role from it would be theatre, and the IT screen is hidden from them in
    // the nav. Note the client ALREADY restricted the Access Control / Network
    // subtabs to president|manager (js/screens/govit.js renderIT `itAdmin`), so
    // these two reads only bring the rules into line with shipped UI behaviour.
    match /it_assets/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && canIt();
    }
    match /it_software/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && canIt();
    }
    match /it_access/{docId} {
      allow read: if isAuth() && canIt();
      allow write: if isAuth() && canIt();
    }
    match /it_network/{docId} {
      allow read: if isAuth() && canIt();
      allow write: if isAuth() && canIt();
    }

    // ── Per-department document collections (renderDocCollection) ───────
    // These were unruled → silent permission-denied (blank screens). Internal
    // staff read; the owning department (or an admin) writes. Partners excluded.
    match /work_plans/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && canDept('Sales');
    }
    match /marketing_plans/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && canDept('Marketing');
    }
    match /marketing_proposals/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && canDept('Marketing');
    }

    // ── Marketing suite (v12 WS34): campaigns, promotions calendar, strategy
    // templates. Literal-named root collections (the files_*/budgets_* wildcard
    // deliberately does not apply). Read = internal staff; write = Marketing
    // members or admins (canDept, same pattern as marketing_plans above).
    // .get(field, default) everywhere per the missing-field-throws memory.
    match /campaigns/{docId} {
      allow read: if isAuth() && !isPartner();
      allow create: if isAuth() && canDept('Marketing')
        && request.resource.data.get('name', '') != ''
        && request.resource.data.get('status', 'planned') in ['planned','active','done','cancelled']
        && isNonNegNumber(request.resource.data.get('budget', 0))
        && request.resource.data.get('createdBy', '') == request.auth.uid;
      allow update: if isAuth() && canDept('Marketing')
        && request.resource.data.get('status', 'planned') in ['planned','active','done','cancelled']
        && isNonNegNumber(request.resource.data.get('budget', 0));
      // Delete is admin-only: clients.campaignId points here — cancel, don't delete.
      allow delete: if isAuth() && isAdmin();
    }
    match /promotions/{docId} {
      allow read: if isAuth() && !isPartner();
      allow create: if isAuth() && canDept('Marketing')
        && request.resource.data.get('title', '') != ''
        && request.resource.data.get('createdBy', '') == request.auth.uid;
      allow update, delete: if isAuth() && canDept('Marketing');
    }
    match /marketing_templates/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && canDept('Marketing');
    }

    match /gov_philgeps/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && canDept('Government Biddings');
    }
    match /gov_active_bids/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && canDept('Government Biddings');
    }
    match /gov_archive/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && canDept('Government Biddings');
    }

    // ── AEC Partner Directory (Sales/CRM prospecting: architects/engineers/
    // contractors, v12 WS33; moved from a Sales sub-tab into its own CRM
    // department 2026-08-04 — js/screens/crm.js's "AEC Leads" tab). Internal
    // pipeline — partner excluded, matching work_plans. Writes follow the
    // TIGHTENED canDept pattern — deliberately stricter than the legacy
    // bare-isAuth() sales_clients block (~1121); that looseness is pre-existing,
    // not the template. Widened 2026-08-04 to ALSO allow canDept('CRM') —
    // Sales-only members keep working exactly as before, this only ADDS
    // capability for CRM dept members (mirrors the client-side canEdit
    // widening in js/screens/sales.js's renderAECDirectory). Delete
    // admin-only (no delete-request flow: low-stakes list).
    match /aec_contacts/{docId} {
      allow read: if isAuth() && !isPartner();
      allow create, update: if isAuth() && (canDept('Sales') || canDept('CRM') || isAdmin());
      allow delete: if isAuth() && isAdmin();
    }

    // ── ROC (restaurant) Lead Directory — CRM department (added 2026-08-04
    // alongside the CRM department; js/screens/crm.js's renderROCDirectory).
    // Net-new collection mirroring aec_contacts' exact rule shape: internal
    // pipeline (partner excluded), writes gated to Sales/CRM dept members or
    // admin, delete admin-only (no delete-request flow — same low-stakes-list
    // rationale as aec_contacts, not a finance/money collection).
    match /roc_leads/{id} {
      allow read: if isAuth() && !isPartner();
      allow create, update: if isAuth() && (canDept('CRM') || canDept('Sales') || isAdmin());
      allow delete: if isAuth() && isAdmin();
    }

    // ── Ventures portfolio — Ventures department (added 2026-08-08;
    // js/screens/ventures.js). One doc per venture, holding DOCUMENTATION
    // ONLY: prose (summary + user-defined sections[]), links[], one fileUrl.
    // No money fields by design, so this is deliberately NOT on the
    // finance/delete-request tier.
    //
    // READ is canDept-shaped, matching the owner's decision: anyone ASSIGNED
    // to the Ventures department, plus admins (canDept('Ventures') ==
    // isAdmin() || inDept('Ventures')). Deliberately NOT president-only and
    // NOT all-internal-staff. `!isPartner()` is defense-in-depth — the
    // external partner could never satisfy canDept today, but this keeps that
    // true even if a future edit widens the helper. THIS RULE IS THE
    // BOUNDARY; the screen-side canEditDept check is cosmetic.
    //
    // LIST: the client reads the collection UNFILTERED and sorts client-side
    // (js/screens/ventures.js fetchVentures) precisely because a list query is
    // denied unless it is provable from the query alone — a role/dept-only
    // condition like this one IS provable, and it needs no composite index.
    // Do not add a where() clause on the client without revisiting this.
    //
    // Every field read below uses .get(field, default): reading an ABSENT
    // field in a rule throws, and a throwing rule DENIES (this already broke
    // presence/status in this repo once). Older/partial venture docs
    // legitimately lack `status`, `slug` and the arrays.
    //
    // Rules do NOT cascade to subcollections — this block covers
    // ventures/{id} only. There are no venture subcollections today; adding
    // one needs its own match block.
    //
    // Attachments live in Firebase Storage under Ventures/Briefs/* and are
    // already covered by storage.rules' generic
    // /{department}/{subfolder}/{fileName} block ('Ventures' is not one of its
    // isReservedTop() segments), so storage.rules needed no change.
    // ── MEETINGS (owner request — in-system calendar + chat invites) ──────
    // Read is invitee-or-oversight. There is no LIST-safe blanket read: the
    // calendar's non-admin query carries `invitees array-contains uid`, which
    // is exactly what makes the first disjunct provable from the query alone.
    //
    // Two fields are deliberately NOT client-writable:
    //   remindersSent — a client that could stamp it could silence its own
    //                   reminder. Only the daily digest (functions/index.js)
    //                   writes it, with admin credentials.
    //   organizerUid  — frozen after create, so a meeting cannot be taken over.
    //
    // Every field read below uses .get(field, default). A rules expression that
    // reads an ABSENT field THROWS and denies the whole rule — that is not
    // theoretical here, it silently broke presence/status in this project once.
    match /meetings/{meetingId} {
      function isOrganizer() { return resource.data.get('organizerUid', '') == request.auth.uid; }
      function isInvitee()   { return request.auth.uid in resource.data.get('invitees', []); }
      // Only the caller's OWN rsvp key may move, and nothing else on the doc —
      // mirrors the reactions pattern used on chat messages.
      function rsvpOnlyByOwner() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvp'])
          && request.resource.data.get('rsvp', {}).diff(resource.data.get('rsvp', {}))
               .affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.get('rsvp', {})[request.auth.uid] in ['yes', 'no', 'maybe'];
      }
      // CREATE: the field must simply not be there.
      function noServerFieldsOnCreate() {
        return !request.resource.data.keys().hasAny(['remindersSent']);
      }
      // UPDATE: it must not CHANGE. Checking keys() here would be wrong and
      // would have bitten on the first edit after a reminder went out — an
      // update's request.resource.data is the FULL merged document, so once the
      // digest has stamped remindersSent, keys() contains it on every
      // subsequent organizer edit and a keys()-based guard would deny them all.
      function serverFieldsUnchanged() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['remindersSent']);
      }

      allow read: if isAuth() && !isPartner() && (isInvitee() || isOrganizer() || isAdmin());

      allow create: if isAuth() && !isPartner()
        && request.resource.data.get('organizerUid', '') == request.auth.uid
        && request.auth.uid in request.resource.data.get('invitees', [])
        && request.resource.data.get('invitees', []).size() <= 200
        && request.resource.data.get('title', '') is string
        && request.resource.data.get('title', '') != ''
        && request.resource.data.get('title', '').size() <= 140
        && request.resource.data.get('agenda', '').size() <= 4000
        && request.resource.data.get('location', '').size() <= 300
        && request.resource.data.get('status', '') == 'scheduled'
        && request.resource.data.get('startAt', request.time) is timestamp
        && noServerFieldsOnCreate();

      allow update: if isAuth() && !isPartner() && (
        ( (isOrganizer() || isAdmin())
          && request.resource.data.get('organizerUid', '') == resource.data.get('organizerUid', '')
          && request.resource.data.get('title', '') != ''
          && request.resource.data.get('title', '').size() <= 140
          && request.resource.data.get('agenda', '').size() <= 4000
          && request.resource.data.get('location', '').size() <= 300
          && request.resource.data.get('notes', '').size() <= 4000
          && request.resource.data.get('status', 'scheduled') in ['scheduled', 'cancelled']
          && request.resource.data.get('invitees', []).size() <= 200
          && serverFieldsUnchanged() )
        ||
        ( isInvitee() && rsvpOnlyByOwner() )
      );

      allow delete: if isAuth() && (isOrganizer() || isAdmin());
    }

    match /ventures/{id} {
      allow read: if isAuth() && !isPartner() && canDept('Ventures');
      allow create: if isAuth() && !isPartner() && canDept('Ventures')
        && request.resource.data.get('name', '') != ''
        && request.resource.data.get('slug', '') != ''
        && request.resource.data.get('status', 'exploring')
             in ['active', 'exploring', 'paused', 'archived'];
      allow update: if isAuth() && !isPartner() && canDept('Ventures')
        && request.resource.data.get('name', '') != ''
        && request.resource.data.get('status', 'exploring')
             in ['active', 'exploring', 'paused', 'archived'];
      // Delete is admin-only (president/manager/secretary) — same low-stakes
      // rationale as aec_contacts/roc_leads: no delete-request flow, because
      // nothing here is a financial record.
      allow delete: if isAuth() && isAdmin();
    }

    // ── Finance journals & records ─────────────────────
    // Finance may create + edit every line. DELETE is President-only: finance
    // staff file a finance_delete_requests doc that the President approves in the
    // Approvals tab (the actual delete then runs in the President's context). This
    // mirrors the existing salary_history / cash_advances delete gate.
    // v12 WS12 — period-close guard helpers. A ledger create must (a) carry a
    // real date (every one of the ~14 client posting sites already sends one —
    // this only catches a malformed/missing date before it can silently vanish
    // from an orderBy('date') report) and (b) target a month that isn't closed.
    // Missing finance_periods doc = open (fail-open on absence, the safe default
    // per the missing-field-denies gotcha). President bypasses the close-lock —
    // the governance model is reopen -> fix -> re-close, never a silent side door.
    function ledgerDateOk() {
      return request.resource.data.get('date', '').matches('^\\d{4}-\\d{2}(-\\d{2})?$');
    }
    function ledgerPeriodOpen() {
      return periodOpenFor(request.resource.data.get('date', ''));
    }
    // v13 Phase 84 — generalized period-close check, reusable by any money
    // collection that carries a 'date' field. President bypasses; a month with
    // no finance_periods doc is OPEN (fail-open on absence, the safe default
    // per the missing-field-denies gotcha).
    //
    // ⚠ v14 re-audit correction — the note that used to sit here claimed a
    // missing/malformed date (e.g. '') "maps to a finance_periods docId that
    // will never exist, so the !exists() branch fires and the write is
    // allowed". That is NOT what the engine does: ''.split('-') has no index
    // [1], so the expression ERRORS, and an erroring rule DENIES. Verified in
    // the emulator. It has never bitten, only because every existing caller
    // puts `ledgerDateOk() &&` in front and && short-circuits. NEVER call this
    // with a string you have not already matched against the yyyy-mm(-dd)
    // regex first.
    function periodOpenFor(dateStr) {
      return isPresident() ||
        !exists(/databases/$(database)/documents/finance_periods/$(
          dateStr.split('-')[0] + '-' + dateStr.split('-')[1])) ||
        get(/databases/$(database)/documents/finance_periods/$(
          dateStr.split('-')[0] + '-' + dateStr.split('-')[1])).data.get('closed', false) == false;
    }
    match /finance_periods/{month} {
      // v14 re-audit ROUND 2 widened this read from canFinance() to the old
      // ops/finance tier purely so the Corporate Secretary's Finance Overview /
      // Expense ✎ period lookup stopped failing open. 2026-08-09 that premise is
      // gone: ruling 2 removes them from the Finance Overview, the Expense ✎
      // button and /expenses update altogether, so the widening has no remaining
      // beneficiary and is reverted to plain canFinance().
      // NOT a narrowing of anyone else: the union that shipped in round 2 was
      // `canFinance() || <ops tier>`, and dropping 'secretary' from the right
      // operand leaves president/manager/finance — all already inside
      // canFinance() — so `canFinance()` alone is the exact same set minus the
      // secretary. A Finance-DEPT employee (role 'employee',
      // departments:['Finance']) keeps it via canFinance(), which is the case the
      // round-2 differential matrix caught and must not regress.
      // Client-side this fails SAFE: isPeriodClosed() (js/config.js) .catch()es a
      // denied read to null and treats the month as OPEN, so nothing throws — and
      // they have no write path into any period-gated collection anyway.
      allow read: if isAuth() && canFinance();
      allow create, update: if isAuth() && isPresident();
      allow delete: if false;
    }
    // ── Finance config (v14 post-release: break-even classification etc.) ──
    // Small finance-owned settings docs (fixed/variable category mapping,
    // manual fixed-cost entries). Finance tier read+write.
    match /finance_config/{docId} {
      allow read, write: if isAuth() && canFinance();
    }

    // ── Finance rollups (v14 wave4 F2) ─────────────────
    // Client-maintained monthly aggregates (finance_rollup/{yyyymm} + 'undated').
    // Best-effort writes fired after every Ledger mutation; Rebuild-rollups in
    // Finance Tools is the reconciliation authority. Writers = anyone who can
    // post ledger rows (finance + the fenced Production COS path).
    match /finance_rollup/{docId} {
      // v14 re-audit ROUND 2 — period gate. These docs ARE the month's reported
      // headline figures (the Finance Overview / dashboard KPI tiles read them
      // instead of scanning the ledger, js/screens/finance.js
      // renderFinanceOverview), so leaving them ungated meant a CLOSED month's
      // published income/expense/VAT could still be moved directly even after
      // the ledger rows behind them were locked — the same restatement F50
      // closed, one layer up. Every real writer is _syncRollup/rebuildRollups
      // (js/finance-ledger.js), which only ever runs AFTER a ledger write that
      // has itself cleared this same gate, so an open month is unaffected and
      // a closed month can only be touched by the President (periodOpenFor()'s
      // bypass) — who is also the only one who can reopen the period or run
      // Rebuild rollups. Guarded on BOTH the docId (which IS the month key by
      // construction: .doc(delta.month)) and the `month` field, so writing a
      // July figure into the June doc doesn't dodge it. Same fail-open policy
      // for an unbucketable value as everywhere else in this file.
      function rollupMonthOpen(m) {
        return !(m is string) || !m.matches('^\\d{4}-\\d{2}$') || periodOpenFor(m);
      }
      allow read: if isAuth() && canFinance();
      // v14 re-audit fix — was unfenced `write` (create+update+delete) with NO
      // affectedKeys() shape guard, unlike the analogous Production ledger leg
      // above. Every real writer (_syncRollup/rebuildRollups, js/finance-ledger.js)
      // always sets EXACTLY this field set — a Production-tier account can no
      // longer overwrite arbitrary fields on any month's doc. Delete is
      // finance-tier only: rebuildRollups() (the only delete path) is already
      // president-only client-side, and Production never legitimately deletes
      // a rollup doc.
      // ⚠ 2026-08-09 SECRETARY LEAK — canProduction() -> isProductionDept().
      // canProduction() = isAdmin() || isProductionDept(), and isAdmin() includes
      // 'secretary', so the Corporate Secretary passed this WRITE while READ is
      // canFinance() — they could rewrite any open month's reported income,
      // expense, vatOutput, vatInput and byCategory, figures they cannot even
      // read, and which ARE the Finance Overview and the dashboard KPI tiles.
      // This reached them through canProduction(), NOT through the old 4-role
      // helper, so the helper split alone would not have closed it.
      // Nobody else moves: president/manager/finance already satisfy
      // canFinance(); genuine Production-dept staff keep the leg they need.
      // canProduction() ITSELF is left alone — production_orders legitimately
      // needs it and Production is a department they keep.
      allow create, update: if isAuth() && (canFinance() || isProductionDept())
        && request.resource.data.keys().hasOnly(
             ['month','income','expense','vatOutput','vatInput','byCategory','count','updatedAt'])
        && rollupMonthOpen(docId)
        && rollupMonthOpen(request.resource.data.get('month', ''));
      allow delete: if isAuth() && canFinance();
    }

    match /ledger/{docId} {
      allow read: if isAuth() && canFinance();
      // v14 re-audit fix — recover the production_orders docId embedded in a
      // POCOS refNumber ('POCOS-<id>' for the expense leg, 'POCOS-<id>-INV' for
      // the inventory contra leg — see consumeProductionMaterials(),
      // js/screens/production.js) so the create rule below can verify the
      // referenced order actually exists, instead of trusting any
      // POCOS-shaped string a Production account cares to send. Firestore
      // auto-ids never contain '-', so stripping the fixed prefix (and, for
      // the INV leg, the trailing '-INV') recovers the id exactly.
      function pocosOrderId(ref) {
        return ref.split('POCOS-')[1].split('-INV')[0];
      }
      // v14 re-audit fix — /ledger UPDATE was the ONE money-collection rule
      // with no period-close check at all. The sibling create below carries
      // ledgerDateOk() + ledgerPeriodOpen(), and cash_receipt_journal /
      // cash_disbursement_journal / general_journal carry both on create AND
      // update — but a CLOSED month's ledger rows could still be restated
      // (amount, category, even the date itself). That silently rewrites an
      // already-filed P&L and VAT return: closeFinancePeriod snapshots no
      // figures (js/departments.js writes only {closed,closedBy,closedAt}), and
      // ledgerForPeriod (js/config.js) + computeVatSummary (js/bir.js) re-derive
      // from the live ledger on every render. The same ✎ button's
      // general_journal branch DID fail with a permission error, so the /ledger
      // branch succeeding quietly made the gap invisible to the user.
      //
      // Bank-reconciliation maintenance legitimately touches OLD (closed-month)
      // rows and moves no reported figure, so those writes keep the loose path:
      // the reconcile checkbox and bank re-tag select (js/screens/finance.js)
      // and the Bank Rec 'cleared' checkbox (js/bir.js). Everything else —
      // amount/date/type/category/description/refNumber, i.e. financeEditModal
      // and Ledger.upsertByRef's merge onto an existing row — must clear the
      // period gate on BOTH sides, so a row can be moved neither INTO nor OUT
      // of a closed month.
      // v14 re-audit ROUND 2 — 'bankFlow' REMOVED from this allowlist. It was
      // the one entry no maintenance writer actually needs (the reconcile
      // checkbox writes reconciled/By/At — js/screens/finance.js; the Bank Rec
      // clear checkbox writes cleared/By/At — js/bir.js; the re-tag select
      // writes bankAccountId/bankAccountName only), and it is the one that
      // INVERTS a figure: 'in' ↔ 'out' flips the sign of that row in the
      // derived bank balance (js/config.js) and in the Bank Rec report
      // (js/bir.js). bankAccountId/bankAccountName deliberately STAY — moving a
      // mis-tagged old row to the right account is exactly the reconciliation
      // work that must survive a close, and it changes no filed figure: the
      // period lock exists so an already-filed P&L/VAT (type, category, amount,
      // date) cannot be rewritten, and a bank balance is a live cash position,
      // not a filed one.
      function ledgerNonMaterialUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['reconciled', 'reconciledBy', 'reconciledAt',
           'cleared', 'clearedBy', 'clearedAt',
           'bankAccountId', 'bankAccountName',
           'editedBy', 'editedByName', 'editedAt']);
      }
      // periodOpenFor() ERRORS (= denies) on anything it can't split into a
      // yyyy-mm — see the ⚠ note on that function — so every call is guarded
      // by the same format check first. Rows predating WS12's create-side
      // ledgerDateOk() may carry a missing/malformed date; they belong to no
      // period, so they are neither gated by this nor able to restate a closed
      // month. Fail-OPEN there is deliberate: locking legacy rows out of every
      // edit would be worse than the hole being closed.
      // v14 re-audit ROUND 2 — `d is string` first. .matches() is a STRING
      // method: on a row whose `date` is a Timestamp rather than a
      // 'YYYY-MM-DD' string it raises "Function not found error: [matches]",
      // and an erroring rule DENIES — so a single legacy Timestamp-dated row
      // would have been permanently un-editable by everyone except the
      // President (whose periodOpenFor() bypass makes the right operand true,
      // which CEL then uses to absorb the left error). Reproduced in the
      // emulator, not theorised. A non-string date can't be bucketed into a
      // finance_period at all, so it takes the same fail-open path as a
      // missing/malformed one.
      function ledgerMonthOpen(d) {
        return !(d is string)
            || !d.matches('^\\d{4}-\\d{2}(-\\d{2})?$')
            || periodOpenFor(d);
      }
      // A material edit must carry a well-formed date OR leave the row's
      // existing (possibly legacy/malformed) date byte-identical — that second
      // clause is purely so a legacy dateless row stays editable; it can't be
      // used to dodge the gate, because an unchanged date is checked by the
      // very same ledgerMonthOpen() call as the old one.
      function ledgerMaterialUpdateOk() {
        return ( ledgerDateOk()
                 || request.resource.data.get('date', '') == resource.data.get('date', '') )
            && ledgerMonthOpen(resource.data.get('date', ''))
            && ledgerMonthOpen(request.resource.data.get('date', ''));
      }
      // Finance/admin post anything (subject to the date + period-close gate
      // above). Production may ALSO post its own material COS — v12 WS13 adds a
      // second Production-postable shape, the Inventory contra-leg that nets the
      // consumption expense against the asset booked at purchase time (fixes
      // double material expensing). Both legs are tightly fenced: fixed
      // category/source/type/refNumber pattern, positive amount only — so a
      // Production user can't forge revenue, a negative, or an arbitrary entry.
      // accountType is read tolerantly (.get(...,'expense')/.get(...,'')) so an
      // old, not-yet-updated client posting the legacy (no-accountType) COS shape
      // is still accepted. Update/delete stay finance/president.
      // v12 WS36 — bankFlow shape guard ('' | 'in' | 'out'). .get(field,default) so
      // untagged rows and old clients (no bankFlow at all) still pass.
      allow create: if isAuth() && ledgerDateOk() && ledgerPeriodOpen()
        && request.resource.data.get('bankFlow', '') in ['', 'in', 'out'] && (
        canFinance()
        // ⚠ 2026-08-09 SECRETARY LEAK — canProduction() -> isProductionDept(),
        // same disjunct-shape and same reasoning as finance_rollup above: the
        // isAdmin() inside canProduction() let the Corporate Secretary post
        // fenced Production COS rows into the general ledger. Safe for everyone
        // else — president/manager/finance already clear canFinance().
        || (isProductionDept()
            && request.resource.data.get('source', '') == 'Production'
            && request.resource.data.get('amount', 0) is number
            && request.resource.data.get('amount', 0) > 0
            && (
              // expense leg (COS – Direct Material) — old clients (no accountType
              // field) and new clients (accountType:'expense') both accepted.
              (request.resource.data.get('type', '') == 'debit'
                && request.resource.data.get('category', '') == 'COS – Direct Material'
                && request.resource.data.get('refNumber', '').matches('POCOS-.*')
                && request.resource.data.get('accountType', 'expense') == 'expense'
                && exists(/databases/$(database)/documents/production_orders/$(pocosOrderId(request.resource.data.get('refNumber','')))))
              ||
              // Inventory contra leg — new clients only.
              (request.resource.data.get('type', '') == 'credit'
                && request.resource.data.get('accountType', '') == 'asset'
                && request.resource.data.get('account', '') == 'Inventory'
                && request.resource.data.get('refNumber', '').matches('POCOS-.*-INV')
                && exists(/databases/$(database)/documents/production_orders/$(pocosOrderId(request.resource.data.get('refNumber','')))))
            ))
      );
      allow update: if isAuth() && canFinance()
        && request.resource.data.get('bankFlow', '') in ['', 'in', 'out']
        && ( ledgerNonMaterialUpdate() || ledgerMaterialUpdateOk() );
      allow delete: if isAuth() && isPresident();
    }
    match /ledger_entries/{docId} {
      allow read: if isAuth() && canFinance();
      allow create, update: if isAuth() && canFinance();
      allow delete: if isAuth() && isPresident();
    }
    // v13 Phase 84 — period-close backstop (RULES side of C6/Phase 13's
    // client-side assertPeriodOpen). Every create/update from the CRJ/CDJ/GJ
    // editors always sends a real 'date' (create forms require it; edit-modal
    // fields always include the date key) so ledgerDateOk()'s format check
    // never blocks a legit write — only a forged/malformed date. expenses and
    // payslips are deliberately NOT covered this pass (their status-transition
    // updates don't carry a date field) — see Phase 84 follow-up note.
    //
    // ⚠ v14 re-audit ROUND 3 — THE GATE ON UPDATE IS NOW TWO-SIDED.
    //
    // The three rules below used to read `resource.data` NOWHERE: they checked
    // only the INCOMING month. Their mirror in /ledger checks BOTH (see
    // ledgerMaterialUpdateOk() above, made two-sided in round 1), so the mirror
    // was strictly STRICTER than its own source and an input existed that the
    // source accepted and the mirror refused:
    //
    //   Finance opens a CLOSED-June CRJ row (they are on screen —
    //   renderCashReceiptJournal lists orderBy date desc limit 100,
    //   js/screens/finance.js), corrects the date to July, saves.
    //     SOURCE  periodOpenFor('2026-07-15')                -> open   -> COMMITTED
    //     MIRROR  ledgerMonthOpen(resource.data.date '2026-06-15') -> closed -> DENIED
    //   Net: cash_receipt_journal/crj1 says July, ledger/CRJ-crj1 (and its
    //   -AR leg) still say June. June's already-FILED P&L and VAT return keep
    //   the row, July never receives it, permanently — and the P&L/VAT read the
    //   LEDGER, never the journal (ledgerForPeriod, js/config.js;
    //   computeVatSummary, js/bir.js). Reproduced on the emulator against the
    //   round-2 rules before this change, not theorised.
    //
    // Only the OUT direction leaked. A move INTO a closed month and an
    // amount-only edit on a row that STAYS in a closed month were already
    // refused by the incoming-side check, which is why this had one shape only.
    //
    // Same fix, same absent-field discipline, as /expenses got in round 2:
    // fail OPEN on a date that cannot be bucketed into a finance_period (absent,
    // malformed, or a Timestamp — .matches() is a STRING method and ERRORS on a
    // Timestamp, and an erroring rule DENIES, which would permanently lock
    // legacy rows out of every edit). `d is string` FIRST, then the format
    // check, then and only then periodOpenFor() — which itself errors on
    // anything it cannot split into a yyyy-mm.
    //
    // CREATE is split out and left byte-for-byte as it was: on a create there
    // is no `resource`, so reading resource.data there would ERROR (= deny)
    // every new journal entry. This is the same reason /expenses' gate lives on
    // its update rule alone.
    //
    // general_journal has no /ledger mirror (it is a legacy, writer-less
    // collection — js/config.js gjForPeriod), but it is read DIRECTLY, merged
    // with the ledger, by the BIR General Journal book (birRenderGJ, js/bir.js)
    // and by renderFinancialReports. Moving one of its rows out of a closed
    // month therefore restates that filed month directly, with no divergence
    // needed. Same gate, same reason.
    function journalMonthOpen(d) {
      return !(d is string)
          || !d.matches('^\\d{4}-\\d{2}(-\\d{2})?$')
          || periodOpenFor(d);
    }
    // Both sides, so a row can be moved neither INTO nor OUT of a closed month.
    // ledgerDateOk() runs first at every call site and short-circuits, so the
    // request-side call here can only ever see a well-formed date; it is written
    // through journalMonthOpen() anyway to stay symmetric with expensePeriodOk()
    // and ledgerMaterialUpdateOk().
    function journalUpdatePeriodOk() {
      return journalMonthOpen(resource.data.get('date', ''))
          && journalMonthOpen(request.resource.data.get('date', ''));
    }
    match /cash_receipt_journal/{docId} {
      allow read: if isAuth() && canFinance();
      allow create: if isAuth() && canFinance() && ledgerDateOk() && periodOpenFor(request.resource.data.get('date', ''));
      allow update: if isAuth() && canFinance() && ledgerDateOk() && journalUpdatePeriodOk();
      allow delete: if isAuth() && isPresident();
    }
    match /cash_disbursement_journal/{docId} {
      allow read: if isAuth() && canFinance();
      allow create: if isAuth() && canFinance() && ledgerDateOk() && periodOpenFor(request.resource.data.get('date', ''));
      allow update: if isAuth() && canFinance() && ledgerDateOk() && journalUpdatePeriodOk();
      allow delete: if isAuth() && isPresident();
    }
    match /general_journal/{docId} {
      allow read: if isAuth() && canFinance();
      allow create: if isAuth() && canFinance() && ledgerDateOk() && periodOpenFor(request.resource.data.get('date', ''));
      allow update: if isAuth() && canFinance() && ledgerDateOk() && journalUpdatePeriodOk();
      allow delete: if isAuth() && isPresident();
    }
    match /finance_records/{docId} {
      allow read: if isAuth() && canFinance();
      allow create, update: if isAuth() && canFinance();
      allow delete: if isAuth() && isPresident();
    }
    match /tax_records/{docId} {
      allow read: if isAuth() && canFinance();
      allow create, update: if isAuth() && canFinance();
      allow delete: if isAuth() && isPresident();
    }
    // Purchase requisitions — the Purchasing department's RFQ → Purchase Request
    // flow (stage: 'rfq' | 'pr'). Purchasing dept maintains them; Finance gets
    // read access to see committed purchases. Draft RFQs are freely deletable by
    // Purchasing; once converted to a PR, only the President may delete.
    // v12 WS30 — PO approval gate: converting sets approvalStatus:'pending';
    // ONLY president/manager may set 'approved'/'rejected'; Purchasing can never
    // self-approve, and can't mark a PO ordered/received until it is approved.
    // Docs converted BEFORE the gate have no approvalStatus at all and are
    // grandfathered — .get(field,'legacy') per the missing-field-throws memory.
    match /purchase_requisitions/{docId} {
      allow read: if isAuth() && (canPurchasing() || canFinance());
      allow create: if isAuth() && canPurchasing();
      allow update: if isAuth() && (
        // (a) Purchasing edits freely EXCEPT the approval verdict: approval
        //     fields are writable here only when the result is 'pending'
        //     (convert / re-convert) or cleared by a revert back to stage 'rfq'
        //     — so a rejected PR can't be laundered into a grandfathered one.
        //     Marking ordered/received requires an approved (or pre-gate) PO.
        (canPurchasing()
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(
                ['approvalStatus','approvedBy','approvedByName','approvedByTitle','approvedAt',
                 'rejectedBy','rejectedByName','rejectedAt','rejectedReason'])
              || request.resource.data.get('approvalStatus','') == 'pending'
              || (request.resource.data.get('approvalStatus','') == ''
                  && request.resource.data.get('stage','pr') == 'rfq'))
          && (!(request.resource.data.get('status','') in ['ordered','received'])
              || resource.data.get('approvalStatus','legacy') in ['approved','legacy']))
        // (b) President/Manager render the verdict — and may touch NOTHING else
        //     in the same write (can't rewrite items/prices under cover of approving).
        || (isSeniorAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['approvalStatus','approvedBy','approvedByName','approvedByTitle','approvedAt',
               'rejectedBy','rejectedByName','rejectedAt','rejectedReason','updatedAt']))
        // (c) Finance may ONLY stamp the bookkeeping fields (unchanged from pre-WS30).
        || (canFinance() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['recordedToFinance','recordedToFinanceAt','recordedBy','recordedByName','cdjEntryId']))
      );
      allow delete: if isAuth() && (isPresident()
        || (canPurchasing() && resource.data.get('stage', 'rfq') == 'rfq'));
    }

    // ── Finance delete requests ────────────────────────
    // Finance staff file a request to delete any finance record; the President
    // approves/denies it (and performs the real delete) in the Approvals tab.
    match /finance_delete_requests/{docId} {
      allow read: if isAuth() && canFinance();
      allow create: if isAuth() && canFinance();
      allow update, delete: if isAuth() && isPresident();
    }

    // ── Bank accounts registry (v12 WS36) ──────────────
    // Master data for the company's cash locations (bank / e-wallet / petty cash).
    // Balances are DERIVED client-side (opening anchor + tagged ledger flows) — no
    // balance field lives here, so nothing a buggy writer could drift. Reads are
    // books-operators only (account numbers are sensitive); create/update is the
    // money tier (matches payroll/pay_runs post-WS19); deletes are President-only —
    // the client routes them through finance_delete_requests like every finance doc.
    match /bank_accounts/{docId} {
      allow read:   if isAuth() && canFinance();
      allow create, update: if isAuth() && isMoneyAdmin()
        && request.resource.data.get('nickname', '') is string
        && request.resource.data.get('nickname', '') != ''
        && request.resource.data.get('openingBalance', 0) is number
        && request.resource.data.get('type', 'bank') in ['bank', 'ewallet', 'cash'];
      allow delete: if isAuth() && isPresident();
    }

    // ── Payslips & Worker profiles (Brilliant Steel) ───
    match /payslips/{docId} {
      // v14 re-audit fix — the two owner branches here were BOTH dead, so a
      // Type-B (weekly, production) worker could never read their own payslip:
      //  • `workerId` is a worker_profiles AUTO-ID (js/screens/hr.js
      //    collectPayslipData writes `workerId: profile.id`), never an auth
      //    uid, so comparing it to request.auth.uid can never be true.
      //  • `linkedUid` is written onto worker_profiles, never onto a payslip —
      //    no payslips writer in the repo sets it — so that branch never fired
      //    either (the old comment called it "harmless if never written"; it
      //    was in fact the only thing standing between the worker and their
      //    pay, which is not harmless).
      // The worker's own dashboard query (js/screens/worker.js
      // _loadWorkerFinance) is therefore permission-denied, and because that
      // .get() is the one member of its Promise.all with no per-promise catch,
      // the rejection blanks the ENTIRE finance half of the only screen a
      // Type-B worker has — from the moment Finance issues their first
      // payslip, i.e. exactly when it starts to matter.
      // Route ownership the same way /attendance_worker already does: through
      // the worker_profiles doc named by `workerId`, comparing ITS linkedUid.
      // the role test stays FIRST so an admin's unfiltered list
      // short-circuits without the profile lookup. Uses the status-free
      // isLinkedWorkerProfile() (not isLinkedWorkerUid) so an offboarded
      // worker can still retrieve their historical payslips.
      // Verified against the emulator: the dashboard's
      // where('workerId','==',<profileId>) + orderBy('createdAt') query and
      // payslipYtdWeekly's workerId + payPeriodStart-range query both prove
      // against this rule; an unfiltered list, another worker's workerId, and
      // a legacy payslip carrying no workerId at all are all still denied.
      allow read: if isAuth() && (
        isMoneyAdmin() ||
        isLinkedWorkerProfile(resource.data.get('workerId', ''))
      );
      // v14 re-audit fix — WS19's money-tier narrowing (see isMoneyAdmin()
      // above) reached payroll/salary_history/salary_raises/pay_runs/
      // bank_accounts but never reached this Type-B leg: the old ops/finance
      // tier included 'secretary', so a Corporate Secretary could issue an
      // official, numbered, worker-visible weekly payslip with no President in
      // the loop. The delete leg below was ALREADY president-only — that is the
      // intent these two legs were missing. Same shape as bank_accounts.
      // 2026-08-09 (owner ruling 2, "they lose … payslips"): the READ is now
      // money-tier too. The worker-ownership branch beside it is untouched, so a
      // Type-B worker still reads their own payslips.
      allow create, update: if isAuth() && isMoneyAdmin();
      allow delete: if isAuth() && isPresident();
    }
    match /worker_profiles/{docId} {
      // v14 Type-B self-service: a linked login account may read ITS OWN
      // profile (the linkedUid lookup the worker dashboard boots from).
      allow read: if isAuth() && (isMoneyAdmin()
        || resource.data.get('linkedUid','') == request.auth.uid);
      // v14 re-audit fix — money-tier, same rationale as payslips above. This
      // doc holds dailyRate/hourlyRate, foodAllowance, allowances.meal/
      // transport and caBalance; foodAllowance is multiplied by days-worked
      // straight into the payslip, and the approval-routed Raise flow fences
      // only some of those fields — so leaving create/update on the old
      // ops/finance tier let secretary set a worker's pay rates outright.
      // 2026-08-09 (owner ruling 2, "they lose … worker pay rates"): the READ is
      // money-tier now as well. The linkedUid self-read branch is untouched.
      allow create, update: if isAuth() && isMoneyAdmin();
      allow delete: if isAuth() && isPresident();
    }
    // ── Worker directory (public-safe roster projection, v12 WS28) ──
    // Mirror of worker_profiles holding ONLY assignment-safe fields (name, ID
    // number, job title, dept, status, photo) so Production staff can pick
    // per-stage workers WITHOUT read access to worker_profiles (rates/CA/SSS/
    // PhilHealth/TIN stay locked to finance/admin). docId == the worker_profiles
    // docId. Maintained by the HR profile save + the Sync Directory button.
    match /worker_directory/{docId} {
      allow read:           if isAuth() && !isPartner();
      // v14 re-audit fix — this mirror is maintained by the SAME HR profile
      // save (and the Sync Directory button) as worker_profiles above, so it
      // moves to the money tier with it; otherwise secretary could still
      // rewrite the roster projection Production picks workers from. Delete is
      // money-tier rather than president-only on purpose: syncWorkerDirectory()
      // (js/screens/hr.js) prunes directory docs whose profile is gone, and
      // that housekeeping must keep working for finance/manager.
      allow create, update: if isAuth() && isMoneyAdmin();
      allow delete:         if isAuth() && isMoneyAdmin();
    }

    // ── Government biddings ────────────────────────────
    match /gov_biddings/{docId} {
      // Government bidding pipeline is internal-only — external partners excluded
      // from reading (null-safe getRole(): null is treated as "not partner").
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && isAdmin();
    }

    // ── Departments config ─────────────────────────────
    // v12 WS19: read locked to !isPartner() — was bare isAuth().
    match /departments/{docId} {
      allow read: if isAuth() && !isPartner();
      allow write: if isAuth() && isAdmin();
    }

    // ── Inventory (raw materials + finished goods) ─────
    // Operational data for internal staff. Item costs are visible to staff;
    // external partners are excluded from reading/writing.
    match /inventory_items/{docId} {
      allow read:  if isAuth() && !isPartner();
      allow write: if isAuth() && !isPartner();
    }
    // Stock movement log — anyone internal can record in/out; only admins edit/delete history.
    match /stock_movements/{docId} {
      allow read:   if isAuth() && !isPartner();
      allow create: if isAuth() && !isPartner();
      allow update, delete: if isAuth() && isAdmin();
    }
    // Job costing carries revenue/margin per project — finance/admin only.
    match /job_costs/{docId} {
      allow read, write: if isAuth() && isMoneyAdmin();
    }

    // ── Production orders (shop-floor pipeline) ─────────
    // v12 WS28: writes scoped to the people who run the pipeline — Production
    // dept (or admins) manage orders; Sales may CREATE one (the "Job Order"
    // button on a project). Two transition gates are enforced server-side so a
    // devtools or stale-SW client can't skip them: entering Out for Delivery
    // needs a PASSED QC record; entering Delivered needs a delivery receipt.
    // Legacy pre-rename ids ('ready') are honoured in the transition checks so
    // routine edits to old docs aren't wrongly gated. Creating an order directly
    // in the last two stages is denied (only reachable through the gates).
    // Reads stay open to all internal staff (dashboards); only admins delete.
    match /production_orders/{docId} {
      allow read:   if isAuth() && !isPartner();
      allow create: if isAuth() && !isPartner() && (canProduction() || inDept('Sales'))
        && request.resource.data.get('stage','') != 'out_for_delivery'
        && request.resource.data.get('stage','') != 'delivered';
      // canProduction() = isAdmin() || isProductionDept(), and isAdmin() still
      // contains 'secretary' — so narrowing the /ledger Production leg to
      // isProductionDept() (leak-fix 2) left the SOURCE open to a secretary
      // while closing the MIRROR. That is the /expenses defect in reverse, and
      // worse: consumeProductionMaterials commits inventory decrements,
      // stock_movements and materialsConsumed:true in ONE transaction FIRST,
      // then posts the ledger legs SEPARATELY and swallows the denial — and
      // materialsConsumed is a one-shot idempotency flag, so the COS debit and
      // the Inventory contra credit could NEVER be posted for that order again.
      // Excluding the secretary here means they cannot start the half-write at
      // all. Nobody else moves: president/manager reach the mirror via
      // canFinance(), Production staff via isProductionDept(), and 'finance'
      // was never in canProduction() to begin with.
      allow update: if isAuth() && !isPartner() && canProduction() && !isSecretary()
        // QC gate — may not ENTER Out for Delivery without a passed inspection
        && ( request.resource.data.get('stage','') != 'out_for_delivery'
             || resource.data.get('stage','') in ['out_for_delivery','ready']
             || request.resource.data.get('qc', {}).get('result','') == 'passed' )
        // DR gate — may not ENTER Delivered without a delivery receipt
        && ( request.resource.data.get('stage','') != 'delivered'
             || resource.data.get('stage','') == 'delivered'
             || request.resource.data.get('deliveryReceipt', null) != null );
      allow delete: if isAuth() && isAdmin();
    }

    // ── Audit log (append-only) ─────────────────────────
    // Who-changed-what trail on sensitive mutations. A signed-in user may APPEND
    // an entry, but ONLY describing THEMSELVES (actorUid == their uid) with their
    // real role (actorRole == getRole()) and a server timestamp (no backdating) —
    // so entries can't be forged in another person's name. Entries are immutable
    // (no update); only the president may prune (e.g. clearing spam). Admins read.
    match /audit_log/{docId} {
      // v12 WS41: a user may list THEIR OWN trail (provable for
      // where('actorUid','==',uid) queries); admins read everything.
      // Create rule already forces actorUid == auth.uid, so "own" is sound.
      allow read:   if isAuth()
        && (isAdmin() || resource.data.get('actorUid','') == request.auth.uid);
      // v14 re-audit fix — action/entity/entityId/details had no size bound at
      // all; an unrate-limited, append-only collection with unbounded fields
      // can be flooded with near-1MB documents by any signed-in account.
      // entityId is nullable (logAudit() writes `entityId || null`); details is
      // a MAP (arbitrary structured payload) — isBoundedString doesn't apply,
      // so it's capped by top-level key count instead as a rough flood guard.
      allow create: if isAuth()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorRole == getRole()
        && request.resource.data.ts == request.time
        && request.resource.data.keys().hasOnly(['ts','action','entity','entityId','details','actorUid','actorName','actorRole'])
        && isBoundedString(request.resource.data.get('action', ''), 100)
        && isBoundedString(request.resource.data.get('entity', ''), 100)
        && (request.resource.data.get('entityId', null) == null
            || isBoundedString(request.resource.data.get('entityId', ''), 200))
        && request.resource.data.get('details', {}) is map
        && request.resource.data.get('details', {}).size() <= 50;
      allow update: if false;
      allow delete: if isAuth() && isPresident();
    }

    // ── Client error log (v13 Phase 8) ──────────────────
    // window.onerror/onunhandledrejection (js/errlog.js) write here so production
    // errors surface without a user report. Any signed-in client may append (the
    // client is often broken/mid-error when it writes, so we don't gate on role),
    // but the field set, sizes, and timestamp are locked down so a compromised/
    // malicious client can't use this as a free-form write channel. uid is
    // optional-but-truthful — same pattern as notifications' senderUid above —
    // since boot-time errors can fire before currentUser exists. Only admins may
    // read or prune; no update (append-only, like audit_log).
    match /error_log/{docId} {
      // v14 re-audit fix — page/version/ua had no size bound at all (only
      // message/stack were capped); same flood risk as audit_log above. All
      // three are always plain strings client-side (js/errlog.js buildPayload).
      allow create: if isAuth()
        && request.resource.data.keys().hasOnly(['message','stack','page','version','uid','ua','ts'])
        && isBoundedString(request.resource.data.get('message', ''), 500)
        && isBoundedString(request.resource.data.get('stack', ''), 2000)
        && isBoundedString(request.resource.data.get('page', ''), 100)
        && isBoundedString(request.resource.data.get('version', ''), 40)
        && isBoundedString(request.resource.data.get('ua', ''), 200)
        && request.resource.data.ts == request.time
        && (!request.resource.data.keys().hasAny(['uid'])
            || request.resource.data.uid == null
            || request.resource.data.uid == request.auth.uid);
      allow read:   if isAuth() && isAdmin();
      allow update: if false;
      allow delete: if isAuth() && isAdmin();
    }

    // ── Leave requests ──────────────────────────────────
    // Employees file their own request (pending only) and read their own;
    // finance/admin read all + approve/reject; only the president deletes.
    match /leave_requests/{docId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || isOpsAdmin()
      );
      // Shape-validate days/userName on every create; an employee may only file
      // their OWN request as pending. Finance/admin may file on anyone's behalf.
      allow create: if isAuth()
        && request.resource.data.days is number
        && request.resource.data.days > 0
        && request.resource.data.days <= 366
        && request.resource.data.userName is string
        && (
          isOpsAdmin() ||
          (request.resource.data.userId == request.auth.uid
            && request.resource.data.status == 'pending')
        );
      // Only finance/admin may mutate a request after it's filed (approve/reject).
      // Employees never update — the client only ever creates — so the owner has
      // no update path (which would otherwise let them tamper post-approval).
      allow update: if isAuth() && isOpsAdmin();
      allow delete: if isAuth() && isPresident();
    }

    // ── Sales orders (won project → payment → finance) ──
    // Anyone internal (incl. partners) can create an order for a project they
    // closed and read their own; finance/admin read all + update (post to books).
    match /sales_orders/{docId} {
      // Internal operational doc: any non-partner staff may read (so a Finance-dept
      // employee — role 'employee', not the special 'finance' role — can see them in
      // the Sales Orders tab). An unfiltered list query was being denied for such
      // users, which is why created orders "weren't reflecting". Partners only see
      // their own. Finance/admin still gate create→record (update).
      allow read:   if isAuth() && (
        resource.data.createdBy == request.auth.uid || !isPartner()
      );
      allow create: if isAuth() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuth() && canFinance();
      allow delete: if isAuth() && isPresident();
    }

    // ── Project lifecycle (the spine: quote→order→production→delivery→paid) ──
    // Internal staff read + manage all; a partner sees only their own BS projects.
    match /job_projects/{docId} {
      // Partner sees projects they created OR shared projects originating from their quote.
      // Partner may NOT edit profit factors — only the project owner / non-partner staff can update.
      allow read:   if isAuth() && (resource.data.createdBy == request.auth.uid || resource.data.partnerUid == request.auth.uid || !isPartner());
      allow create: if isAuth() && request.resource.data.createdBy == request.auth.uid;
      // v12 WS36 — money keys need books access; stage/timeline/documents/tracking
      // edits stay open to internal staff exactly as before (affectedKeys diff, so
      // writes not touching money keys are unaffected).
      allow update: if isAuth() && (resource.data.createdBy == request.auth.uid || !isPartner())
        && ( !request.resource.data.diff(resource.data).affectedKeys().hasAny(
               ['payments', 'amountCollected', 'arBalance', 'invoices', 'dpPercent', 'balanceSchedule'])
             || canFinance() );
      allow delete: if isAuth() && isAdmin();
    }

    // ── Public order tracking (client-facing, PUBLIC read by unguessable token) ──
    // Each doc id is a random 20-char Firestore auto-id acting as an unguessable
    // access token — the shareable client link is /track.html?t={id}. `get` is
    // PUBLIC (no auth) so a client can open the link without an account; `list` is
    // DENIED so nobody can enumerate all orders. Only client-SAFE fields live here
    // (status, dates, amounts the client already knows) — never internal cost/margin.
    // Internal non-partner staff create/update it; admins may delete.
    // v14 sales-pipeline gap fix — a partner converting THEIR OWN won quote into a
    // Sales Order (js/departments.js openSalesOrderModal / window.ensureOrderTracking)
    // already succeeds at creating the sales_orders + job_projects docs (both allow
    // create for any authenticated creator, no partner exclusion), but this doc's
    // create used to be a blanket !isPartner() — silently denied (best-effort
    // try/catch swallows it) for every partner-originated order, so those clients
    // NEVER got a tracking link. Narrow fix: a partner may create a tracking doc
    // ONLY when it points (via `orderId`) at a sales_orders doc THEY THEMSELVES
    // created — never for any other order. `.get(field, default)` throughout so a
    // malformed/missing orderId denies (fails closed) instead of throwing.
    match /order_tracking/{token} {
      allow get:    if true;
      allow list:   if false;
      allow create: if isAuth() && (
        !isPartner()
        || (
          request.resource.data.get('orderId', '') != ''
          && exists(/databases/$(database)/documents/sales_orders/$(request.resource.data.get('orderId', '')))
          && get(/databases/$(database)/documents/sales_orders/$(request.resource.data.get('orderId', ''))).data.get('createdBy', '') == request.auth.uid
        )
      );
      allow update: if isAuth() && !isPartner();
      allow delete: if isAuth() && isAdmin();
    }

    // ── Public client-facing quote mirror (share-with-client) ───────────
    // Each doc id is a 12-char unguessable token; /q/?<token> resolves it.
    // Holds ONLY the sanitized client-safe projection built by
    // buildPublicQuoteDoc() (js/screens/sales.js) — NEVER capital/labor costs,
    // commission, editableState, uids, or client contact details. `get` is
    // PUBLIC (client opens the link with no account); `list` is DENIED (no
    // enumeration). There is NO public write: the client's accept/request-
    // changes goes through the respondToQuote callable (functions/index.js),
    // which bypasses rules via the Admin SDK — so every write rule here is
    // authenticated-staff-only. Partner branch mirrors order_tracking: a
    // partner may mint/maintain a mirror ONLY for a quote THEY created.
    match /public_quotes/{token} {
      allow get:  if true;
      allow list: if false;

      function srcQuote(rd) {
        return get(/databases/$(database)/documents/$(rd.get('src', {}).get('coll', 'bs_quotes'))/$(rd.get('src', {}).get('id', '_none_'))).data;
      }
      function srcIsMine(rd) {
        return rd.get('src', {}).get('coll', '') in ['bs_quotes', 'bk_quotes']
            && rd.get('src', {}).get('id', '') != ''
            && exists(/databases/$(database)/documents/$(rd.get('src', {}).get('coll', ''))/$(rd.get('src', {}).get('id', '')))
            && srcQuote(rd).get('createdBy', '') == request.auth.uid;
      }
      // A staff/partner write may never fabricate or alter a client response:
      // create must start it 'pending'; update must leave it untouched or
      // reset it to 'pending' (deliberate "re-open for response" after a fix).
      function responseUntouchedOrReset() {
        return request.resource.data.get('clientResponse', {}).get('status', 'pending') == 'pending'
            || request.resource.data.get('clientResponse', {}) == resource.data.get('clientResponse', {});
      }

      allow create: if isAuth()
        && request.resource.data.get('clientResponse', {}).get('status', '') == 'pending'
        && (!isPartner() || srcIsMine(request.resource.data));
      allow update: if isAuth()
        && responseUntouchedOrReset()
        && (!isPartner() || (srcIsMine(resource.data) && srcIsMine(request.resource.data)));
      allow delete: if isAuth()
        && (!isPartner() || srcIsMine(resource.data));
    }

    // ── Public ID verification (QR scan target, WS27) ───
    // Each doc id is an unguessable token; the public /v/?<token> page resolves
    // it. Holds ONLY a public-safe projection (name/photo/id-no/dept/title/
    // status) — NEVER SSS/PhilHealth/TIN/rates/CA/address/phone/email, which
    // stay in worker_profiles/users. `get` public, `list` denied (no enumeration).
    match /id_verify/{token} {
      allow get:  if true;
      allow list: if false;
      // v14 re-audit fix — the self-mint branch used to accept ANY fields once
      // kind=='employee' and uid==caller, so a regular employee could claim
      // title:'President'/department:'Finance'/status:'active' on this PUBLIC,
      // unauthenticated-readable card. Mirrors buildIdVerifyDoc() (js/app.js)
      // field-for-field so a self-mint can only ever be a faithful projection
      // of the caller's OWN users/{uid} doc. HR/finance mints (worker cards,
      // which have no matching users doc at all) stay fully trusted/unrestricted.
      function selfMintMatchesCaller() {
        let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        let d = request.resource.data;
        let realName   = u.get('displayName', '') != '' ? u.get('displayName', '') : u.get('name', '');
        let realId     = u.get('employeeId', '') != '' ? u.get('employeeId', '') : u.get('idNumber', '');
        let realTitle  = u.get('title', '') != '' ? u.get('title', '') : u.get('jobTitle', '');
        let realStatus = u.get('status', '') == 'inactive' ? 'inactive' : 'active';
        let realDepts  = u.get('departments', []).size() > 0
          ? u.get('departments', [])
          : (u.get('department', '') != '' ? [u.get('department', '')] : []);
        let deptStr    = d.get('department', '');
        let deptTokens = deptStr == '' ? [] : deptStr.split(', ');
        return d.get('name', '')     == realName
            && d.get('idNumber', '') == realId
            && d.get('jobTitle', '') == realTitle
            && d.get('status', '')   == realStatus
            && d.get('photoUrl', '') == u.get('photoUrl', '')
            && realDepts.hasAll(deptTokens);
      }
      allow create, update: if isAuth() && !isPartner() && (
        isOpsAdmin() ||                                     // HR mints worker + employee cards
        ( request.resource.data.get('kind','') == 'employee'      // employee self-mints OWN card only
          && request.resource.data.get('uid','') == request.auth.uid
          && selfMintMatchesCaller() )
      );
      allow delete: if isAuth() && isAdmin();
    }

    // ── Leave balances (remaining day counters per user) ─
    // Kept in their own collection (NOT on the users doc) so finance can set
    // balances without being granted broad write access to user profiles.
    // The owner reads their own balance; finance/admin read all + write.
    match /leave_balances/{uid} {
      allow read:  if isAuth() && (isOwner(uid) || isOpsAdmin());
      // Shape-guard so a buggy accrual run can't write NaN/negative/wrong-typed counters.
      // .get(field,default) — a missing field must not deny the rule (missing-field-throws memory).
      allow write: if isAuth() && isOpsAdmin()
        && isNonNegNumber(request.resource.data.get('vacation', 0))
        && isNonNegNumber(request.resource.data.get('sick', 0));
    }

    // ── Leave accruals (annual grant idempotency key + forfeiture audit) ─
    // docId = {uid}_{YYYY}. Owner reads own history; finance/admin read all +
    // write (grant runs in admin context — employees never write). President-only delete.
    match /leave_accruals/{docId} {
      allow read:   if isAuth() && (resource.data.get('uid','') == request.auth.uid || isOpsAdmin());
      allow create: if isAuth() && isOpsAdmin()
        && isNonNegNumber(request.resource.data.get('grantedVacation', 0))
        && isNonNegNumber(request.resource.data.get('grantedSick', 0));
      allow update: if isAuth() && isOpsAdmin();
      allow delete: if isAuth() && isPresident();
    }

    // ── Suggestions ────────────────────────────────────
    match /suggestions/{docId} {
      allow read: if isAuth() && isAdmin();
      allow create: if isAuth();
      allow update, delete: if isAuth() && isAdmin();
    }

    // ── Client CRM — UNIFIED (v12 WS32) ────────────────
    // ONE `clients` collection (brands[] tags Sales/Design/BS membership); the
    // three per-brand books below are read-only archives kept for the audit
    // trail. INTERNAL-ONLY: partners never read/write the client book — their
    // Client Data view derives from their own bs_quotes (already partner-scoped).
    // This deliberately closes the old hole where any BS partner could read the
    // ENTIRE bs_clients book. create/update require a non-empty string name via
    // .get(field,default) (missing-field-throws memory); note request.resource.data
    // is the full post-write doc, so field-patch updates still pass. DELETE is
    // admin-only — everyone else uses the deleteRequested flag (President queue).
    match /clients/{docId} {
      allow read:   if isAuth() && !isPartner();
      allow create, update: if isAuth() && !isPartner()
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '') != '';
      allow delete: if isAuth() && isAdmin();
    }
    // Legacy archives (records-forever directive): staff read, admin-only write
    // (migration stamps `migratedTo`), nothing else. Partner read of bs_clients
    // is REMOVED — no partner-facing code ever read it (grep-verified WS32 brief).
    match /sales_clients/{docId}  { allow read: if isAuth() && !isPartner(); allow write: if isAuth() && isAdmin(); }
    match /design_clients/{docId} { allow read: if isAuth() && !isPartner(); allow write: if isAuth() && isAdmin(); }
    match /bs_clients/{docId}      { allow read: if isAuth() && !isPartner(); allow write: if isAuth() && isAdmin(); }

    // ── Dynamic / runtime-named collections ────────────
    // The app creates per-scope and per-dept collections at runtime whose names
    // are not known ahead of time, so they can't be matched by literal name:
    //   files_<scope>  — uploaded documents (every Files tab, all depts)
    //   budgets_<dept> — budget allocation lines (Budgeting screens)
    // Firestore does NOT match collections by prefix, so cover each family with
    // a single-segment wildcard guarded by coll.matches(...). This only grants
    // access for those families; all explicitly-named collections above keep
    // their own (stricter) rules via the permissive union of matching rules.
    //
    // ⚠ WARNING — union-permit trap: Firestore grants a request if ANY match
    // block for that path evaluates to true. That means ANY future collection
    // whose name literally starts with "files_" or "budgets_" is automatically
    // covered by the two wildcard blocks below (coll.matches('files_.*') /
    // coll.matches('budgets_.*')), even if you intend it to be a separate,
    // more-restricted collection — there is no way to "opt out" a same-prefixed
    // collection from these rules. Before naming a new collection with either
    // prefix, check whether the files_*/budgets_* read/write semantics below
    // are actually what you want for it (see the Files Hub comment below for
    // the pattern of deliberately AVOIDING the files_ prefix to escape this).
    match /{coll}/{docId} {
      // Files: readable by internal staff; you own what you upload; owner/admin
      // edit or remove. v12 WS19: added !isPartner() — a files_* doc's `url`
      // field is a token-bearing Storage download link (js/drive.js), so letting
      // the external partner read it was a full file-content exfiltration path,
      // not just a metadata leak. Internal cross-department read stays open
      // (per-dept scoping would need a schema migration — deferred).
      allow read:   if isAuth() && coll.matches('files_.*') && !isPartner();
      allow create: if isAuth() && coll.matches('files_.*') && !isPartner()
                    && request.resource.data.uploadedBy == request.auth.uid;
      allow update, delete: if isAuth() && coll.matches('files_.*') && !isPartner()
                    && (resource.data.uploadedBy == request.auth.uid || isAdmin());
    }
    match /{coll}/{docId} {
      // Budget lines: internal planning data. v12 WS19: this was a genuine
      // world-write (any signed-in account, including a partner, could
      // create/update/delete ANY department's budget lines) — the UI's dept/
      // finance gating was cosmetic only. Read stays broad for internal staff;
      // write narrowed to money-tier (true per-department member-write would
      // need a fragile dept-string parse — deferred, finance/admin is the safe
      // close of the hole now).
      allow read:  if isAuth() && coll.matches('budgets_.*') && !isPartner();
      // v12 WS34: widened so a dept member can manage their OWN department's
      // budget lines (renderBudgeting's canEdit gate always showed them these
      // buttons; the rule silently denied — this closes that gap). Legacy lines
      // (no `dept` field) stay money-admin-only: .get('dept','') → inDept('')
      // is false, no backfill needed. create checks the incoming doc;
      // update/delete check the EXISTING doc so a member can't re-dept a line.
      allow create: if isAuth() && coll.matches('budgets_.*')
        && ( isMoneyAdmin()
          || (!isPartner() && inDept(request.resource.data.get('dept',''))) );
      allow update, delete: if isAuth() && coll.matches('budgets_.*')
        && ( isMoneyAdmin()
          || (!isPartner() && inDept(resource.data.get('dept',''))) );
    }

    // ── Files Hub (WS38) — unified file metadata + folder tree ─────────
    // Deliberately NOT named files_*: the files_.* wildcard above would
    // union-grant all-internal read and defeat per-file visibility/sharing.
    // Sharing enforcement uses ONLY uid arrays (sharedUserIds/editorUserIds)
    // — the canonical `uid in array` + array-contains-query pattern that
    // Firestore can prove for list queries. Dept/role shares are expanded
    // to uids client-side at share time. All .get(field, default) per the
    // missing-field-throws memory (migrated docs predate some fields).
    match /hub_files/{fileId} {
      allow read: if isAuth() && (
           isAdmin()
        || resource.data.get('uploadedBy','') == request.auth.uid
        || request.auth.uid in resource.data.get('sharedUserIds', [])
        || (!isPartner() && resource.data.get('visibility','company') == 'company')
      );
      allow create: if isAuth() && !isPartner()
        && request.resource.data.get('uploadedBy','') == request.auth.uid
        && request.resource.data.get('visibility','company') in ['company','private']
        && request.resource.data.get('deleted', false) == false;
      // Owner/admin: any update (incl. sharing/visibility). Editors: content &
      // organization fields only — NEVER the ACL/ownership fields.
      allow update: if isAuth() && (
           isAdmin()
        || resource.data.get('uploadedBy','') == request.auth.uid
        || (request.auth.uid in resource.data.get('editorUserIds', [])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                 ['name','description','fileType','folderId','archived',
                  'deleted','deletedAt','deletedBy',
                  'url','driveUrl','size','contentType','versions','currentV',
                  'updatedAt']))
      );
      // Permanent delete = president only (Recycle Bin soft-delete/restore are updates).
      allow delete: if isAuth() && isPresident();
    }
    match /hub_folders/{folderId} {
      allow read:   if isAuth() && !isPartner();
      allow create: if isAuth() && !isPartner()
        && request.resource.data.get('createdBy','') == request.auth.uid;
      allow update, delete: if isAuth() && !isPartner()
        && (resource.data.get('createdBy','') == request.auth.uid || isAdmin());
    }
  }
}
