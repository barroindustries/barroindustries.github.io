# Dependencies (installed via npm / deployed by Firebase — never commit)
node_modules/
functions/node_modules/
scripts/node_modules/

# OS / editor cruft
.DS_Store
**/.DS_Store
*.log

# release.sh's per-machine record of what was last deployed to Firebase
.deploy-state

# Local env / secrets — never commit service-account keys
.env
.env.*
*serviceAccount*.json
firebase-debug.log
.firebase/

# Session scratch — verification harnesses, bisect copies, BEFORE/AFTER diffs.
# Root-anchored on purpose: only repo-root probe files are scratch by convention.
/_*.html
/__*.html
/modaltest*.html
/kb-probe.html
*.bak
*.BEFORE.js
*.AFTER.js
*.BEFORE.css
*.AFTER.css
/css/styles-orig-verify.css
/css/css/
/dev/_*
# Quarantined debris awaiting deletion (see dev/README.md)
/dev/_attic/

# Product catalogue — REMOVED FROM THE REPO 2026-09-26 (owner ruling).
# This repo is PUBLIC and GitHub Pages serves every file verbatim, so this file
# was exposing 165 base prices, the per-mm pricing formulas, the markup
# multipliers by segment (retail/commercial/government) and staff day rates at
# a guessable URL. Firestore's `products` collection is the live source (170
# docs, seeded); costs live in `product_costs`, which firestore.rules restricts
# to finance/admin. The private master copy is ~/Desktop/barro-private/.
products-database.json

# PRIVATE price-bearing local output — NEVER commit (this repository is public).
# scripts/derive-family-pricing.js writes the derived starting values for the product-family option sheets here
# (private/family-pricing.seed.json); the owner imports it from the app, it is never read from the repo.
/private/

# CONFIDENTIAL — untracked 2026-10-28 (audit C1). The repo is PUBLIC and Pages serves
# every tracked file, so these were downloadable at barroindustries.com. The files stay
# on disk (local `npx serve` still serves them, e.g. for the one-time price-list / CRM
# seed buttons); they are just never published again.
/data/
/specs/
/archive/
/partners/
/parterns/
# Spreadsheet / data exports and merge debris never belong in a public repo
*.xlsx
*.xls
*.csv
*.orig
*.rej
