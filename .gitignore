# Dependencies (installed via npm / deployed by Firebase — never commit)
node_modules/
functions/node_modules/
scripts/node_modules/

# OS / editor cruft
.DS_Store
**/.DS_Store
*.log

# release.sh's per-machine record of what was last deployed to Firebase
.deploy-state

# Local env / secrets — never commit service-account keys
.env
.env.*
*serviceAccount*.json
firebase-debug.log
.firebase/

# Session scratch — verification harnesses, bisect copies, BEFORE/AFTER diffs.
# Root-anchored on purpose: only repo-root probe files are scratch by convention.
/_*.html
/__*.html
/modaltest*.html
/kb-probe.html
*.bak
*.BEFORE.js
*.AFTER.js
*.BEFORE.css
*.AFTER.css
/css/styles-orig-verify.css
/css/css/
/dev/_*
# Quarantined debris awaiting deletion (see dev/README.md)
/dev/_attic/

# Product catalogue — REMOVED FROM THE REPO 2026-09-26 (owner ruling).
# This repo is PUBLIC and GitHub Pages serves every file verbatim, so this file
# was exposing 165 base prices, the per-mm pricing formulas, the markup
# multipliers by segment (retail/commercial/government) and staff day rates at
# a guessable URL. Firestore's `products` collection is the live source (170
# docs, seeded); costs live in `product_costs`, which firestore.rules restricts
# to finance/admin. The private master copy is ~/Desktop/barro-private/.
products-database.json
