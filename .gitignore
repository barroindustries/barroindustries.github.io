# Dependencies (installed via npm / deployed by Firebase — never commit)
node_modules/
functions/node_modules/
scripts/node_modules/

# OS / editor cruft
.DS_Store
**/.DS_Store
*.log

# release.sh's per-machine record of what was last deployed to Firebase
.deploy-state

# Local env / secrets — never commit service-account keys
.env
.env.*
*serviceAccount*.json
firebase-debug.log
.firebase/

# Session scratch — verification harnesses, bisect copies, BEFORE/AFTER diffs.
# Root-anchored on purpose: only repo-root probe files are scratch by convention.
/_*.html
/__*.html
/modaltest*.html
/kb-probe.html
*.bak
*.BEFORE.js
*.AFTER.js
*.BEFORE.css
*.AFTER.css
/css/styles-orig-verify.css
/css/css/
/dev/_*
# Quarantined debris awaiting deletion (see dev/README.md)
/dev/_attic/
