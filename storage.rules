rules_version = '2';

// ═══════════════════════════════════════════════════════════════════
//  BARRO INDUSTRIES — Cloud Storage Security Rules
//
//  SECURITY MODEL
//  --------------
//  • Deny by default. Nothing is readable or writable unless a rule
//    below explicitly allows it.
//  • Every read and write requires an authenticated user.
//  • ROLE / DEPARTMENT SCOPING via custom claims. Storage rules cannot
//    read Firestore, so the syncUserClaims Cloud Function mints each
//    user's role + departments onto their Auth token. We read them here
//    as request.auth.token.role / request.auth.token.departments:
//      – Finance/payslips (transfer proofs)  → finance tier ONLY.
//      – Other Finance/* (receipts, ledger, taxes, collections, …) →
//        readable/modifiable by internal staff, NOT the external
//        partner; overwrite/delete restricted to the finance tier so a
//        non-finance staffer can file a receipt but can't tamper with
//        or destroy existing financial files.
//      – Other department folders → internal staff only (the external
//        Brilliant Steel partner is excluded), with the partner still
//        allowed into folders that ARE one of their own departments.
//      – profile-photos stay owner-scoped; tasks/posts/General stay
//        collaborative (company-wide).
//      – THE CORPORATE SECRETARY BOUNDARY (owner ruling, closed in
//        firestore.rules 2026-08-09 and here 2026-08-10): role
//        'secretary' has company-wide access EXCEPT Finance and IT.
//        Storage enforces that on Finance/*, IT/* and the dept_Finance
//        / dept_IT chat-file paths. The exclusion is always written on
//        the ROLE, never left to department membership, because the
//        ruling is that an assignment must never beat the role
//        decision — a secretary handed the Finance or IT department
//        still gets nothing. Conversely Ventures is opened to them BY
//        ROLE, so their assigned Ventures review works without anyone
//        remembering to assign the department.
//
//  WHY "internal (non-partner)" RATHER THAN STRICT PER-DEPT MEMBERSHIP
//  ------------------------------------------------------------------
//  Many first-path segments are NOT real department keys — "General"
//  (All Company Files), Government-Biddings section titles, tasks,
//  posts. A strict "members of that department only" gate would deny
//  legitimate internal uploads/reads to those folders and break the
//  app. The concrete threat closed here is the EXTERNAL partner role
//  reading/overwriting/deleting internal (esp. financial) files, plus
//  locking payslip transfer proofs to finance.
//
//  NOTE ON DOWNLOAD URLS: getDownloadURL() is a READ. After an upload
//  the app immediately fetches the file's URL, so the uploader must
//  retain read on that path. Expense receipts are uploaded by internal
//  staff (non-partner) into Finance/* — covered by the "internal read"
//  rule. Payslip proofs are uploaded only by finance — covered by the
//  finance-tier rule. So no legitimate upload flow is broken.
//
//  PATHS IN USE (see js/drive.js, js/departments.js, js/app.js)
//  ------------------------------------------------------------
//    profile-photos/{uid}                       — uploadProfilePhoto
//    task-comments/{docId}/{file}               — task comment files
//    Finance/payslips/{file}                    — payslip transfer proofs
//    Finance/{Receipts|Taxes|Ledger|…}/{file}   — financial docs
//    quote-photos/{quoteRef}/{file}             — quote-builder-v2 photo attachments
//    {department}/{subfolder}/{file}            — dept uploads, gov, Files
//    tasks|posts|General/{subfolder}/{file}     — collaborative
// ═══════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    // ── Auth + size helpers ──────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isValidImage() {
      return request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    // v14 re-audit fix — this used to only check size, unlike isValidImage()
    // (which also pins contentType to image/.*). Every "document" upload path
    // (Finance/*, tasks, posts, general/General, task-comments, chat-files,
    // department folders) accepted ANY MIME type, including HTML/SVG/
    // executables, with no allow/deny list at all. A strict allowlist would
    // risk rejecting a legitimate PDF/Office/zip/etc. variant this app
    // already relies on, so this is a denylist of the concrete XSS/executable
    // vectors instead — additive, doesn't narrow any currently-working upload.
    function isValidDocument() {
      return request.resource.size <= 25 * 1024 * 1024
        && !request.resource.contentType.matches('text/html.*')
        && !request.resource.contentType.matches('application/xhtml.*')
        && !request.resource.contentType.matches('image/svg.*')
        && !request.resource.contentType.matches('application/javascript.*')
        && !request.resource.contentType.matches('text/javascript.*')
        && !request.resource.contentType.matches('application/x-msdownload.*')
        && !request.resource.contentType.matches('application/x-executable.*')
        && !request.resource.contentType.matches('application/x-sh.*')
        && !request.resource.contentType.matches('application/x-shellscript.*');
    }

    // ── Custom-claim accessors (minted by syncUserClaims) ──
    // A missing custom claim reads as null on the token (it does NOT throw,
    // unlike a missing Firestore field), so scalar comparisons are safe. The
    // `departments` claim is a list — guard against null before `in`.
    function claimRole() {
      return request.auth.token.role;
    }
    function hasClaimDept(dept) {
      return request.auth.token.departments != null
        && dept in request.auth.token.departments;
    }
    function isAdminClaim() {
      return claimRole() == 'president' || claimRole() == 'manager';
    }
    // Finance tier mirrors firestore.rules isFinanceOrAdmin() + Finance-dept.
    function isFinanceClaim() {
      // 2026-08-09 — ruling 3 ("the role decision always wins") has to hold on
      // BOTH rule files. The ROLE list already excludes 'secretary', but the DEPT
      // leg did not: syncUserClaims stamps {role, departments} into the Auth
      // custom claims this file trusts, so a secretary whose profile is ever
      // given the Finance department would get Finance STORAGE back even though
      // firestore.rules denies them Finance everywhere else. Same exclusion,
      // same reasoning, same place in the predicate.
      return claimRole() == 'president'
        || claimRole() == 'manager'
        || claimRole() == 'finance'
        || (claimRole() != 'secretary' && hasClaimDept('Finance'));
    }
    function isPartnerClaim() {
      return claimRole() == 'partner';
    }
    // A user may reach a department folder if they're an admin, or it's one of
    // their own departments.
    function isMemberOf(dept) {
      return isAdminClaim() || hasClaimDept(dept);
    }

    // Top-level segments handled by their own dedicated rules below; the broad
    // {department} rule must EXCLUDE them, because Firebase unions (ORs)
    // overlapping matches — a broad allow would otherwise loosen the strict
    // ones (e.g. let a non-finance user read Finance/payslips).
    function isReservedTop(seg) {
      // 'Ventures' is reserved (2026-08-08) so brief attachments do NOT fall to
      // the generic department block, which is readable — and, since read covers
      // list, ENUMERABLE — by any internal non-partner staffer. Without this the
      // Firestore record would be Ventures-only while the file it points at was
      // company-wide, which defeats the point of the restriction.
      // 'IT' is reserved (2026-08-10) for the same reason, one ruling later. The
      // 2026-08-09 pass closed IT to the Corporate Secretary in firestore.rules
      // (canIt() = !isSecretary() && canDept('IT')) but never came here, and 'IT'
      // is a perfectly ordinary department key — js/app.js's Files tab writes
      // IT/Personal/* and IT/Shared/* — so it fell straight through to the
      // generic {department} block, which admits ANY internal non-partner. It now
      // has its own block below; a reserved segment with no block of its own is a
      // deny-all, so the two edits are a pair and neither is optional.
      return seg == 'Finance' || seg == 'Ventures' || seg == 'IT'
        || seg == 'tasks' || seg == 'posts'
        || seg == 'general' || seg == 'General'
        || seg == 'profile-photos' || seg == 'task-comments'
        || seg == 'chat-files' || seg == 'quote-photos'
        || seg == 'attendance-selfies';
    }

    // ── Attendance selfies (v14 Type-B geofenced time-in) ──
    // Own-uid create only, must be a valid image; worker + finance/admin read;
    // only admins may replace/delete (audit trail).
    match /attendance-selfies/{uid}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isFinanceClaim() || isAdminClaim());
      allow create: if isSignedIn() && request.auth.uid == uid
        && (request.resource == null || isValidImage());
      allow update, delete: if isSignedIn() && isAdminClaim();
    }

    // ── Profile photos — owner-scoped writes ─────────
    // Anyone signed in may read (avatars appear app-wide); only the owning uid
    // may upload/replace/delete, and uploads must be valid images.
    match /profile-photos/{uid}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && (request.resource == null || isValidImage());
    }
    match /profile-photos/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && (request.resource == null || isValidImage());
    }

    // ── Worker ID photos — HR-uploaded (WS27; NOT uid-owned, worker has no auth uid) ──
    // Read: any signed-in staff (photo shows on the ID card + verify page).
    // Write: finance tier only (HR uploads on the worker's behalf); valid image.
    // Note: getDownloadURL() on this path returns a token-bearing URL that gets
    // stored in the PUBLIC id_verify.photoUrl — intentional, the ID photo is
    // public-by-design (printed on a physical card, shown on the verify page).
    match /worker-id-photos/{profileId}/{allPaths=**} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn() && isFinanceClaim()
        && (request.resource == null || isValidImage());
    }

    // ── Task comment attachments (collaborative) ─────
    match /task-comments/{docId}/{fileName} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.resource == null || isValidDocument());
      allow update, delete: if isSignedIn() && isOwnerOrAdmin();
    }

    // ── Team Chat attachments (v12 WS37) ─────────────
    // Storage rules cannot read Firestore, so per-conversation participant
    // checks are impossible here. Model: access truth lives on the Firestore-
    // gated message doc that carries the URL. Direct GET is open to any
    // signed-in user, but LIST is forbidden — DM conversation ids are
    // derivable from uids (dm_{a}_{b}), so enumeration must be blocked; the
    // Date.now()-prefixed filename keeps full paths unguessable.
    //
    // 2026-08-10 sweep — one exception to "direct GET is open to any signed-in
    // user". The department channels' conversation ids are literally
    // 'dept_<Department>' (js/chat.js builds `'dept_' + dept`), so dept_Finance
    // and dept_IT are the one set of convIds that are NOT unguessable, and they
    // are exactly the two channels firestore.rules' deptChannelOpen() keeps the
    // Corporate Secretary out of. The filename still has to be guessed, so this
    // was never wide open — but the Storage half should say what the Firestore
    // half says rather than lean on the filename. No legitimate flow is lost:
    // the message doc that carries the URL is denied to them anyway.
    function chatConvOpenToMe(convId) {
      return claimRole() != 'secretary'
        || (convId != 'dept_Finance' && convId != 'dept_IT');
    }
    match /chat-files/{convId}/{fileName} {
      allow get:  if isSignedIn() && chatConvOpenToMe(convId);
      allow list: if false;
      allow create: if isSignedIn() && chatConvOpenToMe(convId)
        && (request.resource == null || isValidDocument());
      allow update, delete: if isSignedIn() && isOwnerOrAdmin();
    }

    // ── Finance / payslips — transfer proofs (crown jewels) ──
    // Bank screenshots of worker pay. Finance tier only, for read AND write.
    // Created exclusively by finance, so the post-upload getDownloadURL() the
    // app performs is done by a user who already has read.
    match /Finance/payslips/{fileName} {
      allow read: if isSignedIn() && isFinanceClaim();
      allow write: if isSignedIn() && isFinanceClaim()
        && (request.resource == null || isValidDocument());
    }

    // ── Finance / everything else (receipts, taxes, ledger, …) ──
    // (subfolder != 'payslips' so this never loosens the rule above.)
    //  • read  → internal staff (non-partner). Lets an employee retrieve the
    //            URL of the receipt they just filed; blocks the partner.
    //  • create (new object) → internal staff. Employees file expense receipts.
    //  • overwrite/delete (existing object) → finance tier only — a non-finance
    //    staffer can add a file but can't tamper with or destroy existing ones.
    //
    //  2026-08-10 — the Corporate Secretary exclusion. The 2026-08-09 pass added
    //  `claimRole() != 'secretary'` to isFinanceClaim()'s DEPT leg, which closed
    //  the payslip folder and the overwrite/delete tier — but this block never
    //  calls isFinanceClaim() on the read or create path at all, so the one rule
    //  that most needed the ruling was left as `!isPartnerClaim()`: every scanned
    //  receipt, BIR filing, ledger scan and SSS/government document under
    //  Finance/* stayed readable, and new objects droppable, by that role. Owner
    //  ruling: Finance is closed to the Corporate Secretary, and a department
    //  assignment must never beat the role decision — so the conjunct is on the
    //  ROLE, stated on read and write alike. Nobody else is touched: Finance
    //  staff, the president and a manager all keep the finance tier, and an
    //  ordinary employee filing an expense receipt is not a secretary.
    // Not every subfolder under Finance/ belongs to Finance. Two OPERATIONAL
    // screens file their attachments here and are owned by other departments:
    //   Finance/SalesOrders  — Sales > Create Sales Order   (js/departments.js:3163)
    //   Finance/Collections  — Production > Collections     (js/screens/production.js:847)
    // Those are a receipt stapled to a sales order and a proof-of-payment
    // stapled to a collection — the operational record, not Finance's own
    // filings. Blocking the Corporate Secretary from them broke two screens they
    // are entitled to use, which is the opposite of what the boundary is for.
    // Everything else here — Taxes, Ledger, Records, payslips, and the SSS/Gov
    // and Accounting archives the Files Hub used to hand out — stays closed.
    function financeOperationalSubfolder(sub) {
      return sub == 'SalesOrders' || sub == 'Collections';
    }
    function financeTreeOpenToCaller(sub) {
      return claimRole() != 'secretary' || financeOperationalSubfolder(sub);
    }
    match /Finance/{subfolder}/{fileName} {
      allow read: if isSignedIn() && subfolder != 'payslips' && !isPartnerClaim()
        && financeTreeOpenToCaller(subfolder);
      allow write: if isSignedIn() && subfolder != 'payslips' && !isPartnerClaim()
        && financeTreeOpenToCaller(subfolder)
        && (request.resource == null || isValidDocument())   // size cap on writes
        && (resource == null || isFinanceClaim());           // overwrite/delete → finance
    }

    // ── Collaborative, company-wide folders ──────────
    // Task/post attachments, the "All Company Files" tab (dept 'General') and
    // generic support-document uploads — readable/writable by any signed-in
    // user by design.
    // Ownership on update/delete (H4): the uploader or an admin may overwrite
    // or destroy an existing object. Legacy blobs (uploaded before this
    // metadata existed) carry no 'uploadedBy' key at all — 'x in map.keys()'
    // is the documented Storage-rules-safe way to test key presence without
    // throwing, so legacy objects fall through to admin-only.
    function isOwnerOrAdmin() {
      return isAdminClaim()
        || ('uploadedBy' in resource.metadata.keys()
              && resource.metadata.uploadedBy == request.auth.uid);
    }

    match /tasks/{subfolder}/{fileName} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.resource == null || isValidDocument());
      allow update, delete: if isSignedIn() && isOwnerOrAdmin();
    }
    match /posts/{subfolder}/{fileName} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.resource == null || isValidDocument());
      allow update, delete: if isSignedIn() && isOwnerOrAdmin();
    }
    match /general/{subfolder}/{fileName} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.resource == null || isValidDocument());
      allow update, delete: if isSignedIn() && isOwnerOrAdmin();
    }
    match /General/{subfolder}/{fileName} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.resource == null || isValidDocument());
      allow update, delete: if isSignedIn() && isOwnerOrAdmin();
    }

    // ── Quote-builder photo attachments (see specs/quote-builder-photos-spec.md) ──
    // Attached from quote-builder-v2 (Sales staff AND the external partner both
    // file quotes), so any signed-in user may upload/read. Images only.
    match /quote-photos/{quoteRef}/{fileName} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.resource == null || isValidImage());
      allow update, delete: if isSignedIn() && isOwnerOrAdmin();
    }

    // ── Other department folders ─────────────────────
    // Sales, Marketing, Design, IT, Admin, Production, Brilliant Steel, plus
    // gov-section-title and Files-tab folders. Internal staff get full
    // cross-department access; the external partner is excluded UNLESS the
    // folder is one of their own departments (e.g. their Brilliant Steel space).
    // Reserved top-level segments are excluded so their stricter rules win.
    // ── Ventures brief attachments (2026-08-08) ─────────────────────────────
    // 'Ventures' is in isReservedTop(), so the generic {department} block below
    // deliberately does NOT cover it — that block is readable (and, since read
    // covers list, ENUMERABLE) by any internal non-partner staffer, which would
    // have left the Firestore record Ventures-only while the file it points at
    // was company-wide. This block restores access, scoped: department members
    // and admins only, partners never. isMemberOf() reads the Auth CUSTOM CLAIM
    // (syncUserClaims), not the users doc — Storage rules cannot read Firestore.
    //
    // 2026-08-10 — the two rule files disagreed about who an "admin" is, and
    // Ventures is where that bit. firestore.rules' isAdmin() is
    // president|manager|secretary, so canDept('Ventures') already lets the
    // Corporate Secretary read, create, edit and delete a venture brief. Here
    // isAdminClaim() is president|manager ONLY — deliberately, because it is also
    // the gate on attendance-selfie overwrite and on isOwnerOrAdmin(), and
    // widening it would loosen both by accident. So the secretary passed neither
    // leg of isMemberOf('Ventures') and the ref.put() of the brief's supporting
    // document was refused, while the brief itself saved fine: "review Ventures",
    // one of the three tasks assigned to the role, half-failed. Fixed by ROLE
    // rather than by department so it holds whether or not they are ever assigned
    // the Ventures department — the owner should not have to remember.
    function isVenturesMember() {
      return isMemberOf('Ventures') || claimRole() == 'secretary';
    }
    match /Ventures/{subfolder}/{fileName} {
      allow read: if isSignedIn() && !isPartnerClaim() && isVenturesMember();
      allow write: if isSignedIn() && !isPartnerClaim() && isVenturesMember()
        && (request.resource == null || isValidDocument());   // size cap on writes
    }

    // ── IT department folders (2026-08-10) ──────────────────────────────────
    // 'IT' is now in isReservedTop(), so the generic {department} block below
    // skips it — and a reserved segment with no block of its own is a DENY-ALL,
    // which would lock the IT department out of its own files. This block is
    // therefore mandatory, not optional. It carries the same three verbs and the
    // same isOwnerOrAdmin() ownership test as the generic block, so nothing about
    // how IT staff use their folder changes; what changes is WHO reaches it —
    // members and admins, never the Corporate Secretary. The explicit role
    // conjunct sits on top of isMemberOf() because isMemberOf() would otherwise
    // let an IT department assignment hand the role back what the role decision
    // took away (owner ruling: assignment never beats the role), exactly the
    // back door isFinanceClaim() closed on 2026-08-09.
    match /IT/{subfolder}/{fileName} {
      allow read: if isSignedIn() && !isPartnerClaim()
        && claimRole() != 'secretary' && isMemberOf('IT');
      allow create: if isSignedIn() && !isPartnerClaim()
        && claimRole() != 'secretary' && isMemberOf('IT')
        && (request.resource == null || isValidDocument());
      allow update, delete: if isSignedIn() && !isPartnerClaim()
        && claimRole() != 'secretary' && isMemberOf('IT')
        && isOwnerOrAdmin();
    }

    match /{department}/{subfolder}/{fileName} {
      allow read: if isSignedIn()
        && !isReservedTop(department)
        && (!isPartnerClaim() || isMemberOf(department));
      allow create: if isSignedIn()
        && !isReservedTop(department)
        && (request.resource == null || isValidDocument())
        && (!isPartnerClaim() || isMemberOf(department));
      allow update, delete: if isSignedIn()
        && !isReservedTop(department)
        && (!isPartnerClaim() || isMemberOf(department))
        && isOwnerOrAdmin();
    }

    // ── Deny everything else by default ──────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
